{"html":"<div class=\"kr-card\"><style>.kr-card{\n    --bg:#EEF1F2;\n    --surface:#FFFFFF;\n    --surface-2:#E3E9EB;\n    --ink:#151B20;\n    --ink-muted:#4C5960;\n    --ink-faint:#7C888E;\n    --rule:#C9D2D5;\n    --accent:#B94F1C;\n    --accent-ink:#FFFFFF;\n    --accent-2:#1F3B4D;\n    --accent-2-ink:#FFFFFF;\n    --good:#2E7A4F;\n    --bad:#B23A3A;\n    --chip-bg:#E7DED2;\n    --shadow:0 1px 2px rgba(20,26,31,.06),0 8px 24px -12px rgba(20,26,31,.18);\n  }\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n      --bg:#0F1518;\n      --surface:#171F24;\n      --surface-2:#1E2A30;\n      --ink:#ECEEEE;\n      --ink-muted:#A6B1B5;\n      --ink-faint:#77848A;\n      --rule:#2B383F;\n      --accent:#E28245;\n      --accent-ink:#1A1006;\n      --accent-2:#6B93A8;\n      --accent-2-ink:#0D171D;\n      --good:#63C08B;\n      --bad:#E2827C;\n      --chip-bg:#2A2119;\n      --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 28px -12px rgba(0,0,0,.6);\n    }\n}\n:root[data-theme=\"dark\"] .kr-card{\n    --bg:#0F1518;\n    --surface:#171F24;\n    --surface-2:#1E2A30;\n    --ink:#ECEEEE;\n    --ink-muted:#A6B1B5;\n    --ink-faint:#77848A;\n    --rule:#2B383F;\n    --accent:#E28245;\n    --accent-ink:#1A1006;\n    --accent-2:#6B93A8;\n    --accent-2-ink:#0D171D;\n    --good:#63C08B;\n    --bad:#E2827C;\n    --chip-bg:#2A2119;\n    --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 28px -12px rgba(0,0,0,.6);\n  }\n.kr-card *{box-sizing:border-box;}\n.kr-card{-webkit-text-size-adjust:100%;}\n.kr-card{\n    margin:0;\n    background:var(--bg);\n    color:var(--ink);\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;\n    line-height:1.62;\n    font-size:16px;\n  }\n.kr-card ::selection{ background:var(--accent); color:var(--accent-ink); }\n.kr-card .wrap{ max-width:920px; margin:0 auto; padding:0 20px 96px; }\n.kr-card a{ color:var(--accent); }\n.kr-card a:focus-visible, .kr-card button:focus-visible, .kr-card summary:focus-visible{\n    outline:2px solid var(--accent); outline-offset:2px;\n  }\n.kr-card h2, .kr-card h2, .kr-card h3, .kr-card .eyebrow{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; text-wrap:balance; }\n.kr-card .num, .kr-card td.num, .kr-card .mono{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-variant-numeric:tabular-nums; }\n.kr-card .masthead{\n    padding:40px 0 28px;\n    border-bottom:3px solid var(--ink);\n  }\n.kr-card .masthead-top{\n    display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap;\n    margin-bottom:22px;\n  }\n.kr-card .brand{\n    display:flex; align-items:center; gap:12px;\n  }\n.kr-card .ticker-badge{\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-weight:700; font-size:15px; letter-spacing:.06em;\n    background:var(--ink); color:var(--bg); padding:5px 10px 4px;\n  }\n.kr-card .brand h2{\n    margin:0; font-size:clamp(28px,4vw,38px); font-weight:600; letter-spacing:.01em;\n  }\n.kr-card .exchange{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:13px; color:var(--ink-muted); letter-spacing:.04em; }\n.kr-card .source-badge{\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:12.5px; letter-spacing:.02em;\n    background:var(--surface-2); color:var(--ink-muted);\n    border:1px solid var(--rule); border-radius:3px;\n    padding:7px 12px; max-width:420px;\n  }\n.kr-card .source-badge b{ color:var(--ink); font-weight:600; }\n.kr-card .drill{\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;\n    font-weight:600;\n    font-size:clamp(21px,2.6vw,27px);\n    line-height:1.5;\n    text-wrap:balance;\n    color:var(--ink);\n    padding-left:18px;\n    border-left:5px solid var(--accent);\n  }\n.kr-card .drill em{ font-style:normal; color:var(--accent); background:linear-gradient(transparent 62%, color-mix(in srgb, var(--accent) 22%, transparent) 62%); }\n.kr-card section{ padding:44px 0; border-bottom:1px solid var(--rule); }\n.kr-card section:last-of-type{ border-bottom:none; }\n.kr-card .sec-head{ display:flex; align-items:baseline; gap:12px; margin-bottom:18px; }\n.kr-card .sec-no{\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-weight:700; font-size:13px; color:var(--surface);\n    background:var(--accent-2); color:var(--accent-2-ink);\n    width:26px; height:26px; border-radius:50%;\n    display:inline-flex; align-items:center; justify-content:center; flex:none;\n  }\n.kr-card h2.sec-title{\n    margin:0; font-size:15px; font-weight:600; letter-spacing:.09em; text-transform:uppercase;\n    color:var(--ink);\n  }\n.kr-card .sec-sub{ margin:-8px 0 20px 38px; color:var(--ink-muted); font-size:14.5px; font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;}\n.kr-card p{ margin:0 0 14px; }\n.kr-card .lede{ font-size:17.5px; }\n.kr-card .chip{\n    display:inline-flex; align-items:center; gap:6px;\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:12px; letter-spacing:.03em;\n    background:var(--chip-bg); color:var(--ink-muted);\n    border-radius:3px; padding:3px 8px; margin:0 6px 6px 0;\n  }\n.kr-card .chain-wrap{ overflow-x:auto; padding-bottom:6px; }\n.kr-card .chain-wrap svg{ display:block; min-width:760px; width:100%; height:auto; }\n.kr-card .chain-note{ margin-top:10px; font-size:13.5px; color:var(--ink-muted); }\n.kr-card .tbl-wrap{ overflow-x:auto; border:1px solid var(--rule); border-radius:4px; }\n.kr-card table{ width:100%; border-collapse:collapse; min-width:560px; font-size:14.5px; }\n.kr-card th, .kr-card td{ padding:9px 12px; text-align:right; border-bottom:1px solid var(--rule); white-space:nowrap; }\n.kr-card th:first-child, .kr-card td:first-child{ text-align:left; white-space:normal; }\n.kr-card thead th{\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-weight:500; font-size:11.5px; letter-spacing:.05em; text-transform:uppercase;\n    color:var(--ink-muted); background:var(--surface-2); border-bottom:1px solid var(--rule);\n  }\n.kr-card tbody tr:last-child td{ border-bottom:none; }\n.kr-card tbody tr.total td{ font-weight:600; background:color-mix(in srgb, var(--accent-2) 8%, transparent); }\n.kr-card .pos{ color:var(--good); }\n.kr-card .neg{ color:var(--bad); }\n.kr-card .barchart{ display:grid; grid-template-columns:repeat(5,1fr); gap:10px; align-items:end; height:150px; margin:18px 0 6px; }\n.kr-card .barchart .col{ display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; gap:6px; }\n.kr-card .barchart .bar{ width:60%; max-width:40px; border-radius:3px 3px 0 0; background:var(--accent-2); position:relative; }\n.kr-card .barchart .bar.acc{ background:var(--accent); }\n.kr-card .barchart .val{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; color:var(--ink-muted); font-variant-numeric:tabular-nums; }\n.kr-card .barchart .yr{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:12px; color:var(--ink-faint); margin-top:2px; }\n.kr-card .chart-card{ background:var(--surface); border:1px solid var(--rule); border-radius:6px; padding:16px 18px 10px; }\n.kr-card .chart-title{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:12.5px; letter-spacing:.04em; text-transform:uppercase; color:var(--ink-muted); }\n.kr-card .chart-title b{ color:var(--ink); font-weight:600; }\n.kr-card .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }\n@media (max-width:620px){.kr-card .grid2{ grid-template-columns:1fr; }\n}\n.kr-card .warn{\n    margin-top:10px; padding:10px 14px; border-radius:4px;\n    background:color-mix(in srgb, var(--bad) 12%, var(--surface));\n    border:1px solid color-mix(in srgb, var(--bad) 35%, transparent);\n    color:var(--ink); font-size:13.5px; font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;\n  }\n.kr-card .warn b{ color:var(--bad); }\n.kr-card .geo-row{ display:flex; gap:28px; align-items:center; flex-wrap:wrap; margin-top:14px; }\n.kr-card .donut{\n    width:132px; height:132px; border-radius:50%; flex:none;\n    background:conic-gradient(var(--accent-2) 0% 42.5%, var(--accent) 42.5% 100%);\n    position:relative;\n  }\n.kr-card .donut::after{\n    content:\"\"; position:absolute; inset:20px; border-radius:50%; background:var(--bg);\n  }\n.kr-card .legend{ display:flex; flex-direction:column; gap:10px; font-size:14.5px; }\n.kr-card .legend .row{ display:flex; align-items:center; gap:8px; }\n.kr-card .swatch{ width:12px; height:12px; border-radius:2px; flex:none; }\n.kr-card .kpi-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:6px; }\n@media (max-width:620px){.kr-card .kpi-grid{ grid-template-columns:1fr; }\n}\n.kr-card .kpi-why{ font-size:13.5px; color:var(--ink-muted); margin:8px 0 0; }\n.kr-card .exec-row{ display:flex; gap:16px; flex-wrap:wrap; }\n.kr-card .exec-card{ flex:1 1 260px; background:var(--surface); border:1px solid var(--rule); border-radius:6px; padding:16px 18px; }\n.kr-card .exec-card h3{ margin:0 0 6px; font-size:16px; font-weight:600; }\n.kr-card .exec-role{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:12px; letter-spacing:.04em; text-transform:uppercase; color:var(--accent); margin-bottom:8px; }\n.kr-card .exec-card p{ font-size:14.5px; color:var(--ink-muted); margin:0; }\n.kr-card .stat-row{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin:6px 0 20px; }\n@media (max-width:700px){.kr-card .stat-row{ grid-template-columns:repeat(2,1fr); }\n}\n.kr-card .stat{ background:var(--surface); border:1px solid var(--rule); border-radius:6px; padding:14px 16px; }\n.kr-card .stat .n{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:22px; font-weight:600; color:var(--ink); font-variant-numeric:tabular-nums; }\n.kr-card .stat .l{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:11.5px; letter-spacing:.03em; text-transform:uppercase; color:var(--ink-muted); margin-top:3px; }\n.kr-card .thesis-box{\n    background:var(--surface); border:1px solid var(--rule); border-left:5px solid var(--bad);\n    border-radius:0 6px 6px 0; padding:18px 20px; margin-bottom:20px;\n  }\n.kr-card .thesis-box p{ margin:0; font-size:16.5px; }\n.kr-card .risk-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }\n@media (max-width:760px){.kr-card .risk-grid{ grid-template-columns:1fr; }\n}\n.kr-card .risk-card{ background:var(--surface); border:1px solid var(--rule); border-radius:6px; padding:15px 16px; }\n.kr-card .risk-card .rn{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:11px; letter-spacing:.06em; color:var(--accent); text-transform:uppercase; }\n.kr-card .risk-card h4{ margin:6px 0 6px; font-size:15px; font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-weight:600; }\n.kr-card .risk-card p{ font-size:13.8px; color:var(--ink-muted); margin:0; }\n.kr-card .unknown-list{ display:flex; flex-direction:column; gap:10px; }\n.kr-card .unknown-item{ display:flex; gap:10px; font-size:15px; }\n.kr-card .unknown-item .q{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; color:var(--accent); font-weight:600; flex:none; }\n.kr-card footer{\n    padding:32px 0 8px; color:var(--ink-faint); font-size:12.5px; line-height:1.8;\n  }\n.kr-card footer .src-title{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; letter-spacing:.04em; text-transform:uppercase; color:var(--ink-muted); font-size:11.5px; margin-bottom:8px; }\n.kr-card footer ul{ margin:0; padding-left:18px; columns:2; column-gap:24px; }\n@media (max-width:620px){.kr-card footer ul{ columns:1; }\n}\n.kr-card cite{ font-style:normal; color:var(--ink-faint); font-size:12.5px; }\n@media print{.kr-card{ background:#fff; color:#000; }\n.kr-card section{ break-inside:avoid; }\n}\n</style>\n\n<div class=\"wrap\">\n\n  <header class=\"masthead\">\n    <div class=\"masthead-top\">\n      <div class=\"brand\">\n        <span class=\"ticker-badge\">XOM</span>\n        <div>\n          <h2>엑슨모빌 (Exxon Mobil Corp.)</h2>\n          <div class=\"exchange\">뉴욕증권거래소 · 에너지 · 통합 석유&amp;가스 (Oil &amp; Gas Integrated)</div>\n        </div>\n      </div>\n      <div class=\"source-badge\">📄 <b>업로드 자료 기반</b> · 10-K FY2021–FY2025, 10-Q, DEF 14A(2026), 어닝콜 Q2 FY2026 · 페이지 출처 명시</div>\n    </div>\n    <p class=\"drill\">엑슨모빌은 땅속에서 캐낸 원유·가스를 정유공장에서 휘발유·경유·플라스틱 원료로 바꿔 전 세계 운전자와 공장에 파는 회사인데, <em>돈은 대부분 &lsquo;캐내는&rsquo; 단계에서 법니다</em> — 2025년 이익의 74%가 매출 비중 12%짜리 원유·가스 채굴 사업 하나에서 나왔습니다.</p>\n  </header>\n\n  <!-- ② 돈 버는 구조 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">2</span><h2 class=\"sec-title\">돈 버는 구조</h2></div>\n    <div class=\"chain-wrap\">\n      <svg viewBox=\"0 0 940 300\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"엑슨모빌 밸류체인: 원유·가스 채굴에서 정제, 판매까지\">\n        <defs>\n          <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 z\" fill=\"var(--ink-muted)\"></path>\n          </marker>\n        </defs>\n        <style>.kr-card .node{ fill:var(--surface); stroke:var(--rule); stroke-width:1.3; }\n.kr-card .node.hi{ stroke:var(--accent); stroke-width:2; }\n.kr-card .lab{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-size:15px; fill:var(--ink); font-weight:600; }\n.kr-card .sub{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; fill:var(--ink-muted); }\n.kr-card .subhi{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; fill:var(--accent); font-weight:600; }\n.kr-card .edge{ stroke:var(--ink-muted); stroke-width:1.4; fill:none; marker-end:url(#arrow); }\n.kr-card .etag{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:10.5px; fill:var(--ink-faint); letter-spacing:.02em; }\n</style>\n\n        <!-- node: 외부 원유 구매 -->\n        <rect class=\"node\" x=\"10\" y=\"150\" width=\"150\" height=\"60\" rx=\"6\"></rect>\n        <text class=\"lab\" x=\"85\" y=\"176\" text-anchor=\"middle\">외부 원유 구매</text>\n        <text class=\"sub\" x=\"85\" y=\"196\" text-anchor=\"middle\">$184B/년</text>\n\n        <!-- node: 원유·가스 채굴 (Upstream) -->\n        <rect class=\"node hi\" x=\"10\" y=\"30\" width=\"150\" height=\"80\" rx=\"6\"></rect>\n        <text class=\"lab\" x=\"85\" y=\"58\" text-anchor=\"middle\">원유·가스 채굴</text>\n        <text class=\"sub\" x=\"85\" y=\"76\" text-anchor=\"middle\">(Upstream)</text>\n        <text class=\"subhi\" x=\"85\" y=\"96\" text-anchor=\"middle\">매출 12% · 이익 74%</text>\n\n        <!-- edges into refining -->\n        <path class=\"edge\" d=\"M160,65 C 260,65 260,140 320,140\"></path>\n        <path class=\"edge\" d=\"M160,180 C 250,180 260,150 320,150\"></path>\n\n        <!-- node: 정유·마케팅 -->\n        <rect class=\"node\" x=\"320\" y=\"100\" width=\"160\" height=\"90\" rx=\"6\"></rect>\n        <text class=\"lab\" x=\"400\" y=\"130\" text-anchor=\"middle\">정유 · 마케팅</text>\n        <text class=\"sub\" x=\"400\" y=\"148\" text-anchor=\"middle\">(Energy Products)</text>\n        <text class=\"subhi\" x=\"400\" y=\"168\" text-anchor=\"middle\">매출 76% · 이익 26%</text>\n\n        <!-- edges out to chemical / specialty -->\n        <path class=\"edge\" d=\"M480,120 C 560,80 590,60 660,60\"></path>\n        <path class=\"edge\" d=\"M480,170 C 560,210 590,230 660,230\"></path>\n\n        <!-- node: 화학제품 -->\n        <rect class=\"node\" x=\"660\" y=\"25\" width=\"150\" height=\"70\" rx=\"6\"></rect>\n        <text class=\"lab\" x=\"735\" y=\"55\" text-anchor=\"middle\">화학 제품</text>\n        <text class=\"sub\" x=\"735\" y=\"73\" text-anchor=\"middle\">매출 7% · 이익 3%</text>\n\n        <!-- node: 특수제품 -->\n        <rect class=\"node\" x=\"660\" y=\"195\" width=\"150\" height=\"70\" rx=\"6\"></rect>\n        <text class=\"lab\" x=\"735\" y=\"225\" text-anchor=\"middle\">윤활유·특수제품</text>\n        <text class=\"sub\" x=\"735\" y=\"243\" text-anchor=\"middle\">매출 6% · 이익 10%</text>\n\n        <!-- customers arrow group label -->\n        <text class=\"etag\" x=\"400\" y=\"90\" text-anchor=\"middle\">휘발유·경유·항공유</text>\n        <text class=\"etag\" x=\"590\" y=\"45\" text-anchor=\"middle\">플라스틱 원료</text>\n        <text class=\"etag\" x=\"590\" y=\"255\" text-anchor=\"middle\">엔진오일·왁스</text>\n\n        <!-- final customer arrows -->\n        <path class=\"edge\" d=\"M810,60 C 870,80 890,140 890,150\"></path>\n        <path class=\"edge\" d=\"M810,230 C 870,210 890,160 890,150\"></path>\n        <circle cx=\"895\" cy=\"150\" r=\"0\" fill=\"none\"></circle>\n        <text class=\"lab\" x=\"895\" y=\"155\" text-anchor=\"end\" font-size=\"13\">고객</text>\n        <text class=\"sub\" x=\"895\" y=\"172\" text-anchor=\"end\">운전자·항공사·공장</text>\n      </svg>\n    </div>\n    <p class=\"chain-note\">원유를 <b>캐내는 사업(Upstream)</b>은 매출의 12%밖에 안 되지만 회사 전체 이익의 74%를 책임집니다. 반대로 캐낸 기름을 정제해서 파는 <b>정유·마케팅 사업</b>은 매출의 76%를 차지하지만 원가(원유값)를 거의 그대로 소비자가에 넘기는 박리다매 구조라 이익 비중은 26%에 그칩니다. <cite>출처: 10-K FY2025, p.27–29, p.80–81</cite></p>\n  </section>\n\n  <!-- ③ 매출 구성 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">3</span><h2 class=\"sec-title\">매출 구성 — 두 축</h2></div>\n\n    <p class=\"sec-sub\" style=\"margin-left:0;\">사업부문별 (2025년, 백만 달러)</p>\n    <div class=\"tbl-wrap\">\n      <table>\n        <thead><tr><th>부문</th><th>매출</th><th>매출 비중</th><th>세후이익</th><th>이익 비중</th><th>이익률</th></tr></thead>\n        <tbody>\n          <tr><td>원유·가스 채굴 (Upstream)</td><td class=\"num\">39,389</td><td class=\"num\">12.2%</td><td class=\"num\">21,354</td><td class=\"num\">74.0%</td><td class=\"num\">54.2%</td></tr>\n          <tr><td>정유·마케팅 (Energy Products)</td><td class=\"num\">244,451</td><td class=\"num\">75.5%</td><td class=\"num\">7,423</td><td class=\"num\">25.7%</td><td class=\"num\">3.0%</td></tr>\n          <tr><td>화학 제품 (Chemical Products)</td><td class=\"num\">22,209</td><td class=\"num\">6.9%</td><td class=\"num\">800</td><td class=\"num\">2.8%</td><td class=\"num\">3.6%</td></tr>\n          <tr><td>특수 제품 (Specialty Products)</td><td class=\"num\">17,771</td><td class=\"num\">5.5%</td><td class=\"num\">2,857</td><td class=\"num\">9.9%</td><td class=\"num\">16.1%</td></tr>\n          <tr><td>기업/금융 부문 조정</td><td class=\"num\">—</td><td class=\"num\">—</td><td class=\"num\">(3,590)</td><td class=\"num\">(12.4%)</td><td class=\"num\">—</td></tr>\n          <tr class=\"total\"><td>합계</td><td class=\"num\">323,820</td><td class=\"num\">100%</td><td class=\"num\">28,844</td><td class=\"num\">100%</td><td class=\"num\">8.9%</td></tr>\n        </tbody>\n      </table>\n    </div>\n    <p style=\"font-size:13px;color:var(--ink-muted);margin:8px 0 26px;\">이익률 = 세후이익 ÷ 매출. 채굴(Upstream)은 원가가 낮아 이익률이 54%지만, 정유는 원유 구매비를 거의 그대로 넘기는 구조라 이익률이 3%에 불과합니다. <cite>출처: 10-K FY2025, p.27–29, p.80–81</cite></p>\n\n    <p class=\"sec-sub\" style=\"margin-left:0;\">지역별 (2025년)</p>\n    <div class=\"geo-row\">\n      <div class=\"donut\" role=\"img\" aria-label=\"미국 42.5%, 미국 외 57.5%\"></div>\n      <div class=\"legend\">\n        <div class=\"row\"><span class=\"swatch\" style=\"background:var(--accent-2);\"></span>미국 — $137,565M (42.5%)</div>\n        <div class=\"row\"><span class=\"swatch\" style=\"background:var(--accent);\"></span>미국 외 — $186,255M (57.5%)</div>\n      </div>\n    </div>\n    <p style=\"font-size:13.5px;color:var(--ink-muted);margin-top:12px;\">공시는 미국/미국 외 2개 축으로만 지역을 나눕니다(국가별 세부 비중은 <b>공시 미제공</b>). 매출의 절반 이상이 해외에서 나오는 만큼 환율과 각국 정부 정책·자원국유화 리스크에 노출돼 있습니다. <cite>출처: 10-K FY2025, p.80–81 (Note 3 세그먼트 미국/미국외 매출 합산)</cite></p>\n  </section>\n\n  <!-- ④ 고객 & 경쟁사 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">4</span><h2 class=\"sec-title\">고객 &amp; 경쟁사</h2></div>\n    <p><b>고객</b>: 소비자(주유소를 찾는 운전자)와 항공사·해운사(항공유·선박유), 화학·플라스틱 제조사(폴리머 원료), 산업체(윤활유) 등으로 폭넓게 분산돼 있습니다. 원자재 특성상 특정 고객 한 곳에 매출이 쏠리는 구조가 아니라서, 공시에도 매출의 10% 이상을 차지하는 단일 고객은 <b>보고되지 않았습니다</b>. <cite>출처: 10-K FY2025 재무제표 및 주석 전반</cite></p>\n    <div class=\"exec-row\" style=\"margin-top:16px;\">\n      <div class=\"exec-card\"><h3>Chevron (CVX)</h3><p>가장 직접적인 미국 경쟁사. 퍼미안 분지와 카자흐스탄 텐기즈 유전 비중이 커, 엑슨모빌보다 채굴(Upstream) 의존도가 상대적으로 높습니다.</p></div>\n      <div class=\"exec-card\"><h3>Shell (SHEL)</h3><p>유럽계 슈퍼메이저. LNG(액화천연가스) 트레이딩 사업이 훨씬 크고, 재생에너지·저탄소 사업 비중을 더 적극적으로 키워온 점이 다릅니다.</p></div>\n      <div class=\"exec-card\"><h3>BP (BP)</h3><p>규모가 더 작은 슈퍼메이저. 최근 몇 년 재생에너지 확대에 나섰다가 다시 화석연료 중심 전략으로 선회하며 방향을 자주 바꿨습니다.</p></div>\n    </div>\n  </section>\n\n  <!-- ⑤ 핵심 KPI -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">5</span><h2 class=\"sec-title\">이 업종의 핵심 KPI</h2></div>\n\n    <div class=\"kpi-grid\">\n      <div class=\"chart-card\">\n        <div class=\"chart-title\"><b>원유환산 생산량</b> · 일평균, 천 배럴(kboe/d)</div>\n        <div class=\"barchart\" id=\"bar-prod\"></div>\n        <p class=\"kpi-why\">채굴 회사의 진짜 몸집을 보여주는 숫자입니다. 2024년 파이오니어 인수로 퍼미안 생산량이 크게 뛰었고, 2025년에도 성장이 이어졌습니다(40년 만에 최대 연간 생산량). <cite>출처: 10-K FY2025 p.29, FY2023 10-K p.34, FY2021 10-K p.35</cite></p>\n      </div>\n      <div class=\"chart-card\">\n        <div class=\"chart-title\"><b>평균 투하자본이익률(ROCE)</b> · %, Non-GAAP</div>\n        <div class=\"barchart\" id=\"bar-roce\"></div>\n        <p class=\"kpi-why\">회사가 투자한 자본 대비 얼마나 효율적으로 돈을 버는지 보여주는 지표입니다. 2022년 고유가로 25%까지 치솟았다가, 유가가 진정되며 2025년 9.3%까지 내려왔습니다. <cite>출처: 10-K FY2025 p.27–29, FY2023 10-K p.34</cite></p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ⑥ 경영진 & 오너십 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">6</span><h2 class=\"sec-title\">경영진 &amp; 오너십</h2></div>\n    <p><b>대런 우즈(Darren W. Woods)</b>가 2017년부터 이사회 의장 겸 CEO를 맡고 있습니다(이사 선임은 2016년). 1992년 입사해 33년간 여러 사업부 리더를 거친 정통 &lsquo;내부 승진&rsquo; 경영진이며, 창업자 일가의 경영 관여는 없습니다(1882년 설립된 회사로 오래전 스탠더드 오일에서 갈라져 나온 회사입니다). <cite>출처: DEF 14A(2026), p.20</cite></p>\n    <p>최대주주는 뱅가드(Vanguard)·블랙록(BlackRock)·스테이트스트리트(State Street) 등 인덱스펀드 운용사들로, 전형적인 대형 우량주의 지분 구조입니다(창업 가문의 지배력은 없음). <cite>출처: DEF 14A(2026), p.36</cite></p>\n    <div class=\"warn\"><b>확인 필요</b>: 2026년 4월 제출된 위임장(DEF 14A)에는 2025년 기준 CFO가 캐서린 미켈스(Kathryn A. Mikells)로 기재돼 있지만, 2026년 7월 실적발표 콘퍼런스콜에서는 닐 핸슨(Neil Hansen)이 CFO로 소개됩니다. CFO 교체 시점과 배경은 이 자료들만으로는 확인되지 않습니다. <cite>출처: DEF 14A(2026) p.20 vs. 어닝콜 Q2 FY2026(2026-07-31)</cite></div>\n  </section>\n\n  <!-- ⑦ 주주환원 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">7</span><h2 class=\"sec-title\">주주환원</h2></div>\n    <div class=\"stat-row\">\n      <div class=\"stat\"><div class=\"n\">43년</div><div class=\"l\">연속 배당 증액</div></div>\n      <div class=\"stat\"><div class=\"n\">59.7%</div><div class=\"l\">2025 배당성향</div></div>\n      <div class=\"stat\"><div class=\"n\">$20.3B</div><div class=\"l\">2025 자사주 매입</div></div>\n      <div class=\"stat\"><div class=\"n\">$37.2B</div><div class=\"l\">2025 총 주주환원</div></div>\n    </div>\n    <p>엑슨모빌은 <b>43년 연속으로 주당 배당금을 늘려온</b>, 배당 역사가 가장 긴 대형주 중 하나입니다. 2025년에는 순이익의 59.7%($17.2B)를 배당으로, $20.3B를 자사주 매입으로 지급해 총 $37.2B를 주주에게 돌려줬습니다. <cite>출처: DEF 14A(2026) p.56, 118 · 10-K FY2025 p.74</cite></p>\n    <div class=\"warn\"><b>자사주 매입이 실제로 주식수를 줄였는지 확인</b>: 2021년부터 2025년까지 매년 수백억 달러를 자사주 매입에 썼지만, 2024년 파이오니어 인수 대금으로 신주 5.45억 주를 발행하면서 가중평균 발행주식수는 오히려 42.75억 주(2021) → 43.05억 주(2025)로 <b>늘었습니다</b>. 다만 인수가 마무리된 이후인 2025년 2분기(43.31억 주) → 2026년 2분기(41.74억 주)로는 다시 줄어드는 추세입니다. <cite>출처: 10-K FY2025 p.80, FY2021 10-K p.90, 10-Q Q2 FY2026 p.9</cite></div>\n  </section>\n\n  <!-- ⑧ 리스크 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">8</span><h2 class=\"sec-title\">이 회사가 망하는 시나리오</h2></div>\n    <div class=\"thesis-box\">\n      <p>전 세계가 예상보다 훨씬 빨리 석유를 덜 쓰게 되거나, 산유국들이 다시 유가 폭락을 부르는 증산 경쟁을 벌이면 — 이익의 74%를 책임지는 &lsquo;원유를 캐내는 사업&rsquo;부터 무너지면서 회사 전체 실적이 함께 주저앉습니다.</p>\n    </div>\n    <div class=\"risk-grid\">\n      <div class=\"risk-card\">\n        <div class=\"rn\">Risk 1</div>\n        <h4>유가·상품가격 변동성</h4>\n        <p>이익의 4분의 3이 원유·가스 채굴 한 사업부에서 나오는 만큼, 유가가 떨어지면 회사 실적이 통째로 흔들립니다. 실제로 2022년 순이익 $55.7B → 2025년 $28.8B로 반토막 났습니다.</p>\n      </div>\n      <div class=\"risk-card\">\n        <div class=\"rn\">Risk 2</div>\n        <h4>에너지 전환·기후 규제</h4>\n        <p>전기차 확산, 탄소 규제 강화로 장기적으로 원유·가스 수요 자체가 줄어들 수 있습니다. 저탄소 사업(수소·탄소포집 등)은 아직 회사 규모에 비해 매출이 미미합니다.</p>\n      </div>\n      <div class=\"risk-card\">\n        <div class=\"rn\">Risk 3</div>\n        <h4>지정학·정치 리스크</h4>\n        <p>가이아나, 카자흐스탄 등 정치적으로 불안정한 지역에 대형 생산시설을 두고 있습니다. 실제로 2026년 2분기 중동 분쟁으로 채굴량의 약 10%가 일시적으로 멈췄습니다.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ⑨ 핵심 재무 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">9</span><h2 class=\"sec-title\">핵심 재무 (5개년)</h2></div>\n\n    <div class=\"grid2\">\n      <div class=\"chart-card\">\n        <div class=\"chart-title\"><b>매출</b> · 십억 달러 — 사업이 커지고 있나</div>\n        <div class=\"barchart\" id=\"bar-rev\"></div>\n      </div>\n      <div class=\"chart-card\">\n        <div class=\"chart-title\"><b>세전이익</b> · 십억 달러 — 본업으로 돈을 버나</div>\n        <div class=\"barchart\" id=\"bar-pti\"></div>\n      </div>\n      <div class=\"chart-card\">\n        <div class=\"chart-title\"><b>잉여현금흐름(FCF)</b> · 십억 달러 — 진짜 남는 현금</div>\n        <div class=\"barchart\" id=\"bar-fcf\"></div>\n      </div>\n      <div class=\"chart-card\">\n        <div class=\"chart-title\"><b>총부채</b> · 십억 달러 — 갚을 수 있나</div>\n        <div class=\"barchart\" id=\"bar-debt\"></div>\n      </div>\n    </div>\n\n    <div class=\"warn\" style=\"margin-top:18px;\"><b>경고</b>: 2025년 세전이익은 전년 대비 15.6% 줄었는데, FCF는 23.1%나 더 크게 줄었습니다. 영업현금흐름(CFO)이 6% 줄어드는 동안 설비투자(CapEx)는 퍼미안·가이아나 증산을 위해 오히려 16.7% 늘었기(2024년 $24.3B → 2025년 $28.4B) 때문입니다. 이익보다 현금이 더 빠르게 줄고 있다는 신호라 다음 분기 CapEx 가이던스를 확인할 필요가 있습니다.</div>\n\n    <p class=\"sec-sub\" style=\"margin:22px 0 10px 0;\">연도별 상세 (백만 달러, YoY %)</p>\n    <div class=\"tbl-wrap\">\n      <table>\n        <thead><tr><th>연도</th><th>매출</th><th>YoY</th><th>세전이익</th><th>YoY</th><th>순이익</th><th>영업현금흐름</th><th>CapEx</th><th>FCF</th><th>총부채</th></tr></thead>\n        <tbody>\n          <tr><td>2021</td><td class=\"num\">276,692</td><td class=\"num\">—</td><td class=\"num\">31,234</td><td class=\"num\">—</td><td class=\"num\">23,040</td><td class=\"num\">48,129</td><td class=\"num\">12,076</td><td class=\"num\">36,053</td><td class=\"num\">47,704</td></tr>\n          <tr><td>2022</td><td class=\"num\">398,675</td><td class=\"num pos\">+44.1%</td><td class=\"num\">77,753</td><td class=\"num pos\">+148.9%</td><td class=\"num\">55,740</td><td class=\"num\">76,797</td><td class=\"num\">18,407</td><td class=\"num\">58,390</td><td class=\"num\">41,193</td></tr>\n          <tr><td>2023</td><td class=\"num\">334,697</td><td class=\"num neg\">−16.0%</td><td class=\"num\">52,783</td><td class=\"num neg\">−32.1%</td><td class=\"num\">36,010</td><td class=\"num\">55,369</td><td class=\"num\">21,919</td><td class=\"num\">33,450</td><td class=\"num\">41,573</td></tr>\n          <tr><td>2024</td><td class=\"num\">339,247</td><td class=\"num pos\">+1.4%</td><td class=\"num\">48,873</td><td class=\"num neg\">−7.4%</td><td class=\"num\">33,680</td><td class=\"num\">55,022</td><td class=\"num\">24,306</td><td class=\"num\">30,716</td><td class=\"num\">41,710</td></tr>\n          <tr class=\"total\"><td>2025</td><td class=\"num\">323,905</td><td class=\"num neg\">−4.5%</td><td class=\"num\">41,268</td><td class=\"num neg\">−15.6%</td><td class=\"num\">28,844</td><td class=\"num\">51,970</td><td class=\"num\">28,358</td><td class=\"num\">23,612</td><td class=\"num\">43,537</td></tr>\n        </tbody>\n      </table>\n    </div>\n    <p style=\"font-size:13px;color:var(--ink-muted);margin:8px 0 0;\">엑슨모빌은 &lsquo;영업이익&rsquo; 항목을 별도로 표기하지 않아, 이자비용 반영 전 단계인 <b>세전이익</b>을 영업 수익성 지표로 사용했습니다. FCF = 영업현금흐름 − 설비투자(CapEx). <cite>출처: 10-K FY2025 p.71, 73, 74 · 10-K FY2023 p.77, 79, 80</cite></p>\n  </section>\n\n  <!-- ⑩ 아직 모르는 것 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-no\">10</span><h2 class=\"sec-title\">내가 아직 모르는 것</h2></div>\n    <div class=\"unknown-list\">\n      <div class=\"unknown-item\"><span class=\"q\">Q1</span><span>CFO가 캐서린 미켈스에서 닐 핸슨으로 언제, 왜 바뀌었는지는 이 자료로는 알 수 없습니다. 별도 8-K 공시나 보도자료 확인이 필요합니다.</span></div>\n      <div class=\"unknown-item\"><span class=\"q\">Q2</span><span>2026년 2분기 중동 분쟁으로 멈췄던 채굴량 10%가 3분기에 얼마나 회복됐는지는 다음 분기 실적(3분기 10-Q)을 봐야 압니다.</span></div>\n      <div class=\"unknown-item\"><span class=\"q\">Q3</span><span>2026년 7월 뉴저지에서 텍사스로 법인 소재지(주법인)를 옮긴 것이 세금·주주 권리에 실제로 어떤 영향을 주는지는 추가 확인이 필요합니다.</span></div>\n    </div>\n  </section>\n\n  <footer>\n    <div class=\"src-title\">출처</div>\n    <ul>\n      <li>10-K FY2025 (XOM_10-K_FY2025.html), 제출일 2026-02-18</li>\n      <li>10-K FY2023 (XOM_10-K_FY2023.html), 제출일 2024-02-28</li>\n      <li>10-K FY2021 (XOM_10-K_FY2021.html), 제출일 2022-02-23</li>\n      <li>10-Q Q2 FY2026 (XOM_10-Q_Q2FY2026.html), 제출일 2026-08-03</li>\n      <li>DEF 14A 2026 (XOM_DEF14A_2026.html), 제출일 2026-04-08</li>\n      <li>어닝콜 Q2 FY2026 (roic.ai transcript), 2026-07-31</li>\n      <li>주가·시가총액 스냅샷: roic.ai, 2026-08-28 기준 (156.45달러 / 6484.0억달러)</li>\n    </ul>\n    <p style=\"margin-top:14px;\">본 카드는 SEC 공시자료를 바탕으로 정리한 요약이며 투자 자문이 아닙니다. 수치는 반올림 처리됐을 수 있습니다.</p>\n  </footer>\n\n</div></div>","scripts":["\n(function(){\n  function bars(id, data, opts){\n    var el = document.getElementById(id);\n    if(!el) return;\n    opts = opts || {};\n    var max = Math.max.apply(null, data.map(function(d){return d.v;})) * 1.12;\n    el.innerHTML = data.map(function(d){\n      var h = Math.max(4, (d.v/max)*100);\n      var cls = d.hi ? 'bar acc' : 'bar';\n      return '<div class=\"col\">' +\n        '<span class=\"val\">' + d.label + '</span>' +\n        '<div class=\"' + cls + '\" style=\"height:' + h + '%\"></div>' +\n        '<span class=\"yr\">' + d.yr + '</span>' +\n      '</div>';\n    }).join('');\n  }\n\n  bars('bar-rev', [\n    {yr:'21', v:276.7, label:'276.7'},\n    {yr:'22', v:398.7, label:'398.7'},\n    {yr:'23', v:334.7, label:'334.7'},\n    {yr:'24', v:339.2, label:'339.2'},\n    {yr:'25', v:323.9, label:'323.9', hi:true}\n  ]);\n  bars('bar-pti', [\n    {yr:'21', v:31.2, label:'31.2'},\n    {yr:'22', v:77.8, label:'77.8'},\n    {yr:'23', v:52.8, label:'52.8'},\n    {yr:'24', v:48.9, label:'48.9'},\n    {yr:'25', v:41.3, label:'41.3', hi:true}\n  ]);\n  bars('bar-fcf', [\n    {yr:'21', v:36.1, label:'36.1'},\n    {yr:'22', v:58.4, label:'58.4'},\n    {yr:'23', v:33.5, label:'33.5'},\n    {yr:'24', v:30.7, label:'30.7'},\n    {yr:'25', v:23.6, label:'23.6', hi:true}\n  ]);\n  bars('bar-debt', [\n    {yr:'21', v:47.7, label:'47.7'},\n    {yr:'22', v:41.2, label:'41.2'},\n    {yr:'23', v:41.6, label:'41.6'},\n    {yr:'24', v:41.7, label:'41.7'},\n    {yr:'25', v:43.5, label:'43.5', hi:true}\n  ]);\n  bars('bar-prod', [\n    {yr:'21', v:3712, label:'3,712'},\n    {yr:'22', v:3737, label:'3,737'},\n    {yr:'23', v:3738, label:'3,738'},\n    {yr:'24', v:4333, label:'4,333'},\n    {yr:'25', v:4736, label:'4,736', hi:true}\n  ]);\n  bars('bar-roce', [\n    {yr:'21', v:10.9, label:'10.9'},\n    {yr:'22', v:24.9, label:'24.9'},\n    {yr:'23', v:15.0, label:'15.0'},\n    {yr:'24', v:12.7, label:'12.7'},\n    {yr:'25', v:9.3, label:'9.3', hi:true}\n  ]);\n})();\n"],"ext":[],"lede":"엑슨모빌은 땅속에서 캐낸 원유·가스를 정유공장에서 휘발유·경유·플라스틱 원료로 바꿔 전 세계 운전자와 공장에 파는 회사인데, 돈은 대부분 &lsquo;캐내는&rsquo; 단계에서 법니다 — 2025년 이익의 74%가 매출 비중 12%짜리 원유·가스 채굴 사업 하나에서 나왔습니다."}
{"html":"<div class=\"kr-card\"><style>.kr-card{\n    color-scheme: light;\n    --bg: #f5f6f9;\n    --surface: #ffffff;\n    --surface-2: #edf0f5;\n    --surface-3: #e4e8ef;\n    --ink: #12151b;\n    --ink-2: #4a5163;\n    --ink-3: #7c8296;\n    --border: #dfe3ea;\n    --accent: #2a5fb3;\n    --accent-ink: #1d4a91;\n    --accent-soft: #e6edf9;\n    --warm: #c2580c;\n    --warm-soft: #fbe9dc;\n    --good: #12875a;\n    --bad: #c23a39;\n    --bad-soft: #fbe8e7;\n    --shadow: 0 1px 2px rgba(20,26,40,.04), 0 8px 24px -12px rgba(20,26,40,.12);\n  }\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n      color-scheme: dark;\n      --bg: #101216;\n      --surface: #171a20;\n      --surface-2: #1d2129;\n      --surface-3: #262b34;\n      --ink: #edeff3;\n      --ink-2: #b7bdc9;\n      --ink-3: #7e8494;\n      --border: #2a2f38;\n      --accent: #6fa2ec;\n      --accent-ink: #8ab4f0;\n      --accent-soft: #1c2a40;\n      --warm: #e08a4c;\n      --warm-soft: #3a2416;\n      --good: #3fcf94;\n      --bad: #e5726f;\n      --bad-soft: #3a1f1e;\n      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);\n    }\n}\n:root[data-theme=\"dark\"] .kr-card{\n    color-scheme: dark;\n    --bg: #101216;\n    --surface: #171a20;\n    --surface-2: #1d2129;\n    --surface-3: #262b34;\n    --ink: #edeff3;\n    --ink-2: #b7bdc9;\n    --ink-3: #7e8494;\n    --border: #2a2f38;\n    --accent: #6fa2ec;\n    --accent-ink: #8ab4f0;\n    --accent-soft: #1c2a40;\n    --warm: #e08a4c;\n    --warm-soft: #3a2416;\n    --good: #3fcf94;\n    --bad: #e5726f;\n    --bad-soft: #3a1f1e;\n    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);\n  }\n.kr-card *{ box-sizing: border-box; }\n.kr-card{\n    margin: 0;\n    background: var(--bg);\n    color: var(--ink);\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;\n    line-height: 1.6;\n    font-size: 15.5px;\n  }\n.kr-card .wrap{ max-width: 900px; margin: 0 auto; padding: 0 20px 80px; }\n.kr-card .mono{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-variant-numeric: tabular-nums; }\n.kr-card header.masthead{\n    padding: 48px 0 28px;\n    border-bottom: 1px solid var(--border);\n  }\n.kr-card .kicker{\n    display: flex; align-items: center; gap: 10px;\n    font-size: 12.5px; color: var(--ink-3); letter-spacing: .04em;\n    margin-bottom: 14px; flex-wrap: wrap;\n  }\n.kr-card .badge{\n    display: inline-flex; align-items: center; gap: 6px;\n    background: var(--accent-soft); color: var(--accent-ink);\n    border-radius: 999px; padding: 4px 12px; font-size: 12.5px; font-weight: 600;\n  }\n.kr-card h1.company{\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;\n    font-weight: 600;\n    font-size: 40px;\n    margin: 0 0 6px;\n    text-wrap: balance;\n    letter-spacing: -.01em;\n  }\n.kr-card .ticker-line{ color: var(--ink-2); font-size: 14.5px; margin-bottom: 26px; }\n.kr-card .ticker-line .mono{ color: var(--ink); }\n.kr-card .stat-strip{\n    display: grid; grid-template-columns: repeat(6, 1fr); gap: 1px;\n    background: var(--border); border: 1px solid var(--border); border-radius: 12px;\n    overflow: hidden;\n  }\n.kr-card .stat{ background: var(--surface); padding: 14px 10px; text-align: center; }\n.kr-card .stat .v{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-weight: 600; font-size: 19px; letter-spacing: -.02em; }\n.kr-card .stat .d{ font-size: 11px; color: var(--good); margin-top: 2px; }\n.kr-card .stat .l{ font-size: 11px; color: var(--ink-3); margin-top: 4px; }\n.kr-card section{ padding: 52px 0; border-bottom: 1px solid var(--border); }\n.kr-card section:last-of-type{ border-bottom: none; }\n.kr-card .eyebrow{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;\n    font-size: 12.5px; color: var(--accent-ink); font-weight: 600;\n    letter-spacing: .06em; margin-bottom: 10px; display:flex; align-items:center; gap:8px;\n  }\n.kr-card .eyebrow .num{\n    display:inline-flex; align-items:center; justify-content:center;\n    width: 20px; height:20px; border-radius:50%; background: var(--accent-soft);\n    font-size: 11px;\n  }\n.kr-card h2{\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-weight: 600;\n    font-size: 25px; margin: 0 0 18px; text-wrap: balance;\n  }\n.kr-card p{ color: var(--ink-2); margin: 0 0 14px; max-width: 68ch; }\n.kr-card .lede{ color: var(--ink); }\n.kr-card .drill{\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;\n    font-style: italic;\n    font-weight: 500;\n    font-size: 27px;\n    line-height: 1.5;\n    color: var(--ink);\n    text-wrap: balance;\n    border-left: 3px solid var(--accent);\n    padding-left: 22px;\n    margin: 6px 0 0;\n    max-width: 62ch;\n  }\n.kr-card .diagram-card{\n    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;\n    padding: 22px; box-shadow: var(--shadow); overflow-x: auto;\n  }\n.kr-card .diagram-svg{ width: 100%; height: auto; min-width: 640px; display:block; }\n.kr-card .flow-box{ fill: var(--surface-2); stroke: var(--border); stroke-width: 1; }\n.kr-card .flow-box.hi{ fill: var(--accent-soft); stroke: var(--accent); }\n.kr-card .flow-box.warm{ fill: var(--warm-soft); stroke: var(--warm); }\n.kr-card .flow-label{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; fill: var(--ink); font-size: 13.5px; font-weight: 600; }\n.kr-card .flow-sub{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; fill: var(--ink-3); font-size: 11px; }\n.kr-card .flow-arrow{ stroke: var(--accent); stroke-width: 2; fill: none; marker-end: url(#arrowhead); }\n.kr-card .flow-arrow.loop{ stroke: var(--warm); stroke-dasharray: 4 3; }\n.kr-card .flow-money{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; fill: var(--accent-ink); font-size: 11.5px; font-weight: 600; }\n.kr-card .flow-money.loop{ fill: var(--warm); }\n.kr-card .cols-2{ display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }\n@media (max-width: 720px){.kr-card .cols-2{ grid-template-columns: 1fr; }\n}\n.kr-card .panel{\n    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;\n    padding: 20px; box-shadow: var(--shadow);\n  }\n.kr-card .panel h3{ font-size: 15px; margin: 0 0 4px; font-weight: 600; }\n.kr-card .panel .cap{ font-size: 12.5px; color: var(--ink-3); margin-bottom: 14px; }\n.kr-card .chart-svg{ width: 100%; height: auto; display: block; }\n.kr-card .grid{ stroke: var(--border); stroke-width: 1; }\n.kr-card .axis-label{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size: 10.5px; fill: var(--ink-3); }\n.kr-card .bar-value{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size: 11px; fill: var(--ink); font-weight: 600; }\n.kr-card .bar-sales, .kr-card .bar-ni, .kr-card .bar-fcf{ fill: var(--accent); }\n.kr-card .bar-euv{ fill: var(--warm); }\n.kr-card .bar-geo{ fill: var(--accent); }\n.kr-card .line-opm, .kr-card .line-asp{ fill: none; stroke: var(--accent); stroke-width: 2; }\n.kr-card .dot-opm, .kr-card .dot-asp{ fill: var(--accent); stroke: var(--surface); stroke-width: 2; }\n.kr-card .ann-line{ stroke: var(--bad); stroke-width: 1; stroke-dasharray: 2 2; }\n.kr-card .ann-text{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size: 10.5px; fill: var(--bad); }\n.kr-card .segbar{ display:flex; width:100%; height: 34px; border-radius: 8px; overflow:hidden; margin: 6px 0 10px; }\n.kr-card .segbar .seg-sys{ background: var(--accent); }\n.kr-card .segbar .seg-svc{ background: var(--warm); }\n.kr-card .segbar span{ display:flex; align-items:center; justify-content:center; color:#fff; font-size:12px; font-weight:600; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; }\n.kr-card .seg-legend{ display:flex; gap:18px; font-size:12.5px; color: var(--ink-2); margin-bottom: 18px; flex-wrap:wrap; }\n.kr-card .seg-legend .k{ display:inline-flex; align-items:center; gap:6px; }\n.kr-card .seg-legend .dot{ width:9px; height:9px; border-radius:2px; display:inline-block; }\n.kr-card .seg-legend .dot.sys{ background: var(--accent); }\n.kr-card .seg-legend .dot.svc{ background: var(--warm); }\n.kr-card table{ width: 100%; border-collapse: collapse; font-size: 13.5px; }\n.kr-card th, .kr-card td{ text-align: right; padding: 7px 6px; border-bottom: 1px solid var(--border); font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; }\n.kr-card th:first-child, .kr-card td:first-child{ text-align: left; font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; color: var(--ink-2); }\n.kr-card th{ color: var(--ink-3); font-weight: 600; font-size: 11.5px; letter-spacing:.02em; }\n.kr-card .yoy-pos{ color: var(--good); }\n.kr-card .yoy-neg{ color: var(--bad); }\n.kr-card .mini-table{ margin-top: 8px; }\n.kr-card .callout-row{ display:grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-bottom: 22px; }\n@media (max-width: 720px){.kr-card .callout-row{ grid-template-columns: 1fr; }\n}\n.kr-card .callout{\n    background: var(--bad-soft); border: 1px solid var(--bad); border-radius: 12px;\n    padding: 16px; text-align:center;\n  }\n.kr-card .callout .v{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size: 26px; font-weight:700; color: var(--bad); }\n.kr-card .callout .l{ font-size: 12px; color: var(--ink-2); margin-top: 4px; }\n.kr-card .comp-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:14px; }\n@media (max-width: 720px){.kr-card .comp-grid{ grid-template-columns: 1fr; }\n}\n.kr-card .comp-card{ background: var(--surface); border:1px solid var(--border); border-radius:12px; padding:16px; box-shadow: var(--shadow); }\n.kr-card .comp-card h4{ margin:0 0 6px; font-size:14.5px; }\n.kr-card .comp-card p{ font-size: 13px; margin:0; }\n.kr-card .moat-note{\n    margin-top: 16px; padding: 14px 16px; border-radius: 10px;\n    background: var(--warm-soft); border:1px solid var(--warm); font-size: 13.5px; color: var(--ink);\n  }\n.kr-card .moat-note b{ color: var(--warm); }\n.kr-card .kpi-note{ font-size: 13.5px; background: var(--surface-2); border-radius: 10px; padding: 14px 16px; margin-top: 14px; }\n.kr-card .mgmt-row{ display:flex; gap: 18px; align-items:flex-start; }\n.kr-card .mgmt-avatar{\n    flex: none; width:56px; height:56px; border-radius:50%;\n    background: var(--accent-soft); color: var(--accent-ink);\n    display:flex; align-items:center; justify-content:center;\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-weight:600; font-size:20px;\n  }\n.kr-card ul.plain{ margin: 0; padding: 0; list-style: none; }\n.kr-card ul.plain li{ padding: 6px 0 6px 18px; position: relative; color: var(--ink-2); font-size: 14px; }\n.kr-card ul.plain li::before{ content: '—'; position:absolute; left:0; color: var(--ink-3); }\n.kr-card .return-grid{ display:grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 14px; }\n@media (max-width: 720px){.kr-card .return-grid{ grid-template-columns: 1fr 1fr; }\n}\n.kr-card .return-tile{ background: var(--surface); border:1px solid var(--border); border-radius: 12px; padding: 16px; box-shadow: var(--shadow); }\n.kr-card .return-tile .v{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size: 21px; font-weight:700; }\n.kr-card .return-tile .d{ font-size: 11.5px; color: var(--ink-3); margin-top: 6px; }\n.kr-card .thesis{\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-style: italic; font-size: 20px; line-height:1.55;\n    color: var(--ink); background: var(--bad-soft); border-left:3px solid var(--bad);\n    padding: 18px 22px; border-radius: 0 10px 10px 0; margin-bottom: 22px; text-wrap: balance;\n  }\n.kr-card .risk-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap:14px; }\n@media (max-width: 720px){.kr-card .risk-grid{ grid-template-columns: 1fr; }\n}\n.kr-card .risk-card{ background: var(--surface); border:1px solid var(--border); border-top: 3px solid var(--bad); border-radius: 10px; padding:16px; box-shadow: var(--shadow); }\n.kr-card .risk-card h4{ margin:0 0 8px; font-size:14px; }\n.kr-card .risk-card p{ font-size:13px; margin:0; }\n.kr-card .risk-card .src{ display:block; margin-top:8px; font-size:11px; color: var(--ink-3); font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; }\n.kr-card .fin-grid{ display:grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 24px; }\n@media (max-width: 720px){.kr-card .fin-grid{ grid-template-columns: 1fr; }\n}\n.kr-card .warn-box{ margin-top: 18px; padding: 14px 16px; background: var(--bad-soft); border:1px solid var(--bad); border-radius: 10px; font-size: 13.5px; }\n.kr-card .warn-box b{ color: var(--bad); }\n.kr-card .unknown-list{ display:flex; flex-direction:column; gap: 12px; }\n.kr-card .unknown-item{\n    background: var(--surface-2); border-radius: 10px; padding: 14px 16px;\n    font-size: 13.5px; color: var(--ink-2); display:flex; gap:10px;\n  }\n.kr-card .unknown-item .qmark{\n    flex:none; font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-style:italic; font-weight:600; color: var(--ink-3);\n  }\n.kr-card footer{ padding: 36px 0 10px; color: var(--ink-3); font-size: 12px; }\n.kr-card footer p{ color: var(--ink-3); font-size: 12px; max-width: none; }\n.kr-card .src-tag{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; color: var(--ink-3); font-size: 11.5px; }\n@media (max-width: 620px){.kr-card .stat-strip{ grid-template-columns: repeat(3,1fr); }\n.kr-card h1.company{ font-size: 30px; }\n.kr-card .drill{ font-size: 21px; }\n.kr-card .thesis{ font-size: 17px; }\n}\n</style>\n\n<div class=\"wrap\">\n\n  <header class=\"masthead\">\n    <div class=\"kicker\">\n      <span class=\"badge\">📄 Form 20-F FY2025 기반 · 페이지 출처 명시</span>\n      <span>CIK 0000937966 · SEC EDGAR</span>\n    </div>\n    <h1 class=\"company\">ASML Holding N.V.</h1>\n    <div class=\"ticker-line\">NASDAQ · Euronext Amsterdam <span class=\"mono\">ASML</span> — 네덜란드 벨트호벤(Veldhoven) 본사 · 반도체 노광장비(리소그래피) 제조</div>\n\n    <div class=\"stat-strip\">\n      <div class=\"stat\"><div class=\"v\">€32.7bn</div><div class=\"d\">+15.6%</div><div class=\"l\">총매출</div></div>\n      <div class=\"stat\"><div class=\"v\">52.8%</div><div class=\"d\">+1.5%p</div><div class=\"l\">매출총이익률</div></div>\n      <div class=\"stat\"><div class=\"v\">34.6%</div><div class=\"d\">+2.7%p</div><div class=\"l\">영업이익률</div></div>\n      <div class=\"stat\"><div class=\"v\">€9.6bn</div><div class=\"d\">+26.9%</div><div class=\"l\">순이익</div></div>\n      <div class=\"stat\"><div class=\"v\">€8.5bn</div><div class=\"d\">주주환원</div><div class=\"l\">배당+자사주</div></div>\n      <div class=\"stat\"><div class=\"v\">44,175</div><div class=\"d\">명</div><div class=\"l\">전체 임직원</div></div>\n    </div>\n  </header>\n\n  <section id=\"drill\">\n    <div class=\"eyebrow\"><span class=\"num\">①</span> 2분 드릴</div>\n    <p class=\"drill\">ASML은 반도체 회사가 손톱보다 작은 칩 위에 초미세 회로를 찍어내는 데 꼭 필요한 기계를, 전 세계에서 이 회사 혼자만 만들 줄 알아서, 한 대에 수백억~수천억 원을 받고 팔고, 판 뒤에도 고치고 업그레이드해 주며 계속 돈을 버는 회사입니다.</p>\n  </section>\n\n  <section id=\"flow\">\n    <div class=\"eyebrow\"><span class=\"num\">②</span> 돈 버는 구조</div>\n    <h2>부품 → 독점 기계 → 반도체 회사 → 설치 후에도 계속되는 돈</h2>\n    <div class=\"diagram-card\">\n      <svg viewBox=\"0 0 900 300\" class=\"diagram-svg\" role=\"img\" aria-label=\"ASML 비즈니스 모델 흐름도\">\n  <defs>\n    <marker id=\"arrowhead\" markerWidth=\"8\" markerHeight=\"8\" refX=\"6\" refY=\"3\" orient=\"auto\">\n      <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"var(--accent)\"/>\n    </marker>\n  </defs>\n\n  <rect x=\"16\" y=\"110\" width=\"150\" height=\"80\" rx=\"10\" class=\"flow-box\"/>\n  <text x=\"91\" y=\"140\" text-anchor=\"middle\" class=\"flow-label\">핵심 부품 공급사</text>\n  <text x=\"91\" y=\"158\" text-anchor=\"middle\" class=\"flow-sub\">Zeiss 광학·Trumpf 레이저</text>\n  <text x=\"91\" y=\"173\" text-anchor=\"middle\" class=\"flow-sub\">등 5,100개 협력사</text>\n\n  <path d=\"M166 150 H 300\" class=\"flow-arrow\"/>\n  <text x=\"233\" y=\"140\" text-anchor=\"middle\" class=\"flow-money\">부품 공급</text>\n\n  <rect x=\"300\" y=\"95\" width=\"180\" height=\"110\" rx=\"10\" class=\"flow-box hi\"/>\n  <text x=\"390\" y=\"130\" text-anchor=\"middle\" class=\"flow-label\">ASML</text>\n  <text x=\"390\" y=\"150\" text-anchor=\"middle\" class=\"flow-sub\">전 세계에서 유일하게</text>\n  <text x=\"390\" y=\"165\" text-anchor=\"middle\" class=\"flow-sub\">EUV 노광장비를 설계·조립</text>\n  <text x=\"390\" y=\"185\" text-anchor=\"middle\" class=\"flow-sub\">2025년 327대 판매</text>\n\n  <path d=\"M480 150 H 614\" class=\"flow-arrow\"/>\n  <text x=\"547\" y=\"140\" text-anchor=\"middle\" class=\"flow-money\">기계 판매</text>\n  <text x=\"547\" y=\"182\" text-anchor=\"middle\" class=\"flow-money\">대당 평균 €74.8M</text>\n\n  <rect x=\"614\" y=\"95\" width=\"190\" height=\"110\" rx=\"10\" class=\"flow-box\">\n  </rect>\n  <text x=\"709\" y=\"128\" text-anchor=\"middle\" class=\"flow-label\">반도체 제조사</text>\n  <text x=\"709\" y=\"148\" text-anchor=\"middle\" class=\"flow-sub\">최첨단 파운드리·메모리사</text>\n  <text x=\"709\" y=\"163\" text-anchor=\"middle\" class=\"flow-sub\">(대만·한국·미국 등)</text>\n  <text x=\"709\" y=\"183\" text-anchor=\"middle\" class=\"flow-sub\">상위 4곳이 매출 61.2% 차지</text>\n\n  <path d=\"M709 205 V 240 H 390 V 205\" class=\"flow-arrow loop\" fill=\"none\"/>\n  <text x=\"547\" y=\"258\" text-anchor=\"middle\" class=\"flow-money loop\">설치 후 서비스·업그레이드 매출 — 2025년 €8.2bn (전체의 25.1%)</text>\n\n  <path d=\"M804 150 H 880\" class=\"flow-arrow\"/>\n  <text x=\"842\" y=\"140\" text-anchor=\"middle\" class=\"flow-money\" style=\"font-size:10px;\">최첨단 칩</text>\n</svg>\n    </div>\n    <p style=\"margin-top:14px; font-size:13px;\">2025년 기준 신규 장비(시스템) 매출이 74.9%, 설치된 기계를 유지보수·업그레이드해서 버는 서비스 매출이 25.1%였습니다. 서비스 매출은 전년보다 26.2% 더 빠르게 늘어, ASML이 이미 깔아놓은 기계에서 나오는 반복 수익 비중이 커지고 있습니다. <span class=\"src-tag\">출처: 20-F FY2025, p.55</span></p>\n  </section>\n\n  <section id=\"revenue\">\n    <div class=\"eyebrow\"><span class=\"num\">③</span> 매출 구성 — 두 축</div>\n    <h2>어디서 벌고, 어디에 몰려 있나</h2>\n    <div class=\"cols-2\">\n      <div class=\"panel\">\n        <h3>사업부문별 매출 (2025)</h3>\n        <div class=\"cap\">시스템(신규 장비) vs 서비스·필드옵션(유지보수) · 부문별 영업이익률은 별도 공시 미제공</div>\n        <div class=\"segbar\">\n          <div class=\"seg-sys\" style=\"width:74.9%\"><span>시스템 74.9%</span></div>\n          <div class=\"seg-svc\" style=\"width:25.1%\"><span>서비스 25.1%</span></div>\n        </div>\n        <div class=\"seg-legend\">\n          <span class=\"k\"><span class=\"dot sys\"></span>시스템 €24.5bn (+12.4%)</span>\n          <span class=\"k\"><span class=\"dot svc\"></span>서비스 €8.2bn (+26.2%)</span>\n        </div>\n        <table class=\"mini-table\">\n          <tr><th>연도</th><th>시스템</th><th>서비스</th></tr>\n          <tr><td>2023</td><td>79.6%</td><td>20.4%</td></tr>\n          <tr><td>2024</td><td>77.0%</td><td>23.0%</td></tr>\n          <tr><td>2025</td><td>74.9%</td><td>25.1%</td></tr>\n        </table>\n        <p style=\"font-size:12px; margin-top:10px;\" class=\"src-tag\">출처: 20-F FY2025 p.55, FY2024 p.56</p>\n      </div>\n      <div class=\"panel\">\n        <h3>지역별 매출 (2025)</h3>\n        <div class=\"cap\">고객 시설 소재지 기준 · 아시아 5개국·지역 합계 85.9%</div>\n        <svg viewBox=\"0 0 560 220\" class=\"chart-svg\" role=\"img\" aria-label=\"chart\"><text x=\"58\" y=\"29.0\" class=\"axis-label\" text-anchor=\"end\">중국</text><rect x=\"68\" y=\"14\" width=\"398.2\" height=\"20\" rx=\"4\" class=\"bar-geo\"></rect><text x=\"474.2\" y=\"29.0\" class=\"bar-value\" text-anchor=\"start\">29.1%</text><text x=\"58\" y=\"63.0\" class=\"axis-label\" text-anchor=\"end\">대만</text><rect x=\"68\" y=\"48\" width=\"349.0\" height=\"20\" rx=\"4\" class=\"bar-geo\"></rect><text x=\"425.0\" y=\"63.0\" class=\"bar-value\" text-anchor=\"start\">25.5%</text><text x=\"58\" y=\"97.0\" class=\"axis-label\" text-anchor=\"end\">한국</text><rect x=\"68\" y=\"82\" width=\"342.1\" height=\"20\" rx=\"4\" class=\"bar-geo\"></rect><text x=\"418.1\" y=\"97.0\" class=\"bar-value\" text-anchor=\"start\">25.0%</text><text x=\"58\" y=\"131.0\" class=\"axis-label\" text-anchor=\"end\">미국</text><rect x=\"68\" y=\"116\" width=\"171.1\" height=\"20\" rx=\"4\" class=\"bar-geo\"></rect><text x=\"247.1\" y=\"131.0\" class=\"bar-value\" text-anchor=\"start\">12.5%</text><text x=\"58\" y=\"165.0\" class=\"axis-label\" text-anchor=\"end\">일본</text><rect x=\"68\" y=\"150\" width=\"58.8\" height=\"20\" rx=\"4\" class=\"bar-geo\"></rect><text x=\"134.8\" y=\"165.0\" class=\"bar-value\" text-anchor=\"start\">4.3%</text><text x=\"58\" y=\"199.0\" class=\"axis-label\" text-anchor=\"end\">기타</text><rect x=\"68\" y=\"184\" width=\"47.9\" height=\"20\" rx=\"4\" class=\"bar-geo\"></rect><text x=\"123.9\" y=\"199.0\" class=\"bar-value\" text-anchor=\"start\">3.5%</text></svg>\n        <p style=\"font-size:12px; margin-top:6px;\" class=\"src-tag\">출처: 20-F FY2025, Note 2, p.289</p>\n      </div>\n    </div>\n    <p style=\"margin-top:18px;\">매출의 86%가 중국·대만·한국·일본·싱가포르 등 아시아에서 나옵니다. 이 지역 통화(대만달러·원화·엔화)가 유로 대비 크게 흔들리거나, 미중 반도체 수출규제·대만해협 정세 같은 지정학 이슈가 터지면 매출 전체가 출렁일 수 있는 구조입니다.</p>\n  </section>\n\n  <section id=\"customers\">\n    <div class=\"eyebrow\"><span class=\"num\">④</span> 고객 &amp; 경쟁사</div>\n    <h2>몇 안 되는 고객에게, 사실상 경쟁자 없이 판다</h2>\n    <p>ASML은 경쟁상 이유로 20-F에 고객사 이름을 밝히지 않습니다. 다만 지역별 매출(대만·한국·미국 비중)로 미루어 TSMC·삼성전자·SK하이닉스·인텔·마이크론 같은 최첨단 파운드리·메모리 회사들이 주요 고객일 것으로 널리 알려져 있습니다 <span class=\"src-tag\">(웹검색 기반 참고 정보, 페이지 출처 없음)</span>.</p>\n    <div class=\"callout-row\">\n      <div class=\"callout\"><div class=\"v\">23.9%</div><div class=\"l\">2025년 최대 고객 1곳 비중<br>(€7,796.7M)</div></div>\n      <div class=\"callout\"><div class=\"v\">38.0%</div><div class=\"l\">상위 2개 고객 합계 비중</div></div>\n      <div class=\"callout\"><div class=\"v\">61.2%</div><div class=\"l\">10% 이상 차지하는 고객 4곳 합계<br>(€20.0bn)</div></div>\n    </div>\n    <p style=\"font-size:12.5px; margin-top:-8px;\" class=\"src-tag\">출처: 20-F FY2025, p.70</p>\n\n    <div class=\"comp-grid\" style=\"margin-top:22px;\">\n      <div class=\"comp-card\">\n        <h4>Nikon (일본)</h4>\n        <p>구형 공정용 DUV 노광장비에서 ASML과 직접 경쟁. 최첨단 EUV 장비는 만들지 못합니다.</p>\n      </div>\n      <div class=\"comp-card\">\n        <h4>Canon (일본)</h4>\n        <p>Nikon과 마찬가지로 저가·구형 DUV 시장에서 경쟁. EUV 시장에는 없습니다.</p>\n      </div>\n      <div class=\"comp-card\">\n        <h4>Applied Materials · KLA (미국)</h4>\n        <p>노광장비가 아니라 증착·식각·계측 등 인접 공정 장비 회사. ASML의 \"홀리스틱 리소그래피\" 전략과 경쟁·협력이 겹칩니다.</p>\n      </div>\n    </div>\n    <div class=\"moat-note\"><b>최첨단(EUV) 시장엔 경쟁사가 없습니다.</b> 20-F 경쟁사 서술 자체가 DUV(구형)에서만 Nikon·Canon을 언급할 뿐, EUV에는 경쟁사 이름이 아예 등장하지 않습니다 — 전 세계에서 EUV 노광장비를 만들 수 있는 곳은 ASML뿐이라는 뜻입니다. <span class=\"src-tag\">출처: 20-F FY2025, p.67</span></div>\n  </section>\n\n  <section id=\"kpi\">\n    <div class=\"eyebrow\"><span class=\"num\">⑤</span> 이 업종의 핵심 KPI</div>\n    <h2>대수가 아니라 \"대당 얼마에 파는가\"</h2>\n    <p>ASML은 매출·이익 같은 일반 지표보다 <b>시스템 대당 평균판매가격(ASP)</b>과 <b>EUV 시스템 출하 대수</b>를 봐야 진짜 이야기가 보입니다. 2025년엔 판매 대수(327대)가 2024년(418대)보다 오히려 줄었는데도 매출은 늘었습니다 — 더 비싸고 어려운 최신 기계(High NA EUV)의 비중이 커졌기 때문입니다. 이 ASP 상승세가 꺾이면 ASML의 \"기술 우위\" 스토리 자체가 흔들리고 있다는 신호입니다.</p>\n    <div class=\"cols-2\">\n      <div class=\"panel\">\n        <h3>시스템 평균판매가격(ASP)</h3>\n        <div class=\"cap\">시스템 매출 ÷ 판매 대수, 자체 계산</div>\n        <svg viewBox=\"0 0 560 220\" class=\"chart-svg\" role=\"img\" aria-label=\"chart\"><line x1=\"46\" y1=\"186.0\" x2=\"544\" y2=\"186.0\" class=\"grid\"/><text x=\"38\" y=\"190.0\" class=\"axis-label\" text-anchor=\"end\">€0M</text><line x1=\"46\" y1=\"114.7\" x2=\"544\" y2=\"114.7\" class=\"grid\"/><text x=\"38\" y=\"118.7\" class=\"axis-label\" text-anchor=\"end\">€40M</text><line x1=\"46\" y1=\"43.4\" x2=\"544\" y2=\"43.4\" class=\"grid\"/><text x=\"38\" y=\"47.4\" class=\"axis-label\" text-anchor=\"end\">€80M</text><polyline points=\"46.0,107.2 170.5,106.3 295.0,98.8 419.5,93.1 544.0,52.7\" class=\"line-asp\"/><circle cx=\"46.0\" cy=\"107.2\" r=\"5\" class=\"dot-asp\"></circle><text x=\"46.0\" y=\"95.2\" class=\"bar-value\" text-anchor=\"middle\">€44M</text><text x=\"46.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2021</text><circle cx=\"170.5\" cy=\"106.3\" r=\"5\" class=\"dot-asp\"></circle><text x=\"170.5\" y=\"94.3\" class=\"bar-value\" text-anchor=\"middle\">€45M</text><text x=\"170.5\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2022</text><circle cx=\"295.0\" cy=\"98.8\" r=\"5\" class=\"dot-asp\"></circle><text x=\"295.0\" y=\"86.8\" class=\"bar-value\" text-anchor=\"middle\">€49M</text><text x=\"295.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2023</text><circle cx=\"419.5\" cy=\"93.1\" r=\"5\" class=\"dot-asp\"></circle><text x=\"419.5\" y=\"81.1\" class=\"bar-value\" text-anchor=\"middle\">€52M</text><text x=\"419.5\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2024</text><circle cx=\"544.0\" cy=\"52.7\" r=\"5\" class=\"dot-asp\"></circle><text x=\"544.0\" y=\"40.7\" class=\"bar-value\" text-anchor=\"middle\">€75M</text><text x=\"544.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2025</text></svg>\n      </div>\n      <div class=\"panel\">\n        <h3>EUV 시스템 출하 대수</h3>\n        <div class=\"cap\">연간 인식된 EUV 시스템 수</div>\n        <svg viewBox=\"0 0 560 220\" class=\"chart-svg\" role=\"img\" aria-label=\"chart\"><line x1=\"46\" y1=\"186.0\" x2=\"544\" y2=\"186.0\" class=\"grid\"/><text x=\"38\" y=\"190.0\" class=\"axis-label\" text-anchor=\"end\">0대</text><line x1=\"46\" y1=\"117.9\" x2=\"544\" y2=\"117.9\" class=\"grid\"/><text x=\"38\" y=\"121.9\" class=\"axis-label\" text-anchor=\"end\">25대</text><line x1=\"46\" y1=\"49.8\" x2=\"544\" y2=\"49.8\" class=\"grid\"/><text x=\"38\" y=\"53.8\" class=\"axis-label\" text-anchor=\"end\">50대</text><rect x=\"159.0\" y=\"71.6\" width=\"40.0\" height=\"114.4\" rx=\"4\" class=\"bar-euv\"></rect><text x=\"179.0\" y=\"65.6\" class=\"bar-value\" text-anchor=\"middle\">42대</text><text x=\"179.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2021</text><rect x=\"217.0\" y=\"77.1\" width=\"40.0\" height=\"108.9\" rx=\"4\" class=\"bar-euv\"></rect><text x=\"237.0\" y=\"71.1\" class=\"bar-value\" text-anchor=\"middle\">40대</text><text x=\"237.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2022</text><rect x=\"275.0\" y=\"41.7\" width=\"40.0\" height=\"144.3\" rx=\"4\" class=\"bar-euv\"></rect><text x=\"295.0\" y=\"35.7\" class=\"bar-value\" text-anchor=\"middle\">53대</text><text x=\"295.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2023</text><rect x=\"333.0\" y=\"66.2\" width=\"40.0\" height=\"119.8\" rx=\"4\" class=\"bar-euv\"></rect><text x=\"353.0\" y=\"60.2\" class=\"bar-value\" text-anchor=\"middle\">44대</text><text x=\"353.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2024</text><rect x=\"391.0\" y=\"55.3\" width=\"40.0\" height=\"130.7\" rx=\"4\" class=\"bar-euv\"></rect><text x=\"411.0\" y=\"49.3\" class=\"bar-value\" text-anchor=\"middle\">48대</text><text x=\"411.0\" y=\"208.0\" class=\"axis-label\" text-anchor=\"middle\">2025</text></svg>\n      </div>\n    </div>\n    <div class=\"kpi-note\">2025년 판매 327대 · EUV 48대(2024: 44대) → 2025 ASP <b>€74.8M</b>, 2024 대비 +43.6% <span class=\"src-tag\">출처: 20-F FY2025 p.55, FY2022 p.45(2021·2022 대수) — ASP는 자체 계산</span></div>\n  </section>\n\n  <section id=\"mgmt\">\n    <div class=\"eyebrow\"><span class=\"num\">⑥</span> 경영진 &amp; 오너십</div>\n    <h2>2024년에 바뀐 선장</h2>\n    <div class=\"mgmt-row\">\n      <div class=\"mgmt-avatar\">CF</div>\n      <ul class=\"plain\">\n        <li><b style=\"color:var(--ink)\">Christophe Fouquet</b> (1973년생, 프랑스) — 2024년 4월 24일부터 President·CEO 겸 이사회 의장. 2008년 ASML 입사 후 EUV 총괄 부사장(2018–22), 최고사업책임자(2022–24) 역임. 입사 전 경쟁사 KLA-Tencor·Applied Materials 근무. <span class=\"src-tag\">(p.80, p.129)</span></li>\n        <li>ASML은 1984년 필립스와 ASM인터내셔널의 합작으로 설립된 회사로, 창업 주체였던 두 회사는 현재 경영에 관여하지 않습니다 <span class=\"src-tag\">(일반 공개 정보)</span>.</li>\n        <li>임원·내부자 합산 지분율은 이번 자료에서 명확한 총계를 찾지 못했습니다 — <b>확인 필요</b>.</li>\n      </ul>\n    </div>\n  </section>\n\n  <section id=\"returns\">\n    <div class=\"eyebrow\"><span class=\"num\">⑦</span> 주주환원</div>\n    <h2>이익보다 더 크게 돌려준 한 해</h2>\n    <div class=\"return-grid\">\n      <div class=\"return-tile\"><div class=\"v\">€7.50</div><div class=\"d\">2025년 제안 연간 배당(주당)<br>2024: €6.40</div></div>\n      <div class=\"return-tile\"><div class=\"v\">€5.9bn</div><div class=\"d\">2025년 자사주 매입<br>2024: €0.5bn</div></div>\n      <div class=\"return-tile\"><div class=\"v\">€8.5bn</div><div class=\"d\">총 주주환원<br>(순이익의 91.7%, 자체 계산)</div></div>\n      <div class=\"return-tile\"><div class=\"v\">388.5M</div><div class=\"d\">가중평균 발행주식수<br>2023: 393.8M → 계속 감소</div></div>\n    </div>\n    <p>자사주를 사들인 만큼 실제로 유통 주식수가 줄고 있어(2023년 3억9,380만주 → 2025년 3억8,850만주), 임직원 보상으로 다시 늘어나 버리는 \"빛 좋은 매입\"은 아닙니다. <span class=\"src-tag\">출처: 20-F FY2025 p.44, p.317</span></p>\n  </section>\n\n  <section id=\"risk\">\n    <div class=\"eyebrow\"><span class=\"num\">⑧</span> 이 회사가 망하는 시나리오</div>\n    <p class=\"thesis\">반도체 회사들이 더 이상 미세공정 경쟁을 하지 않게 되거나, 미중 갈등으로 ASML이 최대 고객군(중국·대만·한국)에 기계를 팔지 못하게 되는 순간, 대체 불가능해 보이던 ASML의 지위도 한순간에 흔들립니다.</p>\n    <div class=\"risk-grid\">\n      <div class=\"risk-card\">\n        <h4>고객 집중 리스크</h4>\n        <p>2025년 고객 1곳이 매출의 23.9%, 상위 4곳이 61.2%를 차지합니다. 이 중 한 곳만 투자를 늦춰도 실적 전체가 크게 흔들립니다.</p>\n        <span class=\"src\">출처: 20-F FY2025, p.70</span>\n      </div>\n      <div class=\"risk-card\">\n        <h4>지정학·수출규제 리스크</h4>\n        <p>매출의 86%가 중국·대만·한국 등 아시아에서 나옵니다. 미국·네덜란드·일본 정부의 대중 수출규제가 강화되거나 대만해협 정세가 악화되면 판매 자체가 막힐 수 있습니다.</p>\n        <span class=\"src\">출처: 20-F FY2025 p.289 (자체 계산)</span>\n      </div>\n      <div class=\"risk-card\">\n        <h4>반도체 업황 사이클 리스크</h4>\n        <p>2023년 30.2%였던 매출 증가율이 2024년 2.6%로 급격히 둔화됐습니다. 반도체 장비는 경기를 크게 타는 산업이라, 고객사가 투자를 줄이면 ASML 매출도 함께 꺾입니다.</p>\n        <span class=\"src\">출처: 20-F FY2025 p.55–56, p.61 (자체 계산)</span>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"financials\">\n    <div class=\"eyebrow\"><span class=\"num\">⑨</span> 핵심 재무 (5년)</div>\n    <h2>숫자로 본 2021~2025</h2>\n    <div style=\"overflow-x:auto;\">\n    <table>\n      <tr><th>연도</th><th>매출</th><th>YoY</th><th>영업이익</th><th>영업이익률</th><th>순이익</th><th>잉여현금흐름</th></tr>\n      <tr><td>2021</td><td>€18,611M</td><td>—</td><td>€6,750M</td><td>36.3%</td><td>€5,883M</td><td>€9,906M</td></tr>\n      <tr><td>2022</td><td>€21,173M</td><td class=\"yoy-pos\">+13.8%</td><td>€6,501M</td><td>30.7%</td><td>€5,624M</td><td>€7,168M</td></tr>\n      <tr><td>2023</td><td>€27,559M</td><td class=\"yoy-pos\">+30.2%</td><td>€9,042M</td><td>32.8%</td><td>€7,839M</td><td>€3,247M</td></tr>\n      <tr><td>2024</td><td>€28,263M</td><td class=\"yoy-pos\">+2.6%</td><td>€9,023M</td><td>31.9%</td><td>€7,572M</td><td>€9,083M</td></tr>\n      <tr><td>2025</td><td>€32,667M</td><td class=\"yoy-pos\">+15.6%</td><td>€11,301M</td><td>34.6%</td><td>€9,609M</td><td>€11,027M</td></tr>\n    </table>\n    </div>\n    <p style=\"font-size:12px; margin-top:8px;\" class=\"src-tag\">출처: 20-F FY2025 p.55, FY2024 p.57, FY2022 p.45 · 잉여현금흐름 = 영업활동현금흐름 − 유형자산취득 − 무형자산취득 (자체 계산)</p>\n\n    <div class=\"fin-grid\">\n      <div class=\"panel\"><h3>매출</h3><div class=\"cap\">€, 백만 → 표기는 십억(bn) 단위</div><svg viewBox=\"0 0 560 220\" class=\"chart-svg\" role=\"img\" aria-label=\"chart\"><line x1=\"46\" y1=\"186.0\" x2=\"544\" y2=\"186.0\" class=\"grid\"/><text x=\"38\" y=\"190.0\" class=\"axis-label\" text-anchor=\"end\">€0.0bn</text><line x1=\"46\" y1=\"119.7\" x2=\"544\" y
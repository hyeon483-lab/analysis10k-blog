{"html":"<div class=\"kr-card\"><style>.kr-card{\n    color-scheme: light;\n    --bg:#f9f9f6; --paper:#fffffe; --paper-tint:#f2f1ea;\n    --ink:#1b2130; --ink-2:#4b5468; --muted:#8a8f9c;\n    --hair:#dfe0da; --hair-strong:#c7c9c0;\n    --navy:#1e3a5f; --navy-ink:#16304f;\n    --s1:#2a78d6;\n    --good:#0f7a3d; --good-bg:#e8f5ec;\n    --warn:#a8720a; --warn-bg:#fbf1de;\n    --bad:#b23b3b; --bad-bg:#fbebe9;\n  }\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n      color-scheme: dark;\n      --bg:#0f1115; --paper:#15171c; --paper-tint:#1b1d22;\n      --ink:#f2f1ec; --ink-2:#c3c2b7; --muted:#8a8f9c;\n      --hair:#2b2d33; --hair-strong:#3a3d44;\n      --navy:#5c8ec9; --navy-ink:#8fb6e6;\n      --s1:#3987e5;\n      --good:#3fbf76; --good-bg:#12251a;\n      --warn:#e0a933; --warn-bg:#2a2214;\n      --bad:#e66767; --bad-bg:#2a1a19;\n    }\n}\n:root[data-theme=\"dark\"] .kr-card{\n    color-scheme: dark;\n    --bg:#0f1115; --paper:#15171c; --paper-tint:#1b1d22;\n    --ink:#f2f1ec; --ink-2:#c3c2b7; --muted:#8a8f9c;\n    --hair:#2b2d33; --hair-strong:#3a3d44;\n    --navy:#5c8ec9; --navy-ink:#8fb6e6;\n    --s1:#3987e5;\n    --good:#3fbf76; --good-bg:#12251a;\n    --warn:#e0a933; --warn-bg:#2a2214;\n    --bad:#e66767; --bad-bg:#2a1a19;\n  }\n.kr-card *{box-sizing:border-box;}\n.kr-card, .kr-card{margin:0;padding:0;}\n.kr-card{ background:var(--bg); color:var(--ink); font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; line-height:1.6; -webkit-font-smoothing:antialiased; }\n.kr-card .num{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-variant-numeric:tabular-nums; }\n.kr-card .page{ max-width:720px; margin:0 auto; padding:32px 20px 60px; }\n.kr-card .kicker{ font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); font-weight:600; }\n.kr-card .ticker-row{ display:flex; justify-content:space-between; align-items:baseline; margin:6px 0 22px; flex-wrap:wrap; gap:8px;}\n.kr-card .ticker-row h1{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-size:26px; font-weight:600; margin:0; }\n.kr-card .ticker-row .price{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:20px; font-weight:600; color:var(--ink-2); }\n.kr-card .verdict-hero{ background:var(--navy); color:#fff; border-radius:12px; padding:30px 28px; margin-bottom:18px; }\n.kr-card .verdict-hero .line1{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-size:23px; line-height:1.45; margin:0 0 14px; }\n.kr-card .verdict-hero .line1 .g{ font-weight:700; font-size:1.15em; }\n.kr-card .verdict-hero .line2{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-style:italic; font-size:18px; color:#c9d8ea; margin:0; line-height:1.45; }\n.kr-card .verdict-hero .line2 .y{ font-weight:700; color:#fff; font-style:normal; }\n.kr-card .badge{ display:flex; gap:12px; align-items:flex-start; border-radius:10px; padding:16px 18px; margin-bottom:28px; font-size:14px; }\n.kr-card .badge.bad{ background:var(--bad-bg); color:var(--bad); }\n.kr-card .badge .icon{ font-size:22px; line-height:1; }\n.kr-card .badge p{ margin:0; color:var(--ink-2); }\n.kr-card .badge b{ color:var(--ink); }\n.kr-card section{ margin:34px 0; }\n.kr-card .sec-label{ font-size:11.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); display:flex; align-items:center; gap:8px; margin-bottom:10px;}\n.kr-card .sec-label::after{ content:\"\"; flex:1; height:1px; background:var(--hair-strong); }\n.kr-card h2.sec-title{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-weight:600; font-size:19px; margin:0 0 12px; }\n.kr-card .growth-chart{ display:flex; align-items:flex-end; gap:20px; height:180px; margin:20px 0 8px; }\n.kr-card .gc-col{ flex:1; display:flex; flex-direction:column; align-items:center; height:100%; justify-content:flex-end; }\n.kr-card .gc-bar{ width:60%; border-radius:4px 4px 0 0; position:relative; }\n.kr-card .gc-val{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:14px; font-weight:600; margin-bottom:6px; }\n.kr-card .gc-lbl{ font-size:11.5px; color:var(--muted); margin-top:8px; text-align:center; line-height:1.3; }\n.kr-card .gc-lbl b{ display:block; color:var(--ink-2); font-size:11px;}\n.kr-card table.sens{ width:100%; border-collapse:collapse; font-size:13.5px; }\n.kr-card table.sens th{ text-align:center; font-weight:600; color:var(--ink-2); font-size:11.5px; text-transform:uppercase; padding:8px; border-bottom:1px solid var(--hair-strong); }\n.kr-card table.sens td{ text-align:center; padding:10px 8px; border-bottom:1px solid var(--hair); font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; }\n.kr-card table.sens th:first-child, .kr-card table.sens td:first-child{ text-align:left; font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; }\n.kr-card table.sens tr.base td{ font-weight:700; background:var(--paper-tint); }\n.kr-card .tbl-wrap{ overflow-x:auto; background:var(--paper); border:1px solid var(--hair); border-radius:10px; padding:4px 14px; }\n.kr-card .wobble{ background:var(--paper); border:1px solid var(--hair); border-radius:10px; padding:16px 18px; margin-bottom:10px; font-size:13.5px; color:var(--ink-2); }\n.kr-card .wobble b{ color:var(--ink); }\n.kr-card .wobble .tag{ display:inline-block; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10.5px; background:var(--paper-tint); border-radius:4px; padding:2px 6px; margin-right:8px; color:var(--navy-ink); font-weight:600;}\n.kr-card details{ background:var(--paper); border:1px solid var(--hair); border-radius:10px; padding:14px 18px; }\n.kr-card details summary{ cursor:pointer; font-weight:600; font-size:14px; color:var(--navy-ink); }\n.kr-card details[open] summary{ margin-bottom:12px; }\n.kr-card .calc-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:8px 20px; font-size:13px; }\n.kr-card .calc-grid .k{ color:var(--ink-2); }\n.kr-card .calc-grid .v{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; text-align:right; }\n.kr-card .calc-cite{ font-size:11px; color:var(--muted); margin-top:2px; }\n.kr-card .calc-note{ font-size:12.5px; color:var(--ink-2); margin-top:12px; padding-top:12px; border-top:1px solid var(--hair); }\n.kr-card .warning{ background:var(--warn-bg); border:1px solid color-mix(in srgb, var(--warn) 40%, transparent); border-radius:10px; padding:18px 20px; }\n.kr-card .warning .head{ color:var(--warn); font-weight:700; font-size:13.5px; margin-bottom:10px; }\n.kr-card .warning ul{ margin:0; padding-left:18px; font-size:13px; color:var(--ink-2); }\n.kr-card .warning li{ margin:6px 0; }\n.kr-card footer{ margin-top:36px; padding-top:14px; border-top:1px solid var(--hair-strong); font-size:11.5px; color:var(--muted); display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;}\n@media (max-width:600px){.kr-card .growth-chart{ gap:10px; }\n.kr-card .calc-grid{ grid-template-columns:1fr; }\n.kr-card .verdict-hero .line1{ font-size:19px; }\n}\n</style>\n\n<div class=\"page\">\n  <div class=\"kicker\">💰 가격 판독기 · Reverse DCF</div>\n  <div class=\"ticker-row\">\n    <h1>버크셔 해서웨이 (BRK.B)</h1>\n    <div class=\"price num\">$495.82</div>\n  </div>\n\n  <!-- ① 결론 -->\n  <div class=\"verdict-hero\">\n    <p class=\"line1\">지금 BRK.B 주가는 앞으로 10년간 매년 <span class=\"g num\">약 16.6%</span>씩 잉여현금흐름(FCF)이 늘어난다는 가정을 깔고 있습니다.</p>\n    <p class=\"line2\">지난 5년(2021→2025) 실제 매출 성장률은 연평균 <span class=\"y num\">7.7%</span>였습니다.</p>\n  </div>\n\n  <!-- ② 판정 -->\n  <div class=\"badge bad\">\n    <div class=\"icon\">🔴</div>\n    <p><b>시장은 이 회사가 과거보다 훨씬 잘할 거라 기대하고 있습니다.</b> 요구 성장률(16.6%)이 최근 5년 매출 성장(7.7%)의 2배가 넘습니다. 이 기대의 근거가 실제로 있는지 — 신임 CEO 아벨의 자본배분, 보험 인수 여력, 알파벳 등 신규 대형 투자 — 를 더 파봐야 합니다. <u>이건 \"사라/팔아라\"가 아니라 \"여기를 더 확인하라\"는 신호입니다.</u></p>\n  </div>\n\n  <!-- ③ 그래프 -->\n  <section>\n    <div class=\"sec-label\">비교</div>\n    <h2 class=\"sec-title\">시장이 요구하는 성장률 vs 실제 과거 성장률</h2>\n    <div class=\"growth-chart\">\n      <div class=\"gc-col\">\n        <div class=\"gc-val\" style=\"color:var(--bad)\">16.6%</div>\n        <div class=\"gc-bar\" style=\"height:100%;background:var(--bad)\"></div>\n        <div class=\"gc-lbl\"><b>시장 요구</b>WACC 9% 기준</div>\n      </div>\n      <div class=\"gc-col\">\n        <div class=\"gc-val\">7.7%</div>\n        <div class=\"gc-bar\" style=\"height:46.4%;background:var(--s1)\"></div>\n        <div class=\"gc-lbl\"><b>매출 CAGR</b>FY21→FY25</div>\n      </div>\n      <div class=\"gc-col\">\n        <div class=\"gc-val\">11.8%</div>\n        <div class=\"gc-bar\" style=\"height:71.1%;background:var(--s1)\"></div>\n        <div class=\"gc-lbl\"><b>핵심영업이익 CAGR</b>투자손익 제외</div>\n      </div>\n      <div class=\"gc-col\">\n        <div class=\"gc-val\" style=\"color:var(--muted)\">-1.1%</div>\n        <div class=\"gc-bar\" style=\"height:6%;background:var(--muted)\"></div>\n        <div class=\"gc-lbl\"><b>FCF CAGR</b>⚠️변동성 큼 (아래 참조)</div>\n      </div>\n    </div>\n    <p class=\"calc-cite\">출처: 10-K FY2025/FY2022 재무제표(매출·영업이익), 현금흐름표(FCF). 10년 CAGR은 보유 자료 범위(FY2021~) 밖이라 계산 불가(확인 필요).</p>\n  </section>\n\n  <!-- ④ 민감도 -->\n  <section>\n    <div class=\"sec-label\">민감도</div>\n    <h2 class=\"sec-title\">할인율(WACC)별 요구 성장률</h2>\n    <div class=\"tbl-wrap\">\n      <table class=\"sens\">\n        <thead><tr><th>WACC</th><th>요구 성장률<br>(최근 FCF 기준)</th><th>요구 성장률<br>(3년 평균 FCF 기준)</th></tr></thead>\n        <tbody>\n          <tr><td>7%</td><td class=\"num\">11.2%</td><td class=\"num\">12.7%</td></tr>\n          <tr class=\"base\"><td>9% (기본값 · 대형 안정기업)</td><td class=\"num\">16.6%</td><td class=\"num\">18.3%</td></tr>\n          <tr><td>11%</td><td class=\"num\">21.2%</td><td class=\"num\">22.9%</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <!-- ⑤ 흔들리는 조건 -->\n  <section>\n    <div class=\"sec-label\">주의</div>\n    <h2 class=\"sec-title\">이 숫자가 흔들리는 조건</h2>\n\n    <div class=\"wobble\">\n      <span class=\"tag\">가장 큰 변수</span>\n      버크셔는 현금성자산($519억) 외에 <b>단기 미국국채(T-Bill)를 $3,214억이나</b> 따로 들고 있습니다. 이걸 \"쓸 수 있는 순현금\"으로 보고 부채에서 다 빼면, 기업가치(EV)가 $8,254억까지 줄어들고 요구 성장률은 <b>WACC 9% 기준 12.3%까지 떨어집니다</b>(매출 성장률 7.7%와의 격차가 크게 좁혀짐). 다만 이 국채 대부분은 보험 미지급금(향후 보험금 지급 대비)을 받쳐주는 돈이라, 주주가 마음대로 꺼내 쓸 수 있는 \"여윳돈\"인지는 논쟁의 여지가 있습니다.\n    </div>\n    <div class=\"wobble\">\n      <span class=\"tag\">FCF 기준값</span>\n      최근 1년(FY2025) FCF $250억 대신 최근 3년 평균($221억)을 쓰면, 요구 성장률이 WACC 9% 기준 16.6% → <b>18.3%로 더 올라갑니다</b>. FY2024엔 설비투자가 크게 늘며 FCF가 $116억까지 급감했었고, 이 변동성 때문에 FCF CAGR(-1.1%)은 실제 사업 체력을 왜곡해서 보여줍니다 — 매출(7.7%)이나 핵심영업이익(11.8%) 성장률이 더 믿을 만한 비교 대상입니다.\n    </div>\n    <div class=\"wobble\">\n      <span class=\"tag\">모델 자체의 한계</span>\n      버크셔의 진짜 가치 상당 부분은 \"영업활동으로 버는 현금(FCF)\"이 아니라 <b>보유 주식·기업 포트폴리오의 평가액 변동</b>에서 나옵니다. 역DCF는 이 부분을 전혀 반영하지 못하므로, 버크셔 같은 지주회사에는 일반 사업회사보다 더 거친 근사치일 수밖에 없습니다.\n    </div>\n  </section>\n\n  <!-- ⑥ 계산 과정 -->\n  <section>\n    <details>\n      <summary>🔧 계산 과정 보기 (입력값·가정·산식)</summary>\n      <div class=\"calc-grid\">\n        <div class=\"k\">현재 주가 (BRK.B)</div><div class=\"v\">$495.82</div>\n        <div class=\"k\">희석주식수 (B환산)</div><div class=\"v\">2,157,334,500주</div>\n        <div class=\"k\">시가총액</div><div class=\"v\">$1,069.65B</div>\n        <div class=\"k\">총차입금 (FY2025)</div><div class=\"v\">$129,081M</div>\n        <div class=\"k\">현금성자산 (FY2025, 보험+철도·에너지)</div><div class=\"v\">$51,877M</div>\n        <div class=\"k\">순부채 (기본, 국채 제외)</div><div class=\"v\">$77,204M</div>\n        <div class=\"k\">기업가치(EV) = 시총+순부채</div><div class=\"v\">$1,146,854M</div>\n        <div class=\"k\">최근 FCF (FY2025)</div><div class=\"v\">$25,042M</div>\n        <div class=\"k\">3년 평균 FCF (FY23–25)</div><div class=\"v\">$22,148M</div>\n        <div class=\"k\">할인율(WACC) 기본값</div><div class=\"v\">9%</div>\n        <div class=\"k\">영구성장률</div><div class=\"v\">2.5% (고정)</div>\n        <div class=\"k\">명시적 성장 기간</div><div class=\"v\">10년</div>\n      </div>\n      <div class=\"calc-note\">\n        모델: 2단계 DCF. EV = Σ(t=1~10) FCF₀(1+g)ᵗ/(1+WACC)ᵗ + [FCF₀(1+g)¹⁰(1+2.5%)/(WACC−2.5%)]/(1+WACC)¹⁰. 이분법으로 EV=1,146,854를 만족하는 g를 역산.<br>\n        희석주식수: FY2025 10-K 손익계산서 \"Average equivalent Class A shares outstanding\" 1,438,223주 × 1,500(A:B 환산비) = B환산 2,157,334,500주. (출처: 10-K FY2025 라인 ~10376)<br>\n        총차입금·현금성자산: 10-K FY2025 재무상태표(보험·기타 + 철도·에너지·유틸리티 두 구간 합산).<br>\n        주가: stockanalysis.com, 2026-08-21 종가 기준.\n      </div>\n    </details>\n  </section>\n\n  <!-- ⑦ 경고 -->\n  <div class=\"warning\">\n    <div class=\"head\">⚠️ 이 숫자는 판단의 시작이지 답이 아닙니다</div>\n    <ul>\n      <li>가정(할인율, 성장 기간, 영구성장률, 순부채 정의)이 바뀌면 결과가 크게 바뀝니다 — 위에서 본 것처럼 국채 처리 방식 하나만으로 요구 성장률이 16.6%에서 12.3%까지 움직입니다.</li>\n      <li>역DCF는 \"시장이 뭘 기대하는가\"를 보여줄 뿐, \"얼마가 적정한가\"를 말하지 않습니다.</li>\n      <li>그 기대가 타당한지는 사업 모델과 경쟁 환경, 신임 경영진(아벨)의 실제 행보를 직접 확인해야 알 수 있습니다.</li>\n      <li>투자 판단과 그 결과는 본인 책임입니다.</li>\n    </ul>\n  </div>\n\n  <footer>\n    <span>💰 가격 판독기 · 적정주가 제시 아님 · 모든 계산은 코드 실행으로 검증</span>\n    <span>기준일 2026-08-23</span>\n  </footer>\n</div></div>","scripts":[],"ext":[],"lede":""}
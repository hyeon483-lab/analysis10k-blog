{"html":"<div class=\"kr-card\"><style>.kr-card{\n  --bg:#f7f5f1;\n  --surface:#ffffff;\n  --surface-soft:#f0ede6;\n  --ink:#1b2430;\n  --ink-soft:#565f6c;\n  --ink-faint:#8b93a0;\n  --line:#dedad1;\n  --navy:#16324f;\n  --navy-soft:#2e5478;\n  --gold:#a9762f;\n  --gold-soft:#f3e6d1;\n  --good:#1f7a4d;\n  --good-bg:#e7f3ec;\n  --bad:#a53d2c;\n  --bad-bg:#faeae6;\n  --shadow: 0 1px 2px rgba(27,36,48,.04), 0 8px 24px -12px rgba(27,36,48,.12);\n}\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n    --bg:#14181f; --surface:#1c222b; --surface-soft:#232a34;\n    --ink:#eceef1; --ink-soft:#a7b0bc; --ink-faint:#707a87; --line:#333c48;\n    --navy:#7fa8cc; --navy-soft:#a9c6df; --gold:#d9a95c; --gold-soft:#3a3020;\n    --good:#5fbf8c; --good-bg:#16281f; --bad:#e08770; --bad-bg:#2c1c18;\n    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);\n  }\n}\n:root[data-theme=\"dark\"] .kr-card{\n  --bg:#14181f; --surface:#1c222b; --surface-soft:#232a34;\n  --ink:#eceef1; --ink-soft:#a7b0bc; --ink-faint:#707a87; --line:#333c48;\n  --navy:#7fa8cc; --navy-soft:#a9c6df; --gold:#d9a95c; --gold-soft:#3a3020;\n  --good:#5fbf8c; --good-bg:#16281f; --bad:#e08770; --bad-bg:#2c1c18;\n  --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);\n}\n.kr-card *{box-sizing:border-box;}\n.kr-card{background:var(--bg);color:var(--ink);font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;line-height:1.7;}\n.kr-card .wrap{max-width:860px;margin:0 auto;padding:28px 20px 80px;}\n.kr-card h1, .kr-card h2, .kr-card h3{font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;font-weight:600;text-wrap:balance;letter-spacing:-.01em;}\n.kr-card .tnum{font-variant-numeric:tabular-nums;}\n.kr-card .badge{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--navy-soft);\n  background:var(--surface-soft);border:1px solid var(--line);padding:5px 12px;border-radius:999px;margin-bottom:16px;}\n.kr-card .badge .dot{width:6px;height:6px;border-radius:50%;background:var(--good);}\n.kr-card .masthead h1{font-size:30px;margin:0 0 6px;}\n.kr-card .masthead .sub{color:var(--ink-soft);font-size:14px;margin:0 0 22px;}\n.kr-card .onesent{\n  margin:20px 0 36px;padding:22px 26px;background:var(--navy);border-radius:16px;color:#fdfbf7;box-shadow:var(--shadow);\n}\n.kr-card .onesent .eyebrow{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:#c9d6e2;margin-bottom:8px;font-weight:600;}\n.kr-card .onesent p{font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;font-size:19px;line-height:1.5;margin:0;font-weight:500;}\n.kr-card section{margin:46px 0;}\n.kr-card .sec-head{display:flex;align-items:baseline;gap:10px;margin-bottom:14px;}\n.kr-card .sec-num{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;color:var(--gold);font-size:13px;font-weight:600;}\n.kr-card .sec-head h2{font-size:22px;margin:0;}\n.kr-card .sec-sub{color:var(--ink-faint);font-size:12.5px;margin:-6px 0 16px;}\n.kr-card .story p{font-size:16px;margin:0 0 18px;color:var(--ink);}\n.kr-card .story .fact{background:var(--surface-soft);padding:1px 4px;border-radius:4px;font-size:.92em;}\n.kr-card .story .interp{color:var(--ink-soft);font-style:italic;}\n.kr-card .story-block{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:26px 28px;box-shadow:var(--shadow);}\n.kr-card .story-block h3{font-size:14px;color:var(--gold);margin:0 0 6px;font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;letter-spacing:.02em;}\n.kr-card .story-block .beat{margin-bottom:22px;}\n.kr-card .story-block .beat:last-child{margin-bottom:0;}\n.kr-card .timeline{position:relative;padding-left:26px;border-left:2px solid var(--line);}\n.kr-card .tl-item{position:relative;padding-bottom:26px;}\n.kr-card .tl-item:last-child{padding-bottom:0;}\n.kr-card .tl-item::before{content:\"\";position:absolute;left:-32px;top:3px;width:11px;height:11px;border-radius:50%;background:var(--navy-soft);border:2px solid var(--surface);}\n.kr-card .tl-item.turn::before{background:var(--bad);}\n.kr-card .tl-item .when{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:11.5px;color:var(--gold);font-weight:600;}\n.kr-card .tl-item h4{margin:3px 0 4px;font-size:15px;}\n.kr-card .tl-item p{margin:0;font-size:13.5px;color:var(--ink-soft);}\n.kr-card .diff-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}\n@media (max-width:640px){.kr-card .diff-grid{grid-template-columns:1fr;}\n}\n.kr-card .diff{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 18px;box-shadow:var(--shadow);}\n.kr-card .diff .tag{display:inline-block;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;margin-bottom:8px;}\n.kr-card .diff.up .tag{background:var(--bad-bg);color:var(--bad);}\n.kr-card .diff.down .tag{background:var(--good-bg);color:var(--good);}\n.kr-card .diff h4{margin:0 0 6px;font-size:14px;}\n.kr-card .diff p{margin:0;font-size:13px;color:var(--ink-soft);}\n.kr-card .diff .src{display:block;margin-top:8px;font-size:11px;color:var(--ink-faint);}\n.kr-card .chart-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px 22px 14px;box-shadow:var(--shadow);overflow-x:auto;margin-bottom:14px;}\n.kr-card .chart-card svg{display:block;min-width:640px;}\n.kr-card .kpi-note{font-size:13px;color:var(--ink-soft);background:var(--surface-soft);border-radius:10px;padding:12px 16px;margin-bottom:16px;}\n.kr-card .table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface);box-shadow:var(--shadow);}\n.kr-card table{width:100%;border-collapse:collapse;font-size:13px;min-width:620px;}\n.kr-card th, .kr-card td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top;}\n.kr-card thead th{color:var(--ink-faint);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.03em;background:var(--surface-soft);}\n.kr-card tbody tr:last-child td{border-bottom:none;}\n.kr-card .pill{display:inline-block;font-size:11.5px;font-weight:700;padding:3px 10px;border-radius:999px;white-space:nowrap;}\n.kr-card .pill.hit{background:var(--good-bg);color:var(--good);}\n.kr-card .pill.exceed{background:var(--gold-soft);color:var(--gold);}\n.kr-card .unknowns{display:flex;flex-direction:column;gap:10px;}\n.kr-card .unknowns .u{display:flex;gap:10px;padding:12px 16px;background:var(--surface);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);}\n.kr-card .unknowns .u span.q{color:var(--gold);font-weight:700;font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;}\n.kr-card .sources{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:18px 20px;font-size:12.5px;color:var(--ink-soft);box-shadow:var(--shadow);}\n.kr-card .sources h3{font-size:13.5px;margin:0 0 10px;color:var(--ink);}\n.kr-card .sources ul{margin:0;padding-left:18px;}\n.kr-card .sources li{margin-bottom:4px;}\n.kr-card footer{margin-top:50px;padding-top:18px;border-top:1px solid var(--line);font-size:11.5px;color:var(--ink-faint);}\n.kr-card .src{color:var(--ink-faint);}\n</style>\n\n<div class=\"wrap\">\n\n  <div class=\"badge\"><span class=\"dot\"></span>📖 10-K 3개년(FY2023–FY2025) + 어닝콜 8분기(2024 Q3 – 2026 Q2) 기반</div>\n\n  <div class=\"masthead\">\n    <h1>뱅크오브아메리카, 지난 2년의 이야기</h1>\n    <p class=\"sub\">2024년 3분기부터 2026년 2분기까지 — \"영업 레버리지가 돌아온다\"는 약속이 어떻게 지켜졌는가</p>\n  </div>\n\n  <!-- 한 줄 요약 -->\n  <div class=\"onesent\">\n    <div class=\"eyebrow\">한 줄 요약</div>\n    <p>2024년 가을, BAC는 \"2025년 안에 영업 레버리지가 돌아온다\"고 조심스럽게 약속했지만, 2025년 4월 관세 충격으로 잠깐 흔들린 뒤 오히려 그 약속을 훌쩍 뛰어넘어 — 지금은 스스로 세운 목표를 자기 손으로 두 번이나 상향 조정하고 있습니다.</p>\n  </div>\n\n  <!-- 스토리 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">📖</span><h2>스토리</h2></div>\n    <div class=\"story-block\">\n      <div class=\"beat\">\n        <h3>2년 전 — 조심스러운 약속</h3>\n        <p>2024년 10월, 3분기 실적발표에서 브라이언 모이니한 CEO는 <span class=\"fact\">\"4분기 전 우리는 순이자수익(NII)이 2024년 2분기에 바닥을 찍을 것이라 말했고, 그 예측이 맞았다\"</span>고 자평하며, <span class=\"fact\">\"2025년 분기를 지나면서 영업 레버리지로 돌아갈 것으로 기대한다\"</span>고 말했습니다. 당시 목표는 소박했습니다 — 매출 4~5% 성장, 비용 2~3% 성장이라는 알고리즘으로 약 200bp(basis point)의 영업 레버리지를 만들겠다는 것이었죠. 이 시점 회사는 자신감 있었지만 아직 증명은 못 한 상태였습니다.</p>\n      </div>\n      <div class=\"beat\">\n        <h3>그런데 이런 일이 일어났습니다 — 2025년 4월, 관세 충격</h3>\n        <p>약속을 지키기도 전에 변수가 터졌습니다. 2025년 1분기 실적발표(4월)에서 모이니한은 갑자기 어조를 바꿔 <span class=\"fact\">\"시장 변동성과 경제 전망에 대한 우려가 있어, 오늘은 우리 신용 포트폴리오와 자본, 유동성의 질을 과거 경제 위기 시기와 비교해서 보여드리겠다\"</span>며 이례적으로 방어적인 자료를 추가했습니다. CFO 알래스테어 보스윅도 <span class=\"fact\">\"발표된 관세의 불확실성 때문에 향후 NII 전망이 어렵다\"</span>고 인정했습니다. 실제로 2025년 10-K는 이 시기를 <span class=\"fact\">\"2025년 초 경험한 것과 같은 자산가격 충격\"</span>으로 별도 기술하고 있습니다. 같은 문서에서 \"tariff\"(관세) 언급 횟수는 FY2023 10-K의 3회에서 FY2025 10-K의 9회로 3배 늘었습니다.</p>\n      </div>\n      <div class=\"beat\">\n        <h3>회사는 이렇게 대응했습니다 — 조용히, 그리고 빠르게</h3>\n        <p>흥미로운 건 실제 숫자는 그 와중에도 이미 약속을 넘어서고 있었다는 점입니다. 2025년 1월(2024년 4분기 실적발표)에 이미 330bp의 영업 레버리지를 냈다고 밝혔는데, 이는 애초 \"2025년 안에\" 라고 했던 약속을 몇 달 앞당겨 지킨 셈입니다. 관세 충격이 지나간 2025년 7월(2분기 실적발표)에는 어조가 완전히 회복되어 <span class=\"fact\">\"고객들이 무역·관세 변화, 그리고 세법 통과로 이제 명확성을 갖기 시작했다\"</span>고 말했고, NII는 사상 최고치를 기록했습니다. 2025년 10월(3분기)에는 영업 레버리지가 560bp까지 치솟았습니다 — 최초 목표의 거의 3배입니다.</p>\n      </div>\n      <div class=\"beat\">\n        <h3>그래서 지금, 경영진이 보는 미래는 이렇습니다</h3>\n        <p>2026년 1월(2025년 4분기 실적발표), 회사는 다음 해 목표를 다시 \"200bp 이상\"으로 보수적으로 낮춰 잡았습니다 — 전형적인 \"낮게 부르고 초과 달성하기\" 패턴입니다. 그런데 2026년 7월(2분기) 실적발표에서는 상반기에 이미 660bp의 영업 레버리지를 냈다며, 연간 가이던스 자체를 \"200bp 이상\"에서 \"300~400bp\"로 스스로 상향 조정했습니다. 2024년 가을의 조심스러운 약속이, 2년 뒤에는 자신들이 세운 목표를 두 번이나 손수 올려잡는 자신감으로 바뀐 것입니다.</p>\n      </div>\n      <div class=\"beat\">\n        <h3 style=\"color:var(--ink-faint);\">[해석] 제가 보기엔…</h3>\n        <p class=\"interp\">BAC 경영진은 반복적으로 목표를 낮게 제시한 뒤 크게 초과 달성하는 커뮤니케이션 패턴을 보입니다. 이는 신뢰도를 지속적으로 쌓는 전략적 선택으로 보이지만, 동시에 초기 가이던스 자체의 정보 가치가 낮다는 뜻이기도 합니다. 2025년 4월의 관세發 흔들림은 실적에는 거의 흔적을 남기지 못했다는 점에서, 이 회사의 소비자·상업 대출 기반이 매크로 충격에 상당히 탄탄하다는 신호로 읽힙니다. 다만 이 패턴이 앞으로도 계속될지, 아니면 2026년 하반기 어딘가에서 정말로 미달하는 분기가 나올지는 지켜봐야 합니다.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- 타임라인 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">◷</span><h2>타임라인 — 2년의 변곡점</h2></div>\n    <div class=\"timeline\">\n      <div class=\"tl-item\"><span class=\"when\">2024년 10월 · Q3 FY2024</span><h4>영업 레버리지 회복을 처음 약속</h4><p>\"2025년을 지나며 영업 레버리지로 돌아갈 것\" — 목표 약 200bp</p></div>\n      <div class=\"tl-item\"><span class=\"when\">2025년 1월 · Q4 FY2024</span><h4>조기 달성</h4><p>4분기 330bp, 연간 250bp 영업 레버리지 달성 — 약속보다 빠르게</p></div>\n      <div class=\"tl-item turn\"><span class=\"when\">2025년 4월 · Q1 FY2025</span><h4>관세 충격 — 톤 다운</h4><p>시장 변동성·관세 불확실성 언급 급증, 신용/자본 건전성 방어자료 추가 제시</p></div>\n      <div class=\"tl-item\"><span class=\"when\">2025년 7월 · Q2 FY2025</span><h4>확신 회복</h4><p>\"고객들이 관세·세법에 명확성을 갖기 시작\" — NII 사상 최고치</p></div>\n      <div class=\"tl-item\"><span class=\"when\">2025년 10월 · Q3 FY2025</span><h4>대폭 초과 달성</h4><p>영업 레버리지 560bp — 최초 목표의 거의 3배</p></div>\n      <div class=\"tl-item\"><span class=\"when\">2026년 1월 · Q4 FY2025</span><h4>보수적 재설정</h4><p>2026년 가이던스를 다시 \"200bp 이상\"으로 낮춰 제시</p></div>\n      <div class=\"tl-item\"><span class=\"when\">2026년 7월 · Q2 FY2026</span><h4>가이던스 자체 상향</h4><p>상반기 660bp 달성 → 연간 가이던스를 300~400bp로 상향 조정</p></div>\n    </div>\n  </section>\n\n  <!-- 근거1: 공시 문구 변화 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">01</span><h2>근거 1 · 공시 문구에 남은 흔적</h2></div>\n    <p class=\"sec-sub\">10-K FY2023 vs FY2024 vs FY2025, Item 1A Risk Factors 및 Business Overview 비교</p>\n    <div class=\"diff-grid\">\n      <div class=\"diff up\">\n        <span class=\"tag\">🆕 강조 증가</span>\n        <h4>관세(Tariff) 리스크</h4>\n        <p>\"tariff\" 언급 횟수: FY2023 3회 → FY2024 7회 → FY2025 9회. 시장 리스크 섹션에 \"2025년 초 경험한 자산가격 충격\"이라는 구체적 문구가 새로 등장했습니다.</p>\n        <span class=\"src\">출처: 10-K FY2023/FY2024/FY2025, Item 1A</span>\n      </div>\n      <div class=\"diff down\">\n        <span class=\"tag\">❌ 비중 감소</span>\n        <h4>은행 파산 우려</h4>\n        <p>\"bank failures / Silicon Valley Bank\" 언급: FY2023 7회 → FY2025 4회. 2023년 SVB 사태의 기억이 공시에서 서서히 옅어지고 있습니다.</p>\n        <span class=\"src\">출처: 10-K FY2023/FY2025, Item 1A</span>\n      </div>\n      <div class=\"diff up\">\n        <span class=\"tag\">🆕 새로 등장</span>\n        <h4>스테이블코인/디지털자산</h4>\n        <p>\"stablecoin\" 언급: FY2023 1회 → FY2025 3회. 예금 이탈 경로로 스테이블코인이 명시적으로 거론되기 시작했습니다.</p>\n        <span class=\"src\">출처: 10-K FY2023 p.34 / FY2025 Item 1A</span>\n      </div>\n      <div class=\"diff down\">\n        <span class=\"tag\">🔄 구조 변화</span>\n        <h4>지점 수 vs 디지털 사용자</h4>\n        <p>금융센터: FY2021 약 4,200개 → FY2025 약 3,600개(감소). 반대로 디지털 활성 사용자는 FY2021 4,100만 → FY2025 4,900만(증가). 오프라인 축소·온라인 확대가 뚜렷합니다.</p>\n        <span class=\"src\">출처: 10-K FY2021 p.2, FY2023 p.36, FY2025 p.2</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- 근거2: 톤 변화 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">02</span><h2>근거 2 · 어닝콜 톤 변화</h2></div>\n    <div class=\"kpi-note\">이 점수는 정량 지표가 아니라 경영진 발언의 확신 표현·헤지 표현·방어자료 유무를 바탕으로 매긴 정성적 상대 추이입니다.</div>\n    <div class=\"chart-card\">\n      <svg viewBox=\"0 0 700 230\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"분기별 경영진 자신감 점수 추이\">\n        <style>.kr-card .ax{stroke:var(--line);stroke-width:1;}\n.kr-card .axl{font:400 10.5px \"IBM Plex Mono\",monospace;fill:var(--ink-faint);}\n.kr-card .lbl2{font:600 10.5px \"IBM Plex Sans KR\",sans-serif;fill:var(--ink-soft);}\n.kr-card .val2{font:700 12px \"IBM Plex Mono\",monospace;fill:var(--navy);}\n.kr-card .line2{fill:none;stroke:var(--navy-soft);stroke-width:2.5;}\n.kr-card .dot2{fill:var(--navy);}\n.kr-card .dotTurn{fill:var(--bad);}\n</style>\n        <line x1=\"55\" y1=\"15\" x2=\"55\" y2=\"165\" class=\"ax\"/>\n        <line x1=\"55\" y1=\"165\" x2=\"660\" y2=\"165\" class=\"ax\"/>\n        <text x=\"47\" y=\"20\" text-anchor=\"end\" class=\"axl\">10</text>\n        <text x=\"47\" y=\"92\" text-anchor=\"end\" class=\"axl\">5</text>\n        <text x=\"47\" y=\"165\" text-anchor=\"end\" class=\"axl\">0</text>\n        <line x1=\"55\" y1=\"90\" x2=\"660\" y2=\"90\" class=\"ax\" stroke-dasharray=\"3,4\"/>\n\n        <!-- 8 points, score*15 scaled: y = 165 - score*15 -->\n        <!-- Q3FY24:7->60, Q4FY24:8->45, Q1FY25:5->90(turn), Q2FY25:8->45, Q3FY25:9->30, Q4FY25:8->45, Q1FY26:8->45, Q2FY26:9->30 -->\n        <polyline class=\"line2\" points=\"90,60 175,45 260,90 345,45 430,30 515,45 600,45 645,30\"/>\n        <g>\n          <circle cx=\"90\" cy=\"60\" r=\"4\" class=\"dot2\"/><text x=\"90\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\">24 Q3</text><text x=\"90\" y=\"48\" text-anchor=\"middle\" class=\"val2\">7</text>\n          <circle cx=\"175\" cy=\"45\" r=\"4\" class=\"dot2\"/><text x=\"175\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\">24 Q4</text><text x=\"175\" y=\"33\" text-anchor=\"middle\" class=\"val2\">8</text>\n          <circle cx=\"260\" cy=\"90\" r=\"5\" class=\"dotTurn\"/><text x=\"260\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\" fill=\"var(--bad)\">25 Q1</text><text x=\"260\" y=\"78\" text-anchor=\"middle\" class=\"val2\" fill=\"var(--bad)\">5</text>\n          <circle cx=\"345\" cy=\"45\" r=\"4\" class=\"dot2\"/><text x=\"345\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\">25 Q2</text><text x=\"345\" y=\"33\" text-anchor=\"middle\" class=\"val2\">8</text>\n          <circle cx=\"430\" cy=\"30\" r=\"4\" class=\"dot2\"/><text x=\"430\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\">25 Q3</text><text x=\"430\" y=\"18\" text-anchor=\"middle\" class=\"val2\">9</text>\n          <circle cx=\"515\" cy=\"45\" r=\"4\" class=\"dot2\"/><text x=\"515\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\">25 Q4</text><text x=\"515\" y=\"33\" text-anchor=\"middle\" class=\"val2\">8</text>\n          <circle cx=\"600\" cy=\"45\" r=\"4\" class=\"dot2\"/><text x=\"600\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\">26 Q1</text><text x=\"600\" y=\"33\" text-anchor=\"middle\" class=\"val2\">8</text>\n          <circle cx=\"645\" cy=\"30\" r=\"4\" class=\"dot2\"/><text x=\"645\" y=\"185\" text-anchor=\"middle\" class=\"lbl2\" style=\"display:none\"></text>\n        </g>\n        <text x=\"430\" y=\"205\" text-anchor=\"middle\" class=\"axl\" fill=\"var(--bad)\">▲ 2025 Q1 = 관세 충격으로 톤 다운</text>\n      </svg>\n    </div>\n    <p class=\"sec-sub\" style=\"margin:0;\">근거: 24Q3 \"expect to return\"(기대 표현) · 24Q4 \"we created operating leverage\"(달성 확언) · 25Q1 \"given market volatility... uncertainty\"(방어 자료 추가) · 25Q2 \"clients see clarity\"(명확성 회복) · 25Q3 \"560bps\"(자신감 정점) · 25Q4 \"conservative 2026 guide\"(신중한 재설정) · 26Q1 \"consistent with prior guidance\"(재확인) · 26Q2 \"we now expect... 300–400bps\"(가이던스 상향)</p>\n  </section>\n\n  <!-- 근거3: 가이던스 성적표 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">03</span><h2>근거 3 · 가이던스 성적표</h2></div>\n    <div class=\"table-wrap\">\n      <table>\n        <thead><tr><th>약속한 시점</th><th>약속한 것</th><th>실제 결과</th><th>판정</th></tr></thead>\n        <tbody>\n          <tr>\n            <td class=\"tnum\">Q3 FY2024<br><span class=\"src\">2024-10</span></td>\n            <td>2025년 중 영업 레버리지 회복, 목표 약 200bp</td>\n            <td>Q4 FY2024에 이미 330bp 달성 (연간 250bp)</td>\n            <td><span class=\"pill exceed\">조기·초과 달성</span></td>\n          </tr>\n          <tr>\n            <td class=\"tnum\">Q1 FY2025<br><span class=\"src\">2025-04</span></td>\n            <td>관세 불확실성 속에서도 신용·자본 건전성 유지</td>\n            <td>Q2 FY2025 순charge-off 안정, NII 사상 최고치 경신</td>\n            <td><span class=\"pill hit\">약속 이행</span></td>\n          </tr>\n          <tr>\n            <td class=\"tnum\">Q4 FY2025<br><span class=\"src\">2026-01</span></td>\n            <td>2026년 영업 레버리지 200bp 이상 (보수적 가이던스)</td>\n            <td>Q1 FY2026 290bp, Q2 FY2026 660bp</td>\n            <td><span class=\"pill exceed\">대폭 초과</span></td>\n          </tr>\n          <tr>\n            <td class=\"tnum\">Q1 FY2026<br><span class=\"src\">2026-04</span></td>\n            <td>연간 200bp 이상 가이던스 재확인</td>\n            <td>Q2 FY2026 실적 발표 시 300~400bp로 가이던스 자체를 상향</td>\n            <td><span class=\"pill exceed\">가이던스 상향</span></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n    <p class=\"sec-sub\" style=\"margin-top:10px;\">달성률: 4개 중 4개 이행 (100%) — 패턴: 매 분기 보수적으로 제시한 뒤 초과 달성하는 \"낮게 부르고 넘기기(sandbagging)\" 스타일이 8분기 내내 일관되게 반복됩니다.</p>\n  </section>\n\n  <!-- 모르는 것 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">❓</span><h2>아직 모르는 것</h2></div>\n    <div class=\"unknowns\">\n      <div class=\"u\"><span class=\"q\">Q.</span><span>이 \"낮게 부르고 초과 달성\" 패턴이 2026년 하반기 이후에도 계속될지, 아니면 진짜 미달 분기가 나올지는 다음 분기 실적을 봐야 압니다.</span></div>\n      <div class=\"u\"><span class=\"q\">Q.</span><span>상업용 부동산(오피스) 익스포저의 실제 손실 규모가 얼마나 더 남았는지는 이 자료만으로는 알 수 없습니다 — Note 4 신용품질 세부 데이터를 더 깊이 봐야 합니다.</span></div>\n      <div class=\"u\"><span class=\"q\">Q.</span><span>관세 정책이 재차 격화될 경우 2025년 4월과 같은 톤 다운이 다시 나타날지, 아니면 회사가 이제 더 잘 대비돼 있는지는 다음 정책 이벤트가 지나봐야 확인됩니다.</span></div>\n    </div>\n  </section>\n\n  <!-- 자료 목록 -->\n  <section>\n    <div class=\"sources\">\n      <h3>📎 사용한 자료 전체 목록</h3>\n      <ul>\n        <li>10-K FY2021, FY2023, FY2024, FY2025 (연간보고서 4개년)</li>\n        <li>어닝콜 트랜스크립트: Q3 FY2024, Q4 FY2024, Q1 FY2025, Q2 FY2025, Q3 FY2025, Q4 FY2025, Q1 FY2026, Q2 FY2026 (8분기, roic.ai)</li>\n        <li>DEF 14A 2026 (참고용, 경영진 정보)</li>\n      </ul>\n    </div>\n  </section>\n\n  <footer>\n    ⚠️ 이 스토리는 SEC 공시자료와 어닝콜 트랜스크립트를 1차 소스로 사용했습니다. 톤 점수는 정성적 판단이며 정량 지표가 아닙니다. 투자 판단은 본인 책임이며, 이 카드는 투자 자문이 아닙니다.\n  </footer>\n\n</div></div>","scripts":[],"ext":[],"lede":""}
{"html":"<div class=\"kr-card\"><style>.kr-card{\n    --bg:#faf9f6;\n    --surface:#ffffff;\n    --surface-2:#f2f1ec;\n    --border:#e2e0d6;\n    --text:#181a16;\n    --text-muted:#6b6a5f;\n    --accent:#1c4e8a;\n    --accent-soft:#e9f0f9;\n    --accent-strong:#123a68;\n    --warn:#9a3412;\n    --warn-soft:#fbeee6;\n    --good:#1c6b3f;\n    --good-soft:#e9f5ee;\n    --mono: 'IBM Plex Mono', ui-monospace, monospace;\n    --sans: 'IBM Plex Sans KR','IBM Plex Sans', 'Pretendard', -apple-system, sans-serif;\n  }\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n      --bg:#14161a;\n      --surface:#1b1e23;\n      --surface-2:#20242a;\n      --border:#31353c;\n      --text:#e9e8e3;\n      --text-muted:#9a9c97;\n      --accent:#6ba0e0;\n      --accent-soft:#1c2b3d;\n      --accent-strong:#8fbaea;\n      --warn:#e2a07a;\n      --warn-soft:#2c1c14;\n      --good:#7fc79a;\n      --good-soft:#16261c;\n    }\n}\n:root[data-theme=\"dark\"] .kr-card{\n    --bg:#14161a;\n    --surface:#1b1e23;\n    --surface-2:#20242a;\n    --border:#31353c;\n    --text:#e9e8e3;\n    --text-muted:#9a9c97;\n    --accent:#6ba0e0;\n    --accent-soft:#1c2b3d;\n    --accent-strong:#8fbaea;\n    --warn:#e2a07a;\n    --warn-soft:#2c1c14;\n    --good:#7fc79a;\n    --good-soft:#16261c;\n  }\n.kr-card *{box-sizing:border-box;}\n.kr-card{\n    background:var(--bg);\n    color:var(--text);\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;\n    margin:0;\n    padding:0 20px 80px;\n    line-height:1.62;\n  }\n.kr-card .wrap{max-width:840px;margin:0 auto;}\n.kr-card .eyebrow{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;\n    font-size:12px;\n    letter-spacing:.06em;\n    color:var(--text-muted);\n    text-transform:uppercase;\n  }\n.kr-card header.hero{\n    padding:44px 0 28px;\n    border-bottom:1px solid var(--border);\n  }\n.kr-card .badge{\n    display:inline-flex;align-items:center;gap:6px;\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;\n    font-size:12px;\n    padding:5px 10px;\n    border-radius:999px;\n    background:var(--accent-soft);\n    color:var(--accent-strong);\n    border:1px solid var(--border);\n    margin-bottom:18px;\n  }\n.kr-card h1.company{\n    font-size:34px;\n    font-weight:700;\n    letter-spacing:-0.015em;\n    text-wrap:balance;\n    margin:0 0 4px;\n  }\n.kr-card .ticker-line{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;\n    color:var(--text-muted);\n    font-size:14px;\n    margin-bottom:22px;\n  }\n.kr-card .stat-row{\n    display:grid;\n    grid-template-columns:repeat(4,1fr);\n    gap:1px;\n    background:var(--border);\n    border:1px solid var(--border);\n    border-radius:10px;\n    overflow:hidden;\n  }\n.kr-card .stat{\n    background:var(--surface);\n    padding:12px 14px;\n  }\n.kr-card .stat .k{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:10.5px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;}\n.kr-card .stat .v{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:17px;font-weight:600;margin-top:3px;font-variant-numeric:tabular-nums;}\n.kr-card .stat-note{font-size:11.5px;color:var(--text-muted);margin-top:8px;}\n.kr-card section{padding:40px 0;border-bottom:1px solid var(--border);}\n.kr-card section:last-of-type{border-bottom:none;}\n.kr-card .sec-head{display:flex;align-items:baseline;gap:12px;margin-bottom:20px;}\n.kr-card .sec-num{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:13px;color:var(--accent);border:1px solid var(--accent);border-radius:6px;padding:2px 7px;flex-shrink:0;}\n.kr-card .sec-title{font-size:14px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;}\n.kr-card .drill{\n    background:var(--accent-soft);\n    border:1px solid var(--border);\n    border-radius:14px;\n    padding:32px 30px;\n  }\n.kr-card .drill p{\n    font-size:23px;\n    font-weight:600;\n    line-height:1.5;\n    margin:0;\n    text-wrap:balance;\n    color:var(--text);\n  }\n.kr-card .drill .cite{margin-top:16px;font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:11.5px;color:var(--text-muted);}\n.kr-card p{margin:0 0 14px;font-size:15.5px;}\n.kr-card .lede{color:var(--text-muted);font-size:14.5px;margin-bottom:22px;}\n.kr-card .diagram-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:24px 20px;}\n.kr-card .diagram-card svg{width:100%;height:auto;display:block;}\n.kr-card table{width:100%;border-collapse:collapse;font-size:14px;}\n.kr-card th, .kr-card td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--border);}\n.kr-card th{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:11px;text-transform:uppercase;color:var(--text-muted);font-weight:500;letter-spacing:.03em;}\n.kr-card td.num, .kr-card th.num{text-align:right;font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-variant-numeric:tabular-nums;}\n.kr-card .pos{color:var(--good);}\n.kr-card .neg{color:var(--warn);}\n.kr-card .tbl-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:10px;background:var(--surface);}\n.kr-card .tbl-wrap table{min-width:520px;}\n.kr-card .bar-block{margin-bottom:22px;}\n.kr-card .bar-block:last-child{margin-bottom:0;}\n.kr-card .bar-label{display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px;}\n.kr-card .bar-label .yr{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;color:var(--text-muted);}\n.kr-card .stackbar{display:flex;height:26px;border-radius:6px;overflow:hidden;border:1px solid var(--border);}\n.kr-card .stackbar div{display:flex;align-items:center;justify-content:center;font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:11px;color:#fff;white-space:nowrap;overflow:hidden;}\n.kr-card .seg-1{background:var(--accent);}\n.kr-card .seg-2{background:#6f95bd;}\n.kr-card .seg-3{background:#b7c7d9;color:var(--text) !important;}\n.kr-card .legend{display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;font-size:12.5px;color:var(--text-muted);}\n.kr-card .legend span{display:inline-flex;align-items:center;gap:6px;}\n.kr-card .dot{width:9px;height:9px;border-radius:2px;display:inline-block;}\n.kr-card .two-col{display:grid;grid-template-columns:1fr 1fr;gap:28px;}\n@media (max-width:640px){.kr-card .two-col{grid-template-columns:1fr;}\n}\n.kr-card .hbar-row{display:grid;grid-template-columns:110px 1fr 56px;align-items:center;gap:10px;margin-bottom:10px;font-size:13px;}\n.kr-card .hbar-row .lbl{color:var(--text-muted);}\n.kr-card .hbar-track{background:var(--surface-2);border-radius:5px;height:14px;overflow:hidden;}\n.kr-card .hbar-fill{height:100%;background:var(--accent);border-radius:5px;}\n.kr-card .hbar-val{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;text-align:right;font-variant-numeric:tabular-nums;}\n.kr-card .callout{border-radius:10px;padding:16px 18px;font-size:14px;margin-top:6px;}\n.kr-card .callout.note{background:var(--surface-2);border:1px solid var(--border);color:var(--text-muted);}\n.kr-card .callout.warn{background:var(--warn-soft);border:1px solid var(--warn);color:var(--warn);font-weight:500;}\n.kr-card .card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}\n@media (max-width:640px){.kr-card .card-grid{grid-template-columns:1fr;}\n}\n.kr-card .mini-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;}\n.kr-card .mini-card .t{font-weight:600;font-size:14.5px;margin-bottom:6px;}\n.kr-card .mini-card .d{font-size:13px;color:var(--text-muted);}\n.kr-card .risk-item{display:flex;gap:14px;padding:16px 0;border-top:1px solid var(--border);}\n.kr-card .risk-item:first-of-type{border-top:none;}\n.kr-card .risk-num{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:13px;color:var(--warn);flex-shrink:0;width:20px;}\n.kr-card .risk-body .t{font-weight:600;font-size:14.5px;margin-bottom:4px;}\n.kr-card .risk-body .d{font-size:13.5px;color:var(--text-muted);}\n.kr-card .cite-inline{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:11px;color:var(--text-muted);}\n.kr-card .scenario{\n    font-size:18px;font-weight:600;line-height:1.55;\n    background:var(--warn-soft);border:1px solid var(--warn);color:var(--warn);\n    border-radius:12px;padding:22px 24px;margin-bottom:26px;text-wrap:balance;\n  }\n.kr-card .kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:24px;}\n.kr-card .kpi-num{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:32px;font-weight:600;color:var(--accent);}\n.kr-card .kpi-sub{font-size:13px;color:var(--text-muted);margin-top:2px;}\n.kr-card .kpi-why{font-size:13.5px;color:var(--text-muted);margin-top:14px;padding-top:14px;border-top:1px dashed var(--border);}\n.kr-card .fin-chart{display:grid;grid-template-columns:44px 1fr;gap:8px;align-items:end;height:150px;margin:22px 0 6px;}\n.kr-card .fin-yaxis{display:flex;flex-direction:column;justify-content:space-between;font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:10px;color:var(--text-muted);height:150px;text-align:right;}\n.kr-card .fin-bars{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;align-items:end;height:150px;border-left:1px solid var(--border);border-bottom:1px solid var(--border);padding-left:6px;}\n.kr-card .fin-col{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:4px;}\n.kr-card .fin-bar-wrap{display:flex;align-items:flex-end;gap:3px;height:100%;width:100%;justify-content:center;}\n.kr-card .fin-bar{width:9px;border-radius:2px 2px 0 0;}\n.kr-card .fin-bar.rev{background:var(--accent);}\n.kr-card .fin-bar.op{background:#6f95bd;}\n.kr-card .fin-bar.fcf{background:var(--good);}\n.kr-card .fin-col .yl{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:10.5px;color:var(--text-muted);margin-top:2px;}\n.kr-card .founders{display:flex;gap:16px;flex-wrap:wrap;margin-top:16px;}\n.kr-card .founder{flex:1;min-width:220px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;}\n.kr-card .founder .role{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;font-size:11px;color:var(--accent);text-transform:uppercase;letter-spacing:.03em;}\n.kr-card .founder .name{font-weight:600;font-size:16px;margin:4px 0 6px;}\n.kr-card .founder .d{font-size:13px;color:var(--text-muted);}\n.kr-card ul.plain{margin:0;padding-left:0;list-style:none;}\n.kr-card ul.plain li{position:relative;padding-left:20px;margin-bottom:10px;font-size:14.5px;}\n.kr-card ul.plain li::before{content:\"•\";position:absolute;left:2px;color:var(--accent);}\n.kr-card footer{padding:32px 0 10px;font-size:12px;color:var(--text-muted);}\n.kr-card footer .src{margin-top:10px;line-height:1.8;}\n.kr-card footer a{color:var(--text-muted);}\n.kr-card .unknowns li{margin-bottom:14px;}\n.kr-card .unknowns .q{font-weight:600;font-size:14.5px;}\n.kr-card .unknowns .a{font-size:13.5px;color:var(--text-muted);margin-top:3px;}\n</style>\n\n<div class=\"wrap\">\n\n<header class=\"hero\">\n  <div class=\"badge\">📄 10-K FY2025(2026-02-17 제출) 등 공시자료 기반 · 페이지 출처 명시</div>\n  <h1 class=\"company\">아리스타 네트웍스 (Arista Networks, Inc.)</h1>\n  <div class=\"ticker-line\">NYSE: ANET · CIK 0001596532 · 회계연도 12월 결산 · 본사 캘리포니아 산타클라라</div>\n  <div class=\"stat-row\">\n    <div class=\"stat\"><div class=\"k\">주가</div><div class=\"v\">$195.69</div></div>\n    <div class=\"stat\"><div class=\"k\">시가총액</div><div class=\"v\">$246.8B</div></div>\n    <div class=\"stat\"><div class=\"k\">P/E</div><div class=\"v\">61.9x</div></div>\n    <div class=\"stat\"><div class=\"k\">52주 범위</div><div class=\"v\" style=\"font-size:14px;\">$114.5–$214.9</div></div>\n  </div>\n  <div class=\"stat-note\">📡 주가 정보는 웹검색 기반 (2026-08-31 종가, 출처: stockanalysis.com) · 그 외 사업·재무 수치는 업로드된 SEC 공시자료(10-K/10-Q/DEF 14A) 기반, 페이지 명시</div>\n</header>\n\n<!-- 01 2분 드릴 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">01</span><span class=\"sec-title\">2분 드릴 — 한 문장 요약</span></div>\n  <div class=\"drill\">\n    <p>아리스타네트웍스는 구글·메타·마이크로소프트 같은 회사들의 데이터센터에서 컴퓨터 수만 대가 서로 데이터를 주고받게 해주는 &lsquo;초고속 교통정리 장비(네트워크 스위치)&rsquo;를 만들어 팔고, 그 장비를 계속 관리해주는 대가로 매년 유지보수 구독료도 받는 회사입니다.</p>\n    <div class=\"cite\">출처: 10-K FY2025, Item 1 Business, p.7–8</div>\n  </div>\n</section>\n\n<!-- 02 돈버는 구조 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">02</span><span class=\"sec-title\">돈 버는 구조</span></div>\n  <div class=\"diagram-card\">\n    <svg viewBox=\"0 0 760 400\" xmlns=\"http://www.w3.org/2000/svg\" font-family=\"'IBM Plex Sans KR','IBM Plex Sans',sans-serif\">\n      <defs>\n        <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n          <path d=\"M0,0 L10,5 L0,10 z\" fill=\"var(--text-muted)\"/>\n        </marker>\n      </defs>\n      <!-- suppliers -->\n      <rect x=\"10\" y=\"20\" width=\"200\" height=\"58\" rx=\"9\" fill=\"var(--surface-2)\" stroke=\"var(--border)\"/>\n      <text x=\"110\" y=\"42\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--text-muted)\">부품 공급</text>\n      <text x=\"110\" y=\"62\" text-anchor=\"middle\" font-size=\"13.5\" font-weight=\"600\" fill=\"var(--text)\">브로드컴 (스위칭 칩)</text>\n\n      <rect x=\"10\" y=\"92\" width=\"200\" height=\"58\" rx=\"9\" fill=\"var(--surface-2)\" stroke=\"var(--border)\"/>\n      <text x=\"110\" y=\"114\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--text-muted)\">위탁 생산</text>\n      <text x=\"110\" y=\"134\" text-anchor=\"middle\" font-size=\"13.5\" font-weight=\"600\" fill=\"var(--text)\">Jabil · Sanmina · Foxconn</text>\n\n      <!-- arrows to center -->\n      <line x1=\"210\" y1=\"49\" x2=\"278\" y2=\"90\" stroke=\"var(--text-muted)\" stroke-width=\"1.4\" marker-end=\"url(#arrow)\"/>\n      <line x1=\"210\" y1=\"121\" x2=\"278\" y2=\"110\" stroke=\"var(--text-muted)\" stroke-width=\"1.4\" marker-end=\"url(#arrow)\"/>\n\n      <!-- Arista core -->\n      <rect x=\"280\" y=\"55\" width=\"200\" height=\"90\" rx=\"10\" fill=\"var(--accent)\" />\n      <text x=\"380\" y=\"90\" text-anchor=\"middle\" font-size=\"14\" fill=\"#fff\" opacity=\"0.85\">아리스타</text>\n      <text x=\"380\" y=\"112\" text-anchor=\"middle\" font-size=\"14.5\" font-weight=\"700\" fill=\"#fff\">EOS 소프트웨어</text>\n      <text x=\"380\" y=\"130\" text-anchor=\"middle\" font-size=\"14.5\" font-weight=\"700\" fill=\"#fff\">+ 스위치 하드웨어 설계</text>\n\n      <!-- arrows to customers -->\n      <line x1=\"480\" y1=\"80\" x2=\"548\" y2=\"30\" stroke=\"var(--text-muted)\" stroke-width=\"1.4\" marker-end=\"url(#arrow)\"/>\n      <line x1=\"480\" y1=\"100\" x2=\"548\" y2=\"100\" stroke=\"var(--text-muted)\" stroke-width=\"1.4\" marker-end=\"url(#arrow)\"/>\n      <line x1=\"480\" y1=\"120\" x2=\"548\" y2=\"170\" stroke=\"var(--text-muted)\" stroke-width=\"1.4\" marker-end=\"url(#arrow)\"/>\n\n      <!-- customers -->\n      <rect x=\"550\" y=\"6\" width=\"200\" height=\"48\" rx=\"9\" fill=\"var(--surface)\" stroke=\"var(--accent)\"/>\n      <text x=\"650\" y=\"24\" text-anchor=\"middle\" font-size=\"12.5\" font-weight=\"600\" fill=\"var(--text)\">클라우드·AI 대기업</text>\n      <text x=\"650\" y=\"42\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--accent)\">매출의 48%</text>\n\n      <rect x=\"550\" y=\"76\" width=\"200\" height=\"48\" rx=\"9\" fill=\"var(--surface)\" stroke=\"var(--accent)\"/>\n      <text x=\"650\" y=\"94\" text-anchor=\"middle\" font-size=\"12.5\" font-weight=\"600\" fill=\"var(--text)\">일반 기업 고객</text>\n      <text x=\"650\" y=\"112\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--accent)\">매출의 32%</text>\n\n      <rect x=\"550\" y=\"146\" width=\"200\" height=\"48\" rx=\"9\" fill=\"var(--surface)\" stroke=\"var(--accent)\"/>\n      <text x=\"650\" y=\"164\" text-anchor=\"middle\" font-size=\"12.5\" font-weight=\"600\" fill=\"var(--text)\">AI·특수 통신사업자</text>\n      <text x=\"650\" y=\"182\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--accent)\">매출의 20%</text>\n\n      <!-- money flow back -->\n      <path d=\"M 650 200 C 650 260, 380 260, 380 165\" fill=\"none\" stroke=\"var(--good)\" stroke-width=\"1.6\" stroke-dasharray=\"4 3\" marker-end=\"url(#arrow)\"/>\n      <rect x=\"255\" y=\"270\" width=\"250\" height=\"66\" rx=\"9\" fill=\"var(--good-soft)\" stroke=\"var(--good)\"/>\n      <text x=\"380\" y=\"292\" text-anchor=\"middle\" font-size=\"12.5\" font-weight=\"600\" fill=\"var(--good)\">돈은 이렇게 들어온다</text>\n      <text x=\"380\" y=\"312\" text-anchor=\"middle\" font-size=\"12\" fill=\"var(--text)\">장비 판매 84% + 유지보수 구독 16%</text>\n      <text x=\"380\" y=\"328\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--text-muted)\">설치 기반이 늘수록 구독매출도 같이 커짐</text>\n\n      <text x=\"380\" y=\"375\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--text-muted)\">단일 사업부문 · 고객·제품 비중은 FY2025 기준</text>\n    </svg>\n  </div>\n  <p class=\"lede\" style=\"margin-top:14px;\">출처: 10-K FY2025, Item 1 Business (제조·공급망) p.8, Item 7 MD&amp;A(매출 구성) p.52. 제품군 기준으로는 Core(AI·클라우드·데이터센터) 65% / Cognitive Adjacencies(캠퍼스·라우팅) 18% / 소프트웨어·서비스 17%.</p>\n</section>\n\n<!-- 03 매출구성 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">03</span><span class=\"sec-title\">매출 구성 — 두 축으로</span></div>\n  <p class=\"lede\">아리스타는 회계상 <strong>단일 사업부문</strong>으로 보고합니다(10-K p.93). 그래서 &lsquo;사업부문별&rsquo; 대신 <strong>고객유형별</strong> 비중을 함께 봅니다.</p>\n\n  <div class=\"two-col\">\n    <div>\n      <div style=\"font-weight:600;margin-bottom:12px;\">고객유형별 (FY2025)</div>\n      <div class=\"stackbar\" style=\"margin-bottom:10px;\">\n        <div class=\"seg-1\" style=\"width:48%;\">48%</div>\n        <div class=\"seg-2\" style=\"width:32%;\">32%</div>\n        <div class=\"seg-3\" style=\"width:20%;\">20%</div>\n      </div>\n      <div class=\"legend\">\n        <span><i class=\"dot\" style=\"background:var(--accent);\"></i>클라우드·AI 대기업</span>\n        <span><i class=\"dot\" style=\"background:#6f95bd;\"></i>일반 기업</span>\n        <span><i class=\"dot\" style=\"background:#b7c7d9;\"></i>AI·특수 사업자</span>\n      </div>\n      <div class=\"cite-inline\" style=\"margin-top:10px;\">출처: 10-K FY2025, p.52</div>\n    </div>\n    <div>\n      <div style=\"font-weight:600;margin-bottom:12px;\">지역별 (FY2025, 총 $9,005.7M)</div>\n      <div class=\"hbar-row\"><div class=\"lbl\">미주(Americas)</div><div class=\"hbar-track\"><div class=\"hbar-fill\" style=\"width:79.1%;\"></div></div><div class=\"hbar-val\">79.1%</div></div>\n      <div class=\"hbar-row\"><div class=\"lbl\">유럽·중동·아프리카</div><div class=\"hbar-track\"><div class=\"hbar-fill\" style=\"width:11.9%;\"></div></div><div class=\"hbar-val\">11.9%</div></div>\n      <div class=\"hbar-row\"><div class=\"lbl\">아시아태평양</div><div class=\"hbar-track\"><div class=\"hbar-fill\" style=\"width:9.0%;\"></div></div><div class=\"hbar-val\">9.0%</div></div>\n      <div class=\"cite-inline\" style=\"margin-top:6px;\">출처: 10-K FY2025, p.54</div>\n    </div>\n  </div>\n\n  <div class=\"callout note\" style=\"margin-top:20px;\">해외(미주 外) 비중이 FY2024 18.2% → FY2025 20.9%로 늘고 있습니다(p.54). 계약이 대부분 미 달러화라 환위험은 제한적이지만, 관세·수출규제 같은 지정학 리스크 노출은 커지는 방향입니다.</div>\n</section>\n\n<!-- 04 고객 & 경쟁사 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">04</span><span class=\"sec-title\">고객 &amp; 경쟁사</span></div>\n\n  <div style=\"font-weight:600;margin-bottom:10px;\">고객 집중도 — 상위 2개 고객이 매출의 42%</div>\n  <p>B2B 판매 구조이며 소수 초대형 고객 의존도가 매우 높습니다. 2025년, 2024년, 2023년 각각 두 고객이 매출의 10%를 넘었습니다(p.52).</p>\n  <div class=\"bar-block\">\n    <div class=\"bar-label\"><span>2023</span><span class=\"yr\">21% + 18% = 39%</span></div>\n    <div class=\"stackbar\"><div class=\"seg-1\" style=\"width:21%;\">21%</div><div class=\"seg-2\" style=\"width:18%;\">18%</div></div>\n  </div>\n  <div class=\"bar-block\">\n    <div class=\"bar-label\"><span>2024</span><span class=\"yr\">15% + 20% = 35%</span></div>\n    <div class=\"stackbar\"><div class=\"seg-1\" style=\"width:15%;\">15%</div><div class=\"seg-2\" style=\"width:20%;\">20%</div></div>\n  </div>\n  <div class=\"bar-block\">\n    <div class=\"bar-label\"><span>2025</span><span class=\"yr\">16% + 26% = 42%</span></div>\n    <div class=\"stackbar\"><div class=\"seg-1\" style=\"width:16%;\">16%</div><div class=\"seg-2\" style=\"width:26%;\">26%</div></div>\n  </div>\n  <div class=\"cite-inline\">출처: 10-K FY2025, p.52. 두 고객의 실명은 FY2025 10-K에는 없지만, FY2024 10-K는 이 두 고객을 Meta Platforms와 Microsoft로 명시했습니다(10-K FY2024, p.2).</div>\n\n  <div style=\"font-weight:600;margin:28px 0 10px;\">경쟁사</div>\n  <div class=\"card-grid\">\n    <div class=\"mini-card\">\n      <div class=\"t\">Cisco Systems</div>\n      <div class=\"d\">데이터센터·캠퍼스 네트워킹의 전통 최강자. 완제품 통합 판매로 아리스타의 개방형·소프트웨어 중심 전략과 대비됩니다.</div>\n    </div>\n    <div class=\"mini-card\">\n      <div class=\"t\">Nvidia</div>\n      <div class=\"d\">AI 서버 내부 연결에서 자사 NVLink·인피니밴드로 이더넷(아리스타 영역)을 잠식하려 합니다. GPU와 묶어 파는 수직 결합이 위협 요인입니다.</div>\n    </div>\n    <div class=\"mini-card\">\n      <div class=\"t\">화이트박스 벤더 · 고객 자체설계</div>\n      <div class=\"d\">오픈소스 OS 기반 저가 장비 벤더들과, 클라우드·AI 대기업이 직접 스위치를 설계해버리는 &lsquo;자체 제작&rsquo; 흐름이 함께 위협합니다.</div>\n    </div>\n  </div>\n  <div class=\"cite-inline\" style=\"margin-top:10px;\">출처: 10-K FY2025, Item 1 Business(Competition), p.8</div>\n</section>\n\n<!-- 05 KPI -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">05</span><span class=\"sec-title\">이 업종의 핵심 KPI</span></div>\n  <div class=\"kpi-card\">\n    <div class=\"eyebrow\">이연수익(계약부채) — 아직 매출로 안 잡은 선수금</div>\n    <div class=\"kpi-num\" style=\"margin-top:8px;\">$5,372.4M</div>\n    <div class=\"kpi-sub\">FY2025 총 이연수익 (유동 $4,002.6M + 비유동 $1,369.8M)</div>\n\n    <div style=\"margin-top:20px;\">\n      <div class=\"hbar-row\"><div class=\"lbl\">FY2023</div><div class=\"hbar-track\"><div class=\"hbar-fill\" style=\"width:28.0%;background:#b7c7d9;\"></div></div><div class=\"hbar-val\">$1,506M</div></div>\n      <div class=\"hbar-row\"><div class=\"lbl\">FY2024</div><div class=\"hbar-track\"><div class=\"hbar-fill\" style=\"width:52.0%;background:#6f95bd;\"></div></div><div class=\"hbar-val\">$2,791M</div></div>\n      <div class=\"hbar-row\"><div class=\"lbl\">FY2025</div><div class=\"hbar-track\"><div class=\"hbar-fill\" style=\"width:100%;\"></div></div><div class=\"hbar-val\">$5,372M</div></div>\n    </div>\n    <div class=\"legend\"><span>전년 대비 +85%(2024) → +93%(2025) 증가</span></div>\n\n    <div class=\"kpi-why\">고객이 미리 계약·선결제했지만 아직 매출로 인식하지 않은 금액입니다. 이 금액이 매출 증가 속도보다 더 빨리 불어난다는 건, 앞으로 인식될 주문이 이미 쌓여있다는 뜻이라 <strong>수요의 선행지표</strong>로 봅니다. 반대로 이 증가세가 꺾이면 향후 매출 둔화의 조기 경고가 될 수 있습니다.</div>\n    <div class=\"cite-inline\" style=\"margin-top:10px;\">출처: 10-K FY2025 대차대조표 p.68, 10-K FY2024 대차대조표 p.동일 항목(비교연도)</div>\n  </div>\n</section>\n\n<!-- 06 경영진 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">06</span><span class=\"sec-title\">경영진 &amp; 오너십</span></div>\n  <div class=\"founders\">\n    <div class=\"founder\">\n      <div class=\"role\">CEO · 이사회 의장</div>\n      <div class=\"name\">제이쉬리 울랄 (Jayshree Ullal)</div>\n      <div class=\"d\">2008년 10월 취임, 18년째 CEO 재직 (2023년 12월부터 의장 겸임). 이전 Cisco에서 데이터센터·스위칭 사업 수석부사장 역임. 지분 2.3% 보유.</div>\n    </div>\n    <div class=\"founder\">\n      <div class=\"role\">공동창업자 · 최대주주</div>\n      <div class=\"name\">앤디 벡톨샤임 (Andy Bechtolsheim)</div>\n      <div class=\"d\">현직 최고개발책임자(Chief Development Officer)로 경영에 계속 관여 중이며, Bechtolsheim Family Trust를 통해 지분 14.6%(약 1억 8,380만 주)로 최대주주입니다.</div>\n    </div>\n  </div>\n  <p style=\"margin-top:16px;\">그 외 기관 중에는 블랙록이 5.9%를 보유하고 있습니다. 창업자가 현직 임원으로 남아있고 지분율도 가장 높다는 점은 장기 관여 신호로 볼 수 있습니다.</p>\n  <div class=\"cite-inline\">출처: DEF 14A (2026년 4월 16일 제출), 5% 이상 주주 및 이사·경영진 지분 표, 이사 약력</div>\n</section>\n\n<!-- 07 주주환원 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">07</span><span class=\"sec-title\">주주환원</span></div>\n  <div class=\"two-col\">\n    <div class=\"mini-card\">\n      <div class=\"t\">배당</div>\n      <div class=\"d\">배당 없음. 과거에도 지급한 적이 없고, 향후에도 지급 계획이 없다고 명시하고 있습니다(10-K p.46).</div>\n    </div>\n    <div class=\"mini-card\">\n      <div class=\"t\">자사주 매입</div>\n      <div class=\"d\">FY2025 $1,603.1M(1,590만 주, 평균 $100.63) / FY2024 $423.6M(550만 주, 평균 $77.13) 매입. 2025년 5월 신규 $15억 매입 프로그램을 승인했습니다(10-K p.50, p.87).</div>\n    </div>\n  </div>\n  <div class=\"callout note\" style=\"margin-top:16px;\">발행주식수가 FY2024 말 12억 6,130만 주 → FY2025 말 12억 5,650만 주로 <strong>실제로 줄었습니다</strong>. 스톡보상으로 새로 찍어내는 주식보다 매입해서 없애는 주식이 더 많다는 뜻으로, 형식적인 환원이 아니라 실질적으로 효과가 있는 자사주 매입입니다.</div>\n</section>\n\n<!-- 08 시나리오 & 리스크 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">08</span><span class=\"sec-title\">이 회사가 망하는 시나리오</span></div>\n  <div class=\"scenario\">클라우드·AI 대기업 고객 몇 곳이 자체 칩과 스위치를 설계해 아리스타를 건너뛰기로 결정하는 순간, 매출의 절반 가까이가 한꺼번에 흔들리는 회사입니다.</div>\n\n  <div class=\"risk-item\">\n    <div class=\"risk-num\">01</div>\n    <div class=\"risk-body\">\n      <div class=\"t\">고객 집중 리스크</div>\n      <div class=\"d\">단 2개 고객이 FY2025 매출의 42%를 차지합니다. 이 고객들의 발주 시점이나 설비투자 계획이 바뀌는 것만으로 분기 실적이 크게 출렁일 수 있습니다. <span class=\"cite-inline\">(10-K p.52)</span></div>\n    </div>\n  </div>\n  <div class=\"risk-item\">\n    <div class=\"risk-num\">02</div>\n    <div class=\"risk-body\">\n      <div class=\"t\">경쟁 &amp; 자체설계 리스크</div>\n      <div class=\"d\">Cisco·Huawei·HPE(Juniper 인수) 같은 전통 강자, 화이트박스 벤더, Nvidia의 자체 AI 연결기술까지 사방에서 경쟁합니다. 특히 초대형 고객이 직접 칩·스위치를 설계하면 아리스타를 아예 건너뛸 수 있습니다. <span class=\"cite-inline\">(10-K p.8)</span></div>\n    </div>\n  </div>\n  <div class=\"risk-item\">\n    <div class=\"risk-num\">03</div>\n    <div class=\"risk-body\">\n      <div class=\"t\">공급망 &amp; 지정학 리스크</div>\n      <div class=\"d\">스위칭 칩을 사실상 브로드컴 한 곳에 의존하고, 위탁생산은 말레이시아·베트남·멕시코 해외 공장에 맡깁니다. 관세, 수출규제, 대만-중국 정세 변화에 그대로 노출됩니다. <span class=\"cite-inline\">(10-K p.8, 1A 위험요인)</span></div>\n    </div>\n  </div>\n</section>\n\n<!-- 09 재무 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">09</span><span class=\"sec-title\">핵심 재무 (5년)</span></div>\n\n  <div class=\"tbl-wrap\">\n    <table>\n      <thead>\n        <tr><th>연도</th><th class=\"num\">매출</th><th class=\"num\">YoY</th><th class=\"num\">영업이익</th><th class=\"num\">영업이익률</th><th class=\"num\">잉여현금흐름(FCF)</th><th class=\"num\">이자부 부채</th></tr>\n      </thead>\n      <tbody>\n        <tr><td>FY2021</td><td class=\"num\">$2,948.0M</td><td class=\"num\">—</td><td class=\"num\">$924.7M</td><td class=\"num\">31.4%</td><td class=\"num\">$951.2M</td><td class=\"num\">$0</td></tr>\n        <tr><td>FY2022</td><td class=\"num\">$4,381.3M</td><td class=\"num pos\">+48.6%</td><td class=\"num\">$1,527.1M</td><td class=\"num\">34.9%</td><td class=\"num neg\">$448.2M</td><td class=\"num\">$0</td></tr>\n        <tr><td>FY2023</td><td class=\"num\">$5,860.2M</td><td class=\"num pos\">+33.8%</td><td class=\"num\">$2,257.2M</td><td class=\"num\">38.5%</td><td class=\"num pos\">$1,999.6M</td><td class=\"num\">$0</td></tr>\n        <tr><td>FY2024</td><td class=\"num\">$7,003.1M</td><td class=\"num pos\">+19.5%</td><td class=\"num\">$2,944.6M</td><td class=\"num\">42.0%</td><td class=\"num pos\">$3,676.2M</td><td class=\"num\">$0</td></tr>\n        <tr><td>FY2025</td><td class=\"num\">$9,005.7M</td><td class=\"num pos\">+28.6%</td><td class=\"num\">$3,856.1M</td><td class=\"num\">42.8%</td><td class=\"num pos\">$4,252.4M</td><td class=\"num\">$0</td></tr>\n      </tbody>\n    </table>\n  </div>\n\n  <div class=\"fin-chart\">\n    <div class=\"fin-yaxis\"><span>$9.0B</span><span>$4.5B</span><span>$0</span></div>\n    <div class=\"fin-bars\">\n      <div class=\"fin-col\"><div class=\"fin-bar-wrap\">\n        <div class=\"fin-bar rev\" style=\"height:32.7%;\"></div><div class=\"fin-bar op\" style=\"height:24.0%;\"></div><div class=\"fin-bar fcf\" style=\"height:22.4%;\"></div>\n      </div><div class=\"yl\">2021</div></div>\n      <div class=\"fin-col\"><div class=\"fin-bar-wrap\">\n        <div class=\"fin-bar rev\" style=\"height:48.6%;\"></div><div class=\"fin-bar op\" style=\"height:39.6%;\"></div><div class=\"fin-bar fcf\" style=\"height:10.5%;\"></div>\n      </div><div class=\"yl\">2022</div></div>\n      <div class=\"fin-col\"><div class=\"fin-bar-wrap\">\n        <div class=\"fin-bar rev\" style=\"height:65.1%;\"></div><div class=\"fin-bar op\" style=\"height:58.5%;\"></div><div class=\"fin-bar fcf\" style=\"height:47.0%;\"></div>\n      </div><div class=\"yl\">2023</div></div>\n      <div class=\"fin-col\"><div class=\"fin-bar-wrap\">\n        <div class=\"fin-bar rev\" style=\"height:77.8%;\"></div><div class=\"fin-bar op\" style=\"height:76.4%;\"></div><div class=\"fin-bar fcf\" style=\"height:86.5%;\"></div>\n      </div><div class=\"yl\">2024</div></div>\n      <div class=\"fin-col\"><div class=\"fin-bar-wrap\">\n        <div class=\"fin-bar rev\" style=\"height:100%;\"></div><div class=\"fin-bar op\" style=\"height:100%;\"></div><div class=\"fin-bar fcf\" style=\"height:100%;\"></div>\n      </div><div class=\"yl\">2025</div></div>\n    </div>\n  </div>\n  <div class=\"legend\">\n    <span><i class=\"dot\" style=\"background:var(--accent);\"></i>매출</span>\n    <span><i class=\"dot\" style=\"background:#6f95bd;\"></i>영업이익</span>\n    <span><i class=\"dot\" style=\"background:var(--good);\"></i>FCF</span>\n  </div>\n\n  <div class=\"callout warn\" style=\"margin-top:18px;\">2022년엔 영업이익이 65% 늘었는데 잉여현금흐름(FCF)은 오히려 53% 줄었습니다. 당시 공급망 위기 속에서 재고를 미리 대량으로 쌓아두느라 현금이 묶였기 때문입니다(운전자본 변동). 지금은 정상화됐지만, 이익과 실제 현금이 따로 놀았던 해가 있었다는 점은 기억해둘 만합니다.</div>\n\n  <p style=\"margin-top:16px;\">부채: 아리스타는 5개년 내내 이자부 장기부채가 <strong>0원</strong>입니다. 대차대조표상 부채는 대부분 이연수익(선수금)과 매입채무이며, 현금+단기투자자산만 FY2025 말 기준 $10.7B에 달합니다. FCF = 영업활동현금흐름 − 유형자산 등 취득(CapEx)로 계산했습니다.</p>\n  <div class=\"callout note\">최신 분기(2026년 2분기) 매출은 $3,035.7M으로 전년 동기 대비 +37.7% 성장했습니다. FY2025 연간 성장률(+28.6%)보다 오히려 <strong>가속</strong>하고 있어, 아직 AI 데이터센터向 수요가 꺾이지 않았음을 보여줍니다.</div>\n  <div class=\"cite-inline\">출처: 10-K FY2025 손익계산서 p.69·현금흐름표 p.72·대차대조표 p.68, 10-K FY2023 손익계산서·현금흐름표(2021·2022년 비교치)</div>\n  <div class=\"callout note\" style=\"margin-top:14px;\">참고: 아리스타는 2024년 12월 1대4 액면분할을 했습니다. 위 표의 금액은 전부 분할 영향이 없는 총액(매출·이익·현금흐름) 기준이라 연도 간 비교에 문제가 없습니다. 다만 EPS(주당순이익)는 연도별 분할 조정 여부가 달라 이 카드에는 싣지 않았습니다.</div>\n</section>\n\n<!-- 10 모르는 것 -->\n<section>\n  <div class=\"sec-head\"><span class=\"sec-num\">10</span><span class=\"sec-title\">내가 아직 모르는 것</span></div>\n  <ul class=\"plain unknowns\">\n    <li>\n      <div class=\"q\">최신 연도 상위 2개 고객이 여전히 메타·마이크로소프트인지</div>\n      <div class=\"a\">FY2025 10-K에는 고객 실명이 빠져 있습니다(FY2024 10-K까지는 명시). 구성이 바뀌었는지는 최근 어닝콜이나 IR 자료를 봐야 확인됩니다.</div>\n    </li>\n    <li>\n      <div class=\"q\">빅테크 AI 설비투자가 꺾이기 시작하면 매출이 얼마나 빨리, 얼마나 크게 꺾일지</div>\n      <div class=\"a\">이 자료는 과거 실적일 뿐이라 사이클이 꺾일 때의 민감도까지는 알려주지 않습니다.</div>\n    </li>\n    <li>\n      <div class=\"q\">Nvidia NVLink·자체설계 트렌드가 실제로 이더넷(아리스타 영역) 점유율을 얼마나 잠식하고 있는지</div>\n      <div class=\"a\">공시에는 위험요인으로만 서술돼 있어, 실제 수주 데이터나 업계 리서치를 추가로 봐야 정도를 판단할 수 있습니다.</div>\n    </li>\n  </ul>\n</section>\n\n<footer>\n  <div>작성 기준일: 2026-09-01 · 통화 단위: 미국 달러(USD, 백만 단위 표기)</div>\n  <div class=\"src\">\n    참고 자료<br>\n    · SEC EDGAR 10-K FY2025 (CIK 0001596532, Accession 0001596532-26-000013, 제출일 2026-02-17)<br>\n    · SEC EDGAR 10-K FY2024 (Accession 0001596532-25-000028, 제출일 2025-02-19) — 고객 실명, 2년치 비교 재무<br>\n    · SEC EDGAR 10-K FY2023 (Accession 0001596532-24-000043, 제출일 2024-02-13) — FY2021·FY2022 재무<br>\n    · SEC EDGAR DEF 14A (Accession 0001193125-26-158942, 제출일 2026-04-16) — 경영진·지분<br>\n    · SEC EDGAR 10-Q Q2 FY2026 (Accession 0001596532-26-000175, 제출일 2026-08-05) — 최근 분기 매출 성장률<br>\n    · stockanalysis.com/stocks/anet — 주가·시가총액·PER (2026-08-31 종가)\n  </div>\n</footer>\n\n</div></div>","scripts":[],"ext":[],"lede":"아리스타네트웍스는 구글·메타·마이크로소프트 같은 회사들의 데이터센터에서 컴퓨터 수만 대가 서로 데이터를 주고받게 해주는 &lsquo;초고속 교통정리 장비(네트워크 스위치)&rsquo;를 만들어 팔고, 그 장비를 계속 관리해주는 대가로 매년 유지보수 구독료도 받는 회사입니다. 출처: 10-K FY2025, Item 1 Business, p.7–8"}
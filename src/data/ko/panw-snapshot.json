{"html":"<div class=\"kr-card\"><style>.kr-card{\n    --bg:#FAF9F5;\n    --surface:#FFFFFF;\n    --surface-2:#F2EFE7;\n    --border:#E4E0D4;\n    --text:#191A1E;\n    --text-muted:#5B5F6B;\n    --accent:#E2572A;\n    --accent-soft:#FBE4DB;\n    --structure:#2A3550;\n    --structure-soft:#E8EAF1;\n    --risk:#B23A2E;\n    --risk-soft:#F6E1DD;\n    --good:#2B7A57;\n    --good-soft:#DFEEE6;\n    --shadow: 0 1px 2px rgba(25,26,30,0.06), 0 8px 24px -12px rgba(25,26,30,0.12);\n  }\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n      --bg:#131418;\n      --surface:#1B1D23;\n      --surface-2:#20232B;\n      --border:#31353F;\n      --text:#F1EFE8;\n      --text-muted:#A6ABB8;\n      --accent:#FF7A4D;\n      --accent-soft:#3A2620;\n      --structure:#9FB2E0;\n      --structure-soft:#252B3D;\n      --risk:#FF8B7A;\n      --risk-soft:#3A2323;\n      --good:#6FCC9C;\n      --good-soft:#1E332A;\n      --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);\n    }\n}\n:root[data-theme=\"dark\"] .kr-card{\n    --bg:#131418;\n    --surface:#1B1D23;\n    --surface-2:#20232B;\n    --border:#31353F;\n    --text:#F1EFE8;\n    --text-muted:#A6ABB8;\n    --accent:#FF7A4D;\n    --accent-soft:#3A2620;\n    --structure:#9FB2E0;\n    --structure-soft:#252B3D;\n    --risk:#FF8B7A;\n    --risk-soft:#3A2323;\n    --good:#6FCC9C;\n    --good-soft:#1E332A;\n    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);\n  }\n.kr-card *{box-sizing:border-box;}\n.kr-card, .kr-card{margin:0;padding:0;}\n.kr-card{\n    background:var(--bg);\n    color:var(--text);\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;\n    line-height:1.55;\n    -webkit-font-smoothing:antialiased;\n  }\n.kr-card .mono{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-variant-numeric: tabular-nums;}\n.kr-card .page{max-width:920px;margin:0 auto;padding:40px 24px 80px;}\n.kr-card .topbar{\n    display:flex;justify-content:space-between;align-items:baseline;\n    font-size:12.5px;color:var(--text-muted);\n    padding-bottom:14px;margin-bottom:28px;border-bottom:1px solid var(--border);\n    flex-wrap:wrap;gap:6px;\n  }\n.kr-card .topbar b{color:var(--text);}\n.kr-card .masthead{\n    display:flex; align-items:center; gap:14px; margin-bottom:6px;\n  }\n.kr-card .ticker-badge{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-weight:600; font-size:13px;\n    background:var(--structure); color:var(--surface);\n    padding:4px 10px; border-radius:5px; letter-spacing:0.03em;\n  }\n.kr-card .company-name{font-size:15px; color:var(--text-muted);}\n.kr-card .drill{\n    font-size:clamp(26px,4.2vw,36px);\n    font-weight:800;\n    line-height:1.32;\n    letter-spacing:-0.01em;\n    margin:18px 0 8px;\n    text-wrap:balance;\n    color:var(--text);\n  }\n.kr-card .drill em{\n    font-style:normal;\n    color:var(--accent);\n    box-shadow: inset 0 -0.34em 0 var(--accent-soft);\n  }\n.kr-card .sub-line{color:var(--text-muted); font-size:14.5px; margin-bottom:36px;}\n.kr-card section{margin-bottom:44px;}\n.kr-card .sec-head{\n    display:flex; align-items:baseline; gap:10px; margin-bottom:16px;\n  }\n.kr-card .sec-num{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12px; color:var(--surface);\n    background:var(--structure); border-radius:999px; width:22px;height:22px;\n    display:inline-flex;align-items:center;justify-content:center; flex:none;\n  }\n.kr-card .sec-title{font-size:19px; font-weight:700; letter-spacing:-0.005em;}\n.kr-card .sec-note{font-size:13px; color:var(--text-muted); margin:-8px 0 16px 32px;}\n.kr-card .card{\n    background:var(--surface); border:1px solid var(--border); border-radius:12px;\n    box-shadow:var(--shadow); padding:20px 22px;\n  }\n.kr-card .diagram-wrap{overflow-x:auto;}\n.kr-card .diagram-wrap svg{display:block; min-width:640px; width:100%; height:auto;}\n.kr-card .flow-box{fill:var(--surface-2); stroke:var(--border); stroke-width:1;}\n.kr-card .flow-box.strong{fill:var(--structure); stroke:var(--structure);}\n.kr-card .flow-label{font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:13px; fill:var(--text); font-weight:600;}\n.kr-card .flow-label.on-strong{fill:var(--surface);}\n.kr-card .flow-sub{font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:11px; fill:var(--text-muted);}\n.kr-card .flow-arrow{stroke:var(--text-muted); stroke-width:1.4; fill:none; marker-end:url(#arrow);}\n.kr-card .flow-arrow.money{stroke:var(--accent); stroke-width:1.8; marker-end:url(#arrow-accent);}\n.kr-card .flow-amt{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px; fill:var(--accent); font-weight:600;}\n.kr-card .grid-2{display:grid; grid-template-columns:1fr 1fr; gap:18px;}\n@media (max-width:640px){.kr-card .grid-2{grid-template-columns:1fr;}\n}\n.kr-card .axis-title{font-size:13px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:12px;}\n.kr-card .bar-row{display:flex; align-items:center; gap:10px; margin-bottom:10px; font-size:13px;}\n.kr-card .bar-label{width:132px; flex:none; color:var(--text-muted);}\n.kr-card .bar-track{flex:1; background:var(--surface-2); border-radius:5px; height:20px; position:relative; overflow:hidden;}\n.kr-card .bar-fill{height:100%; border-radius:5px 0 0 5px; display:flex; align-items:center;}\n.kr-card .bar-fill.a{background:var(--accent);}\n.kr-card .bar-fill.b{background:var(--structure);}\n.kr-card .bar-fill.c{background:#C99A5B;}\n.kr-card .bar-val{width:120px; flex:none; text-align:right; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12.5px;}\n.kr-card table{width:100%; border-collapse:collapse; font-size:13.5px;}\n.kr-card th, .kr-card td{text-align:right; padding:7px 8px; border-bottom:1px solid var(--border); white-space:nowrap;}\n.kr-card th:first-child, .kr-card td:first-child{text-align:left;}\n.kr-card thead th{color:var(--text-muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:0.03em;}\n.kr-card td.num, .kr-card th.num{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;}\n.kr-card tbody tr:last-child td{border-bottom:none;}\n.kr-card .yoy-up{color:var(--good);}\n.kr-card .yoy-down{color:var(--risk);}\n.kr-card .table-scroll{overflow-x:auto;}\n.kr-card .kv-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}\n@media (max-width:640px){.kr-card .kv-grid{grid-template-columns:1fr;}\n}\n.kr-card .kv-block h4{margin:0 0 8px; font-size:13px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.04em; font-weight:700;}\n.kr-card .comp-row{display:flex; gap:10px; padding:9px 0; border-bottom:1px solid var(--border); font-size:13.5px;}\n.kr-card .comp-row:last-child{border-bottom:none;}\n.kr-card .comp-name{font-weight:700; flex:none; width:110px;}\n.kr-card .comp-desc{color:var(--text-muted);}\n.kr-card .kpi-card{display:grid; grid-template-columns:1fr 1fr; gap:20px;}\n@media (max-width:640px){.kr-card .kpi-card{grid-template-columns:1fr;}\n}\n.kr-card .kpi-title{font-weight:700; font-size:14.5px; margin-bottom:2px;}\n.kr-card .kpi-why{font-size:12.5px; color:var(--text-muted); margin-bottom:14px;}\n.kr-card .spark{display:flex; align-items:flex-end; gap:8px; height:90px; margin-bottom:6px;}\n.kr-card .spark .col{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; gap:6px;}\n.kr-card .spark .bar{width:100%; max-width:34px; background:var(--structure); border-radius:4px 4px 0 0;}\n.kr-card .spark .bar.hi{background:var(--accent);}\n.kr-card .spark .yr{font-size:10.5px; color:var(--text-muted);}\n.kr-card .spark .v{font-size:10.5px; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;}\n.kr-card .mgmt-lines p{margin:0 0 8px; font-size:14px;}\n.kr-card .mgmt-lines p:last-child{margin-bottom:0;}\n.kr-card .return-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}\n@media (max-width:640px){.kr-card .return-grid{grid-template-columns:1fr;}\n}\n.kr-card .stat{font-size:26px; font-weight:800; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;}\n.kr-card .stat-label{font-size:12.5px; color:var(--text-muted); margin-top:2px;}\n.kr-card .doom-line{\n    font-size:15.5px; font-weight:600; line-height:1.6; padding:16px 18px;\n    background:var(--risk-soft); border-left:3px solid var(--risk); border-radius:0 8px 8px 0;\n    margin-bottom:18px;\n  }\n.kr-card .risk-item{display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--border);}\n.kr-card .risk-item:last-child{border-bottom:none;}\n.kr-card .risk-num{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; color:var(--risk); font-weight:700; flex:none;}\n.kr-card .risk-body b{display:block; margin-bottom:2px;}\n.kr-card .risk-body span{color:var(--text-muted); font-size:13.5px;}\n.kr-card .fin-charts{display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:20px;}\n@media (max-width:640px){.kr-card .fin-charts{grid-template-columns:1fr;}\n}\n.kr-card .fin-chart-title{font-size:13px; font-weight:700; margin-bottom:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.03em;}\n.kr-card .bars{display:flex; align-items:flex-end; gap:10px; height:110px;}\n.kr-card .bars .b-col{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; gap:6px; height:100%;}\n.kr-card .bars .b{width:100%; border-radius:3px 3px 0 0;}\n.kr-card .bars .b.pos{background:var(--structure);}\n.kr-card .bars .b.neg{background:var(--risk); align-self:flex-start; border-radius:0 0 3px 3px;}\n.kr-card .bars .b.fcf{background:var(--accent);}\n.kr-card .bars .yr{font-size:10.5px;color:var(--text-muted);}\n.kr-card .zero-line{border-top:1px dashed var(--border); position:relative; margin-top:-1px;}\n.kr-card .warn-box{\n    margin-top:16px; font-size:13px; padding:11px 14px; background:var(--structure-soft);\n    border-radius:8px; color:var(--text);\n  }\n.kr-card .unknowns{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px;}\n.kr-card .unknowns li{\n    font-size:14px; padding:12px 14px; background:var(--surface-2); border-radius:8px;\n    position:relative; padding-left:30px;\n  }\n.kr-card .unknowns li::before{content:\"?\"; position:absolute; left:11px; top:11px; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-weight:700; color:var(--accent);}\n.kr-card .src{font-size:11.5px; color:var(--text-muted); margin-top:8px;}\n.kr-card .src.tight{margin-top:4px;}\n.kr-card footer{margin-top:56px; padding-top:18px; border-top:1px solid var(--border); font-size:12px; color:var(--text-muted); text-align:center;}\n</style>\n\n<div class=\"page\">\n\n  <div class=\"topbar\">\n    <span>📄 PANW SEC 공시자료 (10-K FY2021–FY2025, 10-Q, DEF 14A, 어닝콜) 기반 · 페이지 출처 명시</span>\n    <span><b>Palo Alto Networks, Inc.</b> · NASDAQ: PANW · 회계연도 종료 7월 31일</span>\n  </div>\n\n  <div class=\"masthead\">\n    <span class=\"ticker-badge\">PANW</span>\n    <span class=\"company-name\">Palo Alto Networks, Inc. · 미국 상장 · 사이버보안</span>\n  </div>\n\n  <h1 class=\"drill\">\n    팔로알토 네트웍스는 회사와 정부기관의 컴퓨터·네트워크를<br>\n    <em>해커로부터 지켜주는 보안 소프트웨어</em>를 만들어서,<br>\n    매달 내는 <em>구독료</em>로 돈을 버는 회사입니다.\n  </h1>\n  <p class=\"sub-line\">2005년 설립, 캘리포니아 산타클라라 본사. 방화벽 장비로 시작해 지금은 매출의 80%가 구독형 보안 서비스에서 나옵니다. — 출처: 10-K FY2025, p.4</p>\n\n  <!-- ② 돈 버는 구조 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">2</span><span class=\"sec-title\">돈 버는 구조</span></div>\n    <div class=\"card diagram-wrap\">\n      <svg viewBox=\"0 0 860 300\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 z\" fill=\"currentColor\" style=\"color:var(--text-muted)\"/>\n          </marker>\n          <marker id=\"arrow-accent\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 z\" fill=\"currentColor\" style=\"color:var(--accent)\"/>\n          </marker>\n        </defs>\n\n        <!-- boxes -->\n        <rect class=\"flow-box strong\" x=\"20\" y=\"110\" width=\"140\" height=\"70\" rx=\"8\"/>\n        <text class=\"flow-label on-strong\" x=\"90\" y=\"140\" text-anchor=\"middle\">PANW</text>\n        <text class=\"flow-sub\" x=\"90\" y=\"158\" text-anchor=\"middle\" style=\"fill:var(--surface);opacity:.8\">방화벽·보안SW 개발</text>\n\n        <rect class=\"flow-box\" x=\"240\" y=\"110\" width=\"150\" height=\"70\" rx=\"8\"/>\n        <text class=\"flow-label\" x=\"315\" y=\"140\" text-anchor=\"middle\">유통사 · 리셀러</text>\n        <text class=\"flow-sub\" x=\"315\" y=\"158\" text-anchor=\"middle\">2단계 간접 판매망</text>\n\n        <rect class=\"flow-box\" x=\"470\" y=\"110\" width=\"150\" height=\"70\" rx=\"8\"/>\n        <text class=\"flow-label\" x=\"545\" y=\"138\" text-anchor=\"middle\">최종 고객</text>\n        <text class=\"flow-sub\" x=\"545\" y=\"156\" text-anchor=\"middle\">기업·정부, 180개국+</text>\n\n        <rect class=\"flow-box strong\" x=\"700\" y=\"20\" width=\"140\" height=\"60\" rx=\"8\"/>\n        <text class=\"flow-label on-strong\" x=\"770\" y=\"46\" text-anchor=\"middle\">R&amp;D·인수</text>\n        <text class=\"flow-sub\" x=\"770\" y=\"63\" text-anchor=\"middle\" style=\"fill:var(--surface);opacity:.8\">신제품·CyberArk 등</text>\n\n        <!-- forward flow: product -->\n        <path class=\"flow-arrow\" d=\"M160,140 L238,140\"/>\n        <path class=\"flow-arrow\" d=\"M390,140 L468,140\"/>\n\n        <!-- money flow back -->\n        <path class=\"flow-arrow money\" d=\"M545,178 C545,230 320,230 90,230 C60,230 60,200 60,182\"/>\n        <text class=\"flow-amt\" x=\"300\" y=\"248\">구독료 80.5% + 하드웨어 19.5% (FY2025)</text>\n\n        <!-- reinvest -->\n        <path class=\"flow-arrow money\" d=\"M160,120 C300,60 550,50 698,50\"/>\n        <text class=\"flow-amt\" x=\"330\" y=\"42\">번 돈을 다시 신제품·M&amp;A에 투입</text>\n\n        <path class=\"flow-arrow\" d=\"M770,80 C770,105 250,120 162,128\" />\n      </svg>\n    </div>\n    <p class=\"src\">고객이 낸 구독료·지원료가 PANW로 돌아오고, 그 돈이 다시 신제품 개발과 CyberArk 같은 회사 인수에 들어가 제품 라인을 넓히는 구조입니다. 매출의 대부분(FY2025 기준 3개 유통사가 44.2%)이 소수 유통사를 거쳐 흐릅니다. — 출처: 10-K FY2025, p.4, p.34</p>\n  </section>\n\n  <!-- ③ 매출 구성 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">3</span><span class=\"sec-title\">매출 구성 — 두 축으로</span></div>\n    <div class=\"card\">\n      <div class=\"grid-2\">\n        <div>\n          <div class=\"axis-title\">제품 유형별 (FY2025)</div>\n          <div class=\"bar-row\">\n            <div class=\"bar-label\">구독(Subscription)</div>\n            <div class=\"bar-track\"><div class=\"bar-fill a\" style=\"width:54%\"></div></div>\n            <div class=\"bar-val\">$4,974.4M · 54.0%</div>\n          </div>\n          <div class=\"bar-row\">\n            <div class=\"bar-label\">지원(Support)</div>\n            <div class=\"bar-track\"><div class=\"bar-fill b\" style=\"width:26.5%\"></div></div>\n            <div class=\"bar-val\">$2,445.2M · 26.5%</div>\n          </div>\n          <div class=\"bar-row\">\n            <div class=\"bar-label\">제품(하드웨어)</div>\n            <div class=\"bar-track\"><div class=\"bar-fill c\" style=\"width:19.5%\"></div></div>\n            <div class=\"bar-val\">$1,801.9M · 19.5%</div>\n          </div>\n          <p class=\"src tight\">PANW는 단일 보고 세그먼트로 운영되어, 사업부문별(네트워크보안/Cortex 등) 영업이익률은 별도 공시되지 않습니다 — 공시 미제공. 출처: 10-K FY2025, p.72</p>\n        </div>\n        <div>\n          <div class=\"axis-title\">지역별 (FY2025)</div>\n          <div class=\"bar-row\">\n            <div class=\"bar-label\">미주(Americas)</div>\n            <div class=\"bar-track\"><div class=\"bar-fill a\" style=\"width:67.3%\"></div></div>\n            <div class=\"bar-val\">$6,205.1M · 67.3%</div>\n          </div>\n          <div class=\"bar-row\">\n            <div class=\"bar-label\">EMEA</div>\n            <div class=\"bar-track\"><div class=\"bar-fill b\" style=\"width:20.8%\"></div></div>\n            <div class=\"bar-val\">$1,917.4M · 20.8%</div>\n          </div>\n          <div class=\"bar-row\">\n            <div class=\"bar-label\">APAC</div>\n            <div class=\"bar-track\"><div class=\"bar-fill c\" style=\"width:11.9%\"></div></div>\n            <div class=\"bar-val\">$1,099.0M · 11.9%</div>\n          </div>\n          <p class=\"src tight\">해외 비중이 33%에 달해 환율 변동과 각국 수출·관세 규제(특히 미·중, 이스라엘 정세)에 노출됩니다. 출처: 10-K FY2025, p.72</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ④ 고객 & 경쟁사 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">4</span><span class=\"sec-title\">고객 &amp; 경쟁사</span></div>\n    <div class=\"card kv-grid\">\n      <div class=\"kv-block\">\n        <h4>고객</h4>\n        <p style=\"font-size:13.5px;margin:0 0 10px;\">전부 B2B/B2G. 180개국 이상, 포춘100 대부분과 글로벌2000 다수가 고객입니다. 다만 <b>실제 매출 계약은 최종 고객이 아니라 유통사와 체결</b>됩니다 — 3개 유통사가 FY2025 총매출의 44.2%, 매출채권의 44.8%를 차지해 집중도가 높습니다. 반면 최종 고객 중 매출 10%를 넘는 단일 고객은 없습니다.</p>\n        <p class=\"src tight\">출처: 10-K FY2025, p.4, p.34, p.70</p>\n      </div>\n      <div class=\"kv-block\">\n        <h4>경쟁사</h4>\n        <div class=\"comp-row\"><div class=\"comp-name\">CrowdStrike</div><div class=\"comp-desc\">엔드포인트·SOC 자동화(Cortex XSIAM/XDR 경쟁) 중심, 클라우드 네이티브로 더 가볍다는 평가</div></div>\n        <div class=\"comp-row\"><div class=\"comp-name\">Fortinet</div><div class=\"comp-desc\">전통 방화벽 시장의 최대 경쟁자. 가격이 더 저렴해 중소기업 구간에서 강세</div></div>\n        <div class=\"comp-row\"><div class=\"comp-name\">Zscaler</div><div class=\"comp-desc\">클라우드 기반 SASE(원격 보안 접속) 전문. PANW의 Prisma Access와 직접 경쟁</div></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ⑤ 핵심 KPI -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">5</span><span class=\"sec-title\">이 업종의 핵심 KPI</span></div>\n    <div class=\"card kpi-card\">\n      <div>\n        <div class=\"kpi-title\">NGS ARR (차세대 보안 연환산반복매출)</div>\n        <div class=\"kpi-why\">일회성 하드웨어 판매를 빼고, 구독으로 매년 안정적으로 들어올 돈만 뽑아낸 지표입니다. 이게 늘어야 \"진짜 구독 사업\"이 커지는 겁니다.</div>\n        <div class=\"spark\">\n          <div class=\"col\"><div class=\"bar\" style=\"height:52%\"></div><div class=\"v mono\">$4.2B</div><div class=\"yr\">FY24</div></div>\n          <div class=\"col\"><div class=\"bar\" style=\"height:69%\"></div><div class=\"v mono\">$5.6B</div><div class=\"yr\">FY25</div></div>\n          <div class=\"col\"><div class=\"bar hi\" style=\"height:100%\"></div><div class=\"v mono\">$8.1B</div><div class=\"yr\">Q3 FY26</div></div>\n        </div>\n        <p class=\"src tight\">Q3 FY2026 수치는 CyberArk·Chronosphere 인수 효과가 섞여 있어 순수 성장(organic)은 +28%. 출처: 10-K FY2025, p.44 / Q3 FY2026 어닝콜</p>\n      </div>\n      <div>\n        <div class=\"kpi-title\">RPO (잔여 계약 이행 의무)</div>\n        <div class=\"kpi-why\">고객이 이미 계약했지만 아직 매출로 잡히지 않은 금액. \"앞으로 들어올 돈이 얼마나 쌓여있나\"를 보여줘서 미래 매출을 미리 가늠하게 해줍니다.</div>\n        <div class=\"spark\">\n          <div class=\"col\"><div class=\"bar\" style=\"height:58%\"></div><div class=\"v mono\">$10.6B</div><div class=\"yr\">FY23</div></div>\n          <div class=\"col\"><div class=\"bar\" style=\"height:69%\"></div><div class=\"v mono\">$12.7B</div><div class=\"yr\">FY24</div></div>\n          <div class=\"col\"><div class=\"bar\" style=\"height:86%\"></div><div class=\"v mono\">$15.8B</div><div class=\"yr\">FY25</div></div>\n          <div class=\"col\"><div class=\"bar hi\" style=\"height:100%\"></div><div class=\"v mono\">$18.4B</div><div class=\"yr\">Q3 FY26</div></div>\n        </div>\n        <p class=\"src tight\">출처: 10-K FY2023, p.68 · 10-K FY2025, p.44 · Q3 FY2026 어닝콜</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- ⑥ 경영진 & 오너십 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">6</span><span class=\"sec-title\">경영진 &amp; 오너십</span></div>\n    <div class=\"card mgmt-lines\">\n      <p><b>니케시 아로라(Nikesh Arora)</b>가 2018년 6월부터 이사회 의장 겸 CEO를 맡고 있습니다(약 7년째). 이전에는 구글 최고사업책임자(CBO), 소프트뱅크 사장 겸 COO를 지냈습니다.</p>\n      <p>창업자 <b>니르 주크(Nir Zuk)</b>는 이제 \"Founder Emeritus\"(명예 창업자)로, 전직 CTO이며 더 이상 이사회에 있지 않습니다 — 창업자가 경영에서 물러난 회사입니다.</p>\n      <p>이사·임원 전체 지분율은 <b>1.4%</b>로 낮은 편이고, 최대 주주는 뱅가드(8.2%)와 블랙록(7.3%) 같은 기관투자자입니다.</p>\n      <p class=\"src tight\">출처: DEF 14A (2025), p.56, p.147</p>\n    </div>\n  </section>\n\n  <!-- ⑦ 주주환원 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">7</span><span class=\"sec-title\">주주환원</span></div>\n    <div class=\"card return-grid\">\n      <div>\n        <div class=\"stat\">$0</div>\n        <div class=\"stat-label\">배당 — 상장 이후 단 한 번도 배당을 지급한 적이 없고, \"당분간 배당 계획 없음\"이라고 명시</div>\n      </div>\n      <div>\n        <div class=\"stat\">$0</div>\n        <div class=\"stat-label\">FY2025 자사주 매입액 — CyberArk 인수 자금 확보를 위해 매입을 중단(FY2024엔 $566.7M 매입)</div>\n      </div>\n    </div>\n    <p class=\"src\">자사주 매입 총 승인 한도는 $4.1B이며, FY2025 말 기준 $1.0B이 아직 남아 있습니다. 발행주식수는 FY2024 650.2M → FY2025 667.9M으로 오히려 늘었습니다(임직원 보상용 신주 발행이 매입분보다 많았다는 뜻) — 실질적인 주주환원 효과는 제한적입니다. 출처: 10-K FY2025, p.86, p.54</p>\n  </section>\n\n  <!-- ⑧ 망하는 시나리오 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">8</span><span class=\"sec-title\">이 회사가 망하는 시나리오</span></div>\n    <div class=\"doom-line\">\n      만약 팔로알토 자신의 보안 제품이 뚫리거나, 기업들이 \"보안을 한 회사에 몰아주면 더 안전하고 싸다\"는 믿음을 버리고 다시 여러 회사 제품을 섞어 쓰기 시작하면, 신제품을 팔 때마다 기존 고객에게 끼워 파는 이 회사의 성장 엔진은 한 번에 멈춥니다.\n    </div>\n    <div class=\"card\">\n      <div class=\"risk-item\">\n        <div class=\"risk-num\">01</div>\n        <div class=\"risk-body\"><b>CyberArk 인수 통합 실패 위험</b><span>2025년 발표한 대형 인수(정체성 보안 회사 CyberArk)와 Chronosphere 인수가 기대한 시너지를 못 내거나 통합이 늦어지면, 관심이 분산되고 목표한 이익률(FY2028 잉여현금흐름마진 40%) 달성이 밀릴 수 있습니다.</span></div>\n      </div>\n      <div class=\"risk-item\">\n        <div class=\"risk-num\">02</div>\n        <div class=\"risk-body\"><b>유통 채널 집중 리스크</b><span>매출의 44.2%가 단 3개 유통사를 거칩니다. 이 중 한 곳과 관계가 틀어지거나 재무 상태가 나빠지면 판매망 전체가 흔들릴 수 있습니다.</span></div>\n      </div>\n      <div class=\"risk-item\">\n        <div class=\"risk-num\">03</div>\n        <div class=\"risk-body\"><b>경쟁 심화에 따른 가격 인하 압력</b><span>CrowdStrike·Fortinet·Zscaler 등과 AI 보안 경쟁이 치열해지며, 여러 제품을 묶어 파는 번들 할인이 커지면 매출은 늘어도 단가와 이익률이 눌릴 수 있습니다.</span></div>\n      </div>\n    </div>\n    <p class=\"src\">출처: 10-K FY2025, p.15–29 (Risk Factors 요약) · Q3 FY2026 어닝콜</p>\n  </section>\n\n  <!-- ⑨ 핵심 재무 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">9</span><span class=\"sec-title\">핵심 재무 (5년)</span></div>\n    <div class=\"card\">\n      <div class=\"table-scroll\">\n        <table>\n          <thead>\n            <tr><th>회계연도(7월 말)</th><th class=\"num\">FY2021</th><th class=\"num\">FY2022</th><th class=\"num\">FY2023</th><th class=\"num\">FY2024</th><th class=\"num\">FY2025</th></tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td>매출 (Revenue)</td>\n              <td class=\"num\">4,256.1</td><td class=\"num\">5,501.5</td><td class=\"num\">6,892.7</td><td class=\"num\">8,027.5</td><td class=\"num\">9,221.5</td>\n            </tr>\n            <tr>\n              <td>매출 YoY</td>\n              <td class=\"num yoy-up\">+24.9%</td><td class=\"num yoy-up\">+29.3%</td><td class=\"num yoy-up\">+25.3%</td><td class=\"num yoy-up\">+16.5%</td><td class=\"num yoy-up\">+14.9%</td>\n            </tr>\n            <tr>\n              <td>영업이익 (Op. Income)</td>\n              <td class=\"num yoy-down\">(304.1)</td><td class=\"num yoy-down\">(188.8)</td><td class=\"num\">387.3</td><td class=\"num\">683.9</td><td class=\"num\">1,242.9</td>\n            </tr>\n            <tr>\n              <td>영업이익률</td>\n              <td class=\"num yoy-down\">(7.1%)</td><td class=\"num yoy-down\">(3.4%)</td><td class=\"num\">5.6%</td><td class=\"num\">8.5%</td><td class=\"num\">13.5%</td>\n            </tr>\n            <tr>\n              <td>잉여현금흐름 (FCF)</td>\n              <td class=\"num\">1,387.0</td><td class=\"num\">1,791.9</td><td class=\"num\">2,631.2</td><td class=\"num\">3,100.8</td><td class=\"num\">3,469.8</td>\n            </tr>\n            <tr>\n              <td>부채 (전환사채, 잔액)</td>\n              <td class=\"num\">확인 필요</td><td class=\"num\">3,676.8</td><td class=\"num\">1,991.5</td><td class=\"num\">963.9</td><td class=\"num\">0</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"fin-charts\">\n        <div>\n          <div class=\"fin-chart-title\">영업이익 (백만$) — 적자→흑자 전환</div>\n          <div class=\"bars\">\n            <div class=\"b-col\"><div class=\"b neg\" style=\"height:34px\"></div><div class=\"yr\">21</div></div>\n            <div class=\"b-col\"><div class=\"b neg\" style=\"height:21px\"></div><div class=\"yr\">22</div></div>\n            <div class=\"b-col\"><div class=\"b pos\" style=\"height:43px\"></div><div class=\"yr\">23</div></div>\n            <div class=\"b-col\"><div class=\"b pos\" style=\"height:76px\"></div><div class=\"yr\">24</div></div>\n            <div class=\"b-col\"><div class=\"b pos\" style=\"height:100%\"></div><div class=\"yr\">25</div></div>\n          </div>\n        </div>\n        <div>\n          <div class=\"fin-chart-title\">잉여현금흐름 (백만$) — 꾸준히 증가</div>\n          <div class=\"bars\">\n            <div class=\"b-col\"><div class=\"b fcf\" style=\"height:40%\"></div><div class=\"yr\">21</div></div>\n            <div class=\"b-col\"><div class=\"b fcf\" style=\"height:52%\"></div><div class=\"yr\">22</div></div>\n            <div class=\"b-col\"><div class=\"b fcf\" style=\"height:76%\"></div><div class=\"yr\">23</div></div>\n            <div class=\"b-col\"><div class=\"b fcf\" style=\"height:89%\"></div><div class=\"yr\">24</div></div>\n            <div class=\"b-col\"><div class=\"b fcf\" style=\"height:100%\"></div><div class=\"yr\">25</div></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"warn-box\">\n        ⚠️ FY2024 순이익($2,577.6M)이 유독 큰 건 본업이 아니라 <b>일회성 법인세 혜택</b>($1,589.3M 세금 환급) 때문입니다. FY2025 순이익은 $1,133.9M으로, 영업이익($1,242.9M)에 더 가까운 정상 수준입니다. 순이익만 보고 이익 개선 속도를 오해하면 안 됩니다.\n      </div>\n      <p class=\"src\">출처: 10-K FY2025, p.44–45, p.54, p.86 / 10-K FY2023, p.40, p.68</p>\n    </div>\n  </section>\n\n  <!-- ⑩ 아직 모르는 것 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-num\">10</span><span class=\"sec-title\">내가 아직 모르는 것</span></div>\n    <ul class=\"unknowns\">\n      <li>CyberArk·Chronosphere 인수가 완료된 이후(2026년 초·중반) 통합된 재무제표는 아직 FY2025 10-K에 반영되어 있지 않습니다. FY2026 10-K(2026년 8월경 공시 예정)를 봐야 인수 후 실제 이익률 변화를 확인할 수 있습니다.</li>\n      <li>2026년 7월 마감된 FY2026 4분기 실적발표는 이 카드 작성 시점(2026년 8월)까지 아직 공개되지 않았습니다. 최신 가이던스는 별도 확인이 필요합니다.</li>\n      <li>\"FY2028까지 잉여현금흐름마진 40%\" 목표가 CyberArk 통합 비용을 다 반영한 뒤에도 유지될지는 이 자료만으로는 알 수 없습니다.</li>\n    </ul>\n  </section>\n\n  <footer>\n    Palo Alto Networks (PANW) 요약 카드 · 업로드된 10-K(FY2021–FY2025)·10-Q·DEF 14A·어닝콜 트랜스크립트 기반 · 2026년 8월 작성\n  </footer>\n\n</div></div>","scripts":[],"ext":[],"lede":""}
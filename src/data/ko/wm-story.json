{"html":"<div class=\"kr-card\"><style>.kr-card{\n  --bg: #fbfaf7;\n  --bg-raised: #ffffff;\n  --ink: #16181a;\n  --ink-soft: #4a4f54;\n  --ink-faint: #868c92;\n  --rule: #dedad2;\n  --rule-strong: #c7c2b8;\n  --accent: #1c5c68;\n  --accent-soft: #e7eeed;\n  --accent-ink: #0f3a42;\n  --warn: #a3572a;\n  --warn-soft: #f4e9de;\n  --pos: #1c5c68;\n  --neg: #a3572a;\n  --chip-bg: #eef1ea;\n  --diff-old-bg: #f7ece7;\n  --diff-old-ink: #8a4a2a;\n  --diff-new-bg: #e9f1ee;\n  --diff-new-ink: #17564f;\n  --shadow: 0 1px 2px rgba(30,30,20,0.05), 0 8px 24px -12px rgba(30,30,20,0.12);\n}\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n    --bg: #14181a;\n    --bg-raised: #1b2023;\n    --ink: #ecece6;\n    --ink-soft: #b9bdb8;\n    --ink-faint: #80867f;\n    --rule: #33383a;\n    --rule-strong: #454b4c;\n    --accent: #6fb8c4;\n    --accent-soft: #223032;\n    --accent-ink: #bfe6ec;\n    --warn: #d99666;\n    --warn-soft: #332821;\n    --pos: #6fb8c4;\n    --neg: #d99666;\n    --chip-bg: #22262a;\n    --diff-old-bg: #2c2320;\n    --diff-old-ink: #e0a988;\n    --diff-new-bg: #1c2b28;\n    --diff-new-ink: #8fd4c8;\n    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);\n  }\n}\n:root[data-theme=\"dark\"] .kr-card{\n  --bg: #14181a;\n  --bg-raised: #1b2023;\n  --ink: #ecece6;\n  --ink-soft: #b9bdb8;\n  --ink-faint: #80867f;\n  --rule: #33383a;\n  --rule-strong: #454b4c;\n  --accent: #6fb8c4;\n  --accent-soft: #223032;\n  --accent-ink: #bfe6ec;\n  --warn: #d99666;\n  --warn-soft: #332821;\n  --pos: #6fb8c4;\n  --neg: #d99666;\n  --chip-bg: #22262a;\n  --diff-old-bg: #2c2320;\n  --diff-old-ink: #e0a988;\n  --diff-new-bg: #1c2b28;\n  --diff-new-ink: #8fd4c8;\n  --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);\n}\n.kr-card *{box-sizing:border-box;}\n.kr-card, .kr-card{margin:0;padding:0;}\n.kr-card{\n  background:var(--bg);\n  color:var(--ink);\n  font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;\n  font-size:15.5px;\n  line-height:1.7;\n  -webkit-font-smoothing:antialiased;\n  word-break:keep-all;\n  overflow-wrap:break-word;\n}\n.kr-card .page{max-width:760px; margin:0 auto; padding:0 20px 90px;}\n.kr-card ::selection{background:var(--accent-soft);}\n.kr-card .masthead{padding:44px 0 26px; border-bottom:1px solid var(--rule); margin-bottom:36px;}\n.kr-card .mode-flag{\n  display:inline-flex; align-items:center; gap:6px;\n  font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; letter-spacing:0.03em;\n  color:var(--accent-ink); background:var(--accent-soft);\n  padding:4px 10px; border-radius:20px; margin-bottom:18px;\n}\n.kr-card .ticker{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:14px; font-weight:600; color:var(--ink-faint); letter-spacing:0.04em;}\n.kr-card h2.storytitle{\n  font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-weight:700; font-size:30px;\n  margin:8px 0 8px; letter-spacing:-0.01em; text-wrap:balance;\n}\n.kr-card .subline{color:var(--ink-soft); font-size:14.5px;}\n.kr-card .period-badge{\n  display:inline-block; margin-top:14px;\n  font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; color:var(--ink-faint);\n  border:1px solid var(--rule-strong); border-radius:20px; padding:4px 12px;\n}\n.kr-card .oneliner{\n  background:var(--bg-raised); border:1px solid var(--rule); border-left:4px solid var(--accent);\n  border-radius:6px; padding:26px 28px; box-shadow:var(--shadow); margin-bottom:46px;\n}\n.kr-card .oneliner .tag{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px; color:var(--ink-faint); letter-spacing:0.05em; text-transform:uppercase; display:block; margin-bottom:10px;}\n.kr-card .oneliner p{font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-size:20px; line-height:1.6; font-weight:500; margin:0; text-wrap:balance;}\n.kr-card section{margin-bottom:50px;}\n.kr-card .sec-head{display:flex; align-items:baseline; gap:10px; margin-bottom:18px;}\n.kr-card .sec-icon{font-size:15px;}\n.kr-card .sec-title{font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-weight:600; font-size:20px; letter-spacing:-0.005em;}\n.kr-card .sec-sub{color:var(--ink-faint); font-size:12.8px; margin:-12px 0 18px;}\n.kr-card .story p{font-size:15.8px; line-height:1.85; margin:0 0 20px;}\n.kr-card .story p:last-child{margin-bottom:0;}\n.kr-card .story .fact-tag{\n  font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10.5px; color:var(--accent-ink);\n  background:var(--accent-soft); padding:1px 7px; border-radius:4px; margin-right:4px; white-space:nowrap;\n}\n.kr-card .story .interp-tag{\n  font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10.5px; color:var(--diff-old-ink);\n  background:var(--diff-old-bg); padding:1px 7px; border-radius:4px; margin-right:4px; white-space:nowrap;\n}\n.kr-card .story blockquote{\n  font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-style:italic; font-size:17px; line-height:1.6;\n  margin:22px 0; padding:16px 22px; border-left:3px solid var(--accent); background:var(--accent-soft);\n  border-radius:0 6px 6px 0; color:var(--ink);\n}\n.kr-card .story blockquote cite{display:block; font-style:normal; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px; color:var(--ink-faint); margin-top:8px;}\n.kr-card .timeline-wrap{background:var(--bg-raised); border:1px solid var(--rule); border-radius:6px; padding:20px 16px 14px; box-shadow:var(--shadow); overflow-x:auto;}\n.kr-card .timeline-wrap svg{display:block; margin:0 auto; min-width:640px;}\n.kr-card .diff-block{margin-bottom:26px;}\n.kr-card .diff-block:last-child{margin-bottom:0;}\n.kr-card .diff-label{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; color:var(--ink-faint); margin-bottom:8px; letter-spacing:0.02em;}\n.kr-card .diff-pair{display:grid; grid-template-columns:1fr 1fr; gap:12px;}\n@media (max-width:620px){.kr-card .diff-pair{grid-template-columns:1fr;}\n}\n.kr-card .diff-old, .kr-card .diff-new{border-radius:6px; padding:14px 16px; font-size:13.2px; line-height:1.6;}\n.kr-card .diff-old{background:var(--diff-old-bg); color:var(--diff-old-ink);}\n.kr-card .diff-new{background:var(--diff-new-bg); color:var(--diff-new-ink);}\n.kr-card .diff-src{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10px; margin-top:8px; opacity:0.75;}\n.kr-card .diff-note{font-size:13px; color:var(--ink-soft); margin-top:10px; background:var(--chip-bg); padding:10px 14px; border-radius:5px;}\n.kr-card .diff-arrow{text-align:center; color:var(--ink-faint); font-size:18px; margin:6px 0;}\n.kr-card .pill-row{display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin:14px 0;}\n.kr-card .pill{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12.5px; padding:5px 12px; border-radius:20px; background:var(--chip-bg); color:var(--ink-soft);}\n.kr-card .pill.growing{background:var(--warn-soft); color:var(--diff-old-ink);}\n.kr-card .chart-card{background:var(--bg-raised); border:1px solid var(--rule); border-radius:6px; padding:22px 18px 14px; box-shadow:var(--shadow); overflow-x:auto;}\n.kr-card .chart-card svg{display:block; margin:0 auto; min-width:640px;}\n.kr-card .tonechart{width:100%; height:auto;}\n.kr-card .axislab{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:9.5px; fill:var(--ink-faint);}\n.kr-card .barval{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10px; font-weight:600; fill:var(--accent-ink);}\n.kr-card .eventlab{font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:10px; fill:var(--warn);}\n.kr-card .chart-disclaimer{font-size:12px; color:var(--ink-faint); margin-top:14px; background:var(--chip-bg); padding:10px 14px; border-radius:5px;}\n.kr-card .table-scroll{overflow-x:auto;}\n.kr-card table.scorecard{width:100%; border-collapse:collapse; font-size:13px;}\n.kr-card table.scorecard th, .kr-card table.scorecard td{padding:10px 10px; border-bottom:1px solid var(--rule); text-align:left; vertical-align:top;}\n.kr-card table.scorecard thead th{font-size:11.3px; color:var(--ink-faint); font-weight:600; letter-spacing:0.02em; border-bottom:1px solid var(--rule-strong);}\n.kr-card table.scorecard td.num{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-variant-numeric:tabular-nums;}\n.kr-card .verdict{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; font-weight:600; padding:3px 9px; border-radius:12px; display:inline-block; white-space:nowrap;}\n.kr-card .verdict.beat{background:var(--accent-soft); color:var(--accent-ink);}\n.kr-card .verdict.progress{background:var(--chip-bg); color:var(--ink-soft);}\n.kr-card .score-summary{display:flex; gap:26px; margin-top:16px; flex-wrap:wrap;}\n.kr-card .score-summary .s{display:flex; flex-direction:column; gap:2px;}\n.kr-card .score-summary .s b{font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:17px;}\n.kr-card .score-summary .s span{font-size:11px; color:var(--ink-faint); text-transform:uppercase; letter-spacing:0.03em;}\n.kr-card .unknown-item{display:flex; gap:10px; padding:11px 0; border-bottom:1px solid var(--rule); font-size:13.6px;}\n.kr-card .unknown-item:last-child{border-bottom:none;}\n.kr-card .unknown-mark{color:var(--accent); font-weight:700; flex:0 0 auto;}\n.kr-card .source-card{background:var(--bg-raised); border:1px solid var(--rule); border-radius:6px; padding:18px 20px; box-shadow:var(--shadow);}\n.kr-card .source-cat{font-size:12px; color:var(--ink-faint); text-transform:uppercase; letter-spacing:0.04em; margin:14px 0 6px;}\n.kr-card .source-cat:first-child{margin-top:0;}\n.kr-card .source-list{display:flex; flex-wrap:wrap; gap:6px 8px; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.3px;}\n.kr-card .source-list span{background:var(--chip-bg); padding:3px 9px; border-radius:4px; color:var(--ink-soft); white-space:nowrap;}\n.kr-card footer{margin-top:56px; padding-top:22px; border-top:1px solid var(--rule); font-size:12px; color:var(--ink-faint); display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;}\n</style>\n\n<div class=\"page\">\n\n  <div class=\"masthead\">\n    <span class=\"mode-flag\">📄 10-K 5개년(FY2021–FY2025) · 어닝콜 12분기(2023 Q2–2026 Q1) · DEF 14A 2026 기반</span>\n    <div><span class=\"ticker\">NYSE: WM</span></div>\n    <h2 class=\"storytitle\">WM 스토리: 예외의 대가</h2>\n    <div class=\"subline\">20년 지켜온 \"신중한 M&amp;A\" 원칙을 딱 한 번 깬 회사가, 그 대가를 치르며 다시 신뢰를 쌓아온 1년 반의 기록</div>\n    <span class=\"period-badge\">분석 기간: 2023년 2분기 — 2026년 1분기</span>\n  </div>\n\n  <section>\n    <div class=\"oneliner\">\n      <span class=\"tag\">한 줄 요약</span>\n      <p>WM은 \"비싼 멀티플의 대형 인수는 하지 않는다\"고 공개적으로 다짐한 지 6주 만에 72억 달러짜리 Stericycle을 인수했고, 이후 18개월은 그 베팅이 옳았다는 걸 숫자로 증명해 보이는 시간이었습니다.</p>\n    </div>\n  </section>\n\n  <!-- 스토리 본문 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-icon\">📖</span><span class=\"sec-title\">스토리</span></div>\n    <div class=\"story\">\n      <p><span class=\"fact-tag\">사실</span>2023년부터 2024년 초까지 WM이 하던 이야기는 단순했습니다. \"본업을 더 잘한다\"는 이야기였습니다. 2023년 4분기 콜(2024.2.13)에서 Jim Fish는 영업이익률 29.9%, SG&amp;A 9.4%라는 사상 최고 기록들을 나열하며 \"우리 스스로를 좀 칭찬해도 될 것 같다\"고 말할 정도로 여유가 있었습니다. M&amp;A에 대해서는 원칙이 분명했습니다 — 2023년 3분기 콜에서 Fish는 경쟁 입찰에 뛰어들지 않는 이유를 \"장밋빛 전망에 기댄 12~14배 멀티플을 주느니, 우리 손으로 짓는 재활용·재생에너지 설비에 3배를 쓰는 게 낫다\"고 설명했고, 2024년 1분기 콜(4/25)에서도 M&amp;A 파이프라인은 연 1~2억 달러 규모의 소형 인수(tuck-in)뿐이라고 재확인했습니다. 이 발언 이후 <b>정확히 6주 뒤</b>, 회사는 정반대의 결정을 내립니다.</p>\n\n      <p><span class=\"fact-tag\">사실</span>2024년 6월 3일, WM은 의료폐기물·정보파기 업체 Stericycle을 주당 62달러, 총 72억 달러(순부채 포함)에 인수한다고 발표합니다. 공시 문서는 이 결정을 즉시 반영했습니다. 4개였던 보고부문은 5개로 늘어 \"Healthcare Solutions\"이 새로 생겼고(10-K FY2023 p.5 → 10-K FY2024 p.6-7), \"인수로 인해 상당한 추가 부채를 <b>질 수도 있다</b>(may cause)\"던 위험요인 문장은 \"이미 그런 부채를 <b>졌고, 앞으로도 질 수 있다</b>(has caused, and may in the future cause)\"로 바뀌며 Stericycle의 이름이 처음 명시됐습니다(10-K FY2023 p.20, 11번째 항목 → 10-K FY2024 p.25, 7번째 항목으로 순서도 앞당겨짐). 어닝콜 톤도 즉각 전환됐습니다 — 같은 2분기 콜에서 Fish는 \"2025년에 대해 이보다 더 낙관적일 수 없다... 블록버스터 같은 해가 될 것\"이라고 말하며 Stericycle을 주거·상업·산업에 이은 \"네 번째 사업 라인\"이라 규정했습니다.</p>\n\n      <p><span class=\"fact-tag\">사실</span>인수를 종결한 2024년 11월 이후, 회사는 겉으로는 계속 자신감 있는 숫자를 내놓았습니다 — 비용 시너지 목표를 1.25억 달러(발표 당시)에서 2.5억 달러(2024년 4분기 콜, \"두 배로\")로, 다시 3억 달러(2025년 2·3분기 콜, 교차판매 5천만 달러 추가)로 계속 상향했습니다. 하지만 뒷정리는 예상보다 길었습니다. Healthcare Solutions 부문은 2025년 한 해 내내 영업손실(-8,800만 달러)이었고, 3분기 콜(2025.10.28)에서 John Morris는 고객 이탈 우려를 <q>\"melting ice cube\" 걱정</q>이라 부르며 진화에 나서야 했습니다. 감사인이 \"특히 어렵고 복잡한 판단이 필요하다\"고 별도로 지정하는 핵심감사사항(Critical Audit Matter)도 이 기간 1개(매립지 감가상각)에서 3개(+매립지 캐핑·폐쇄 충당금, +Healthcare Solutions 영업권 손상)로 늘었습니다(10-K FY2025 p.73) — 회사의 재무제표가 회계사 눈에도 확실히 더 복잡해졌다는 뜻입니다. 같은 3분기 콜에서는 23년간 회사를 지켜온 CFO Devina Rankin의 은퇴도 발표되며, 신임 CFO David Reed로 세대교체가 이뤄졌습니다.</p>\n\n      <p><span class=\"fact-tag\">사실</span>2026년 1월(2025년 4분기) 콜에서 Fish는 그동안 습관처럼 붙이던 단어 하나를 뺐습니다. <q>\"우리는 경제를 낙관적으로 봅니다... '조심스럽게'라는 단어는 빼도 될 것 같습니다\"</q>라고 말하며, 23년 연속 배당 인상(+14.5%)과 30억 달러 규모 자사주 매입 재개를 발표했고 2026년을 \"수확의 해\"라 불렀습니다. 레버리지(순부채/EBITDA 추정)도 인수 직후 3.71배까지 치솟았던 것이 3.1배까지 낮아졌습니다. 다만 가장 최근인 2026년 4월 콜에서는 다시 한번 신중한 태도가 엿보입니다 — Fish는 \"올해 가이던스를 달성할지는 모릅니다. 2분기 끝나고 다시 점검하겠습니다\"라며 물량(volume) 관련해서는 유보적으로 답했습니다. 완전한 승리 선언에는 아직 한 발 못 미친 셈입니다.</p>\n\n      <p><span class=\"interp-tag\">해석</span>제가 보기엔 이건 \"원칙을 어긴 예외적 베팅\"이 아직 최종 판정을 받지 못한 이야기입니다. 회사는 스스로 세운 신중한 M&amp;A 원칙(비싼 멀티플 회피)을 깨고 역대 최대 규모의 인수를 감행했고, 시장에 그 정당성을 계속 숫자로 증명해야 하는 입장에 놓였습니다. 분기마다 시너지 목표를 올려 잡는 패턴은 통합이 잘되고 있다는 좋은 신호일 수도 있지만, 뒤집어 보면 처음부터 목표를 너무 낮게 잡아 놓고 매번 \"초과 달성\"처럼 보이게 만드는 습관(2023년에도 이미 있었던 패턴 — 아래 가이던스 성적표 참고)일 수도 있습니다. Healthcare Solutions이 실제로 흑자 전환하는 시점, 그리고 2026년 하반기 물량 회복 여부가 이 스토리의 진짜 결말을 가를 것입니다.</p>\n    </div>\n  </section>\n\n  <!-- 타임라인 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-icon\">🕐</span><span class=\"sec-title\">타임라인</span></div>\n    <div class=\"timeline-wrap\">\n      <svg viewBox=\"0 0 720 210\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"62.0\" y1=\"105\" x2=\"658.0\" y2=\"105\" stroke=\"var(--rule-strong)\" stroke-width=\"1.5\"/><circle cx=\"62.0\" cy=\"105\" r=\"5.5\" fill=\"var(--bg)\" stroke=\"var(--accent)\" stroke-width=\"2.4\"/><text x=\"62.0\" y=\"131\" text-anchor=\"middle\" font-family=\"IBM Plex Mono, monospace\" font-size=\"11\" font-weight=\"600\" fill=\"var(--accent)\">2024.04</text><text x=\"62.0\" y=\"147\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">\"M&A는 소형 tuck-in만\"</text><text x=\"62.0\" y=\"162\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">재확인 (Q1’24 콜)</text><circle cx=\"211.0\" cy=\"105\" r=\"7\" fill=\"var(--bg)\" stroke=\"var(--warn)\" stroke-width=\"2.4\"/><text x=\"211.0\" y=\"59\" text-anchor=\"middle\" font-family=\"IBM Plex Mono, monospace\" font-size=\"11\" font-weight=\"600\" fill=\"var(--warn)\">2024.06</text><text x=\"211.0\" y=\"75\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">Stericycle</text><text x=\"211.0\" y=\"89\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">$7.2B 인수 발표</text><circle cx=\"360.0\" cy=\"105\" r=\"5.5\" fill=\"var(--bg)\" stroke=\"var(--accent)\" stroke-width=\"2.4\"/><text x=\"360.0\" y=\"131\" text-anchor=\"middle\" font-family=\"IBM Plex Mono, monospace\" font-size=\"11\" font-weight=\"600\" fill=\"var(--accent)\">2024.11</text><text x=\"360.0\" y=\"147\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">인수 종결 ·</text><text x=\"360.0\" y=\"162\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">5번째 세그먼트 신설</text><circle cx=\"509.0\" cy=\"105\" r=\"5.5\" fill=\"var(--bg)\" stroke=\"var(--accent)\" stroke-width=\"2.4\"/><text x=\"509.0\" y=\"59\" text-anchor=\"middle\" font-family=\"IBM Plex Mono, monospace\" font-size=\"11\" font-weight=\"600\" fill=\"var(--accent)\">2025.10</text><text x=\"509.0\" y=\"75\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">23년 CFO</text><text x=\"509.0\" y=\"89\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">Devina Rankin 은퇴</text><circle cx=\"658.0\" cy=\"105\" r=\"5.5\" fill=\"var(--bg)\" stroke=\"var(--accent)\" stroke-width=\"2.4\"/><text x=\"658.0\" y=\"131\" text-anchor=\"middle\" font-family=\"IBM Plex Mono, monospace\" font-size=\"11\" font-weight=\"600\" fill=\"var(--accent)\">2026.01</text><text x=\"658.0\" y=\"147\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">배당 23년 연속 인상 ·</text><text x=\"658.0\" y=\"162\" text-anchor=\"middle\" font-family=\"IBM Plex Sans KR, sans-serif\" font-size=\"11\" fill=\"var(--ink-soft)\">자사주 매입 재개</text></svg>\n    </div>\n  </section>\n\n  <!-- 근거1: 공시 문장 변화 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-icon\">🔍</span><span class=\"sec-title\">근거 1 — 공시 문장이 조용히 바뀐 세 지점</span></div>\n\n    <div class=\"diff-block\">\n      <div class=\"diff-label\">① 사업부문 — 4개 → 5개</div>\n      <div class=\"diff-pair\">\n        <div class=\"diff-old\">\n          <b>10-K FY2023</b> (2024.2.13 제출)<br>\"...senior management now evaluates... through <b>four</b> reportable segments, referred to as (i) East Tier; (ii) West Tier; (iii) Recycling Processing and Sales and (iv) WM Renewable Energy.\"\n          <div class=\"diff-src\">출처: 10-K FY2023, p.5</div>\n        </div>\n        <div class=\"diff-new\">\n          <b>10-K FY2024</b> (2025.2.19 제출)<br>\"...evaluates... through <b>five</b> reportable segments... (v) <b>WM Healthcare Solutions</b>.\" — Stericycle 인수로 신설\n          <div class=\"diff-src\">출처: 10-K FY2024, p.6–7</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"diff-block\">\n      <div class=\"diff-label\">② 부채 위험요인 문구 — \"질 수도 있다\" → \"이미 졌고, 앞으로도\"</div>\n      <div class=\"diff-pair\">\n        <div class=\"diff-old\">\n          <b>10-K FY2023</b> · 위험요인 11번째 항목<br>\"Execution of our strategy, including growth through acquisitions... <b>may cause</b> us to incur substantial additional indebtedness...\"\n          <div class=\"diff-src\">출처: 10-K FY2023, p.20</div>\n        </div>\n        <div class=\"diff-new\">\n          <b>10-K FY2024</b> · 위험요인 7번째 항목 (순위 상승)<br>\"...growth through acquisitions, <b>such as our recent Stericycle acquisition</b>... <b>has caused, and may in the future, cause</b> us to incur substantial additional indebtedness...\"\n          <div class=\"diff-src\">출처: 10-K FY2024, p.25</div>\n        </div>\n      </div>\n      <div class=\"diff-note\">가정형(may)이 기정사실(has caused)로 바뀌었을 뿐 아니라, 위험요인 목록에서의 순위도 11번째에서 7번째로 앞당겨졌습니다 — 회사 법무팀이 이 리스크를 더 심각하게 보기 시작했다는 신호입니다.</div>\n    </div>\n\n    <div class=\"diff-block\">\n      <div class=\"diff-label\">③ 감사인이 지정한 \"특히 복잡한 판단\" 항목 — 1개 → 3개</div>\n      <div class=\"pill-row\">\n        <span class=\"pill\">FY2023: 매립지 감가상각 <b>1개</b></span>\n        <span class=\"pill\">FY2024: 매립지 감가상각 <b>1개</b> (인수 종결 직후에도 변화 없음)</span>\n        <span class=\"pill growing\">FY2025: 매립지 감가상각 + 매립지 캐핑·폐쇄 + <b>Healthcare Solutions 영업권 손상</b> = <b>3개</b></span>\n      </div>\n      <div class=\"diff-note\">흥미로운 점은 인수를 마친 FY2024 10-K에는 아직 변화가 없었다는 것입니다. 감사인이 Healthcare Solutions의 영업권 손상 위험을 별도 항목으로 지정한 건 인수 <b>1년이 지난</b> FY2025 10-K부터입니다 — 통합 초기보다 오히려 2년 차에 회계적 불확실성이 커졌다는 뜻입니다.</div>\n      <div class=\"diff-src\">출처: 10-K FY2023 p.72 · 10-K FY2024 p.80 · 10-K FY2025 p.73 (감사보고서 – 핵심감사사항)</div>\n    </div>\n  </section>\n\n  <!-- 근거2: 톤 변화 -->\n  <section>\n    <div class=\"sec-head\"><span class=\"sec-icon\">🔍</span><span class=\"sec-title\">근거 2 — 12분기 경영진 자신감 곡선</span></div>\n    <div class=\"chart-card\">\n      <svg viewBox=\"0 0 720 320\" class=\"tonechart\"><line x1=\"34\" y1=\"259.1\" x2=\"686\" y2=\"259.1\" stroke=\"var(--rule)\" stroke-width=\"1\" stroke-dasharray=\"2,3\"/><text x=\"24\" y=\"262.1\" text-anchor=\"end\" class=\"axislab\">6</text><line x1=\"34\" y1=\"217.3\" x2=\"686\" y2=\"217.3\" stroke=\"var(--rule)\" stroke-width=\"1\" stroke-dasharray=\"2,3\"/><text x=\"24\" y=\"220.3\" text-anchor=\"end\" class=\"axislab\">7</text><line x1=\"34\" y1=\"175.6\" x2=\"686\" y2=\"175.6\" stroke=\"var(--rule)\" stroke-width=\"1\" stroke-dasharray=\"2,3\"/><text x=\"24\" y=\"178.6\" text-anchor=\"end\" class=\"axislab\">8</text><line x1=\"34\" y1=\"133.8\" x2=\"686\" y2=\"133.8\" stroke=\"var(--rule)\" stroke-width=\"1\" stroke-dasharray=\"2,3\"/><text x=\"24\" y=\"136.8\" text-anchor=\"end\" class=\"axislab\">9</text><line x1=\"34\" y1=\"92.0\" x2=\"686\" y2=\"92.0\" stroke=\"var(--rule)\" stroke-width=\"1\" stroke-dasharray=\"2,3\"/><text x=\"24\" y=\"95.0\" text-anchor=\"end\" class=\"axislab\">10</text><line x1=\"271.1\" y1=\"86\" x2=\"271.1\" y2=\"286\" stroke=\"var(--warn)\" stroke-width=\"1\" stroke-dasharray=\"3,3\" opacity=\"0.55\"/><line x1=\"389.6\" y1=\"86\" x2=\"389.6\" y2=\"286\" stroke=\"var(--warn)\" stroke-width=\"1\" stroke-dasharray=\"3,3\" opacity=\"0.55\"/><line x1=\"567.5\" y1=\"86\" x2=\"567.5\" y2=\"286\" stroke=\"var(--warn)\" stroke-width=\"1\" stroke-dasharray=\"3,3\" opacity=\"0.55\"/><line x1=\"626.7\" y1=\"86\" x2=\"626.7\" y2=\"286\" stroke=\"var(--warn)\" stroke-width=\"1\" stroke-dasharray=\"3,3\" opacity=\"0.55\"/><path d=\"M 34.0,280.0 L 34.0,217.3 L 93.3,2
{"html":"<div class=\"kr-card\"><style>.kr-card{\n    color-scheme: light;\n    --bg: #fbfbf9;\n    --surface: #ffffff;\n    --surface-2: #f2f1ec;\n    --border: #e2e0d8;\n    --text: #17181a;\n    --text-2: #55564f;\n    --text-3: #86867c;\n    --accent: #1d5aa8;\n    --accent-soft: #e7eefb;\n    --series-1: #2a78d6;\n    --series-2: #c9752c;\n    --good: #0ca30c;\n    --warning: #b8791f;\n    --critical: #c23b3b;\n    --critical-soft: #fbebea;\n    --good-soft: #eaf7ea;\n    --shadow: 0 1px 2px rgba(20,20,15,.04), 0 8px 24px -12px rgba(20,20,15,.12);\n  }\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n      color-scheme: dark;\n      --bg: #17181a; --surface: #1e2023; --surface-2: #26282b; --border: #34363a;\n      --text: #f3f3f0; --text-2: #c3c2b7; --text-3: #8b8c85;\n      --accent: #5f9beb; --accent-soft: #223650;\n      --series-1: #3987e5; --series-2: #e08a45;\n      --good: #34c759; --warning: #f0ad3d; --critical: #e66767;\n      --critical-soft: #3a2323; --good-soft: #1e3324;\n      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);\n    }\n}\n:root[data-theme=\"dark\"] .kr-card{\n    color-scheme: dark;\n    --bg: #17181a; --surface: #1e2023; --surface-2: #26282b; --border: #34363a;\n    --text: #f3f3f0; --text-2: #c3c2b7; --text-3: #8b8c85;\n    --accent: #5f9beb; --accent-soft: #223650;\n    --series-1: #3987e5; --series-2: #e08a45;\n    --good: #34c759; --warning: #f0ad3d; --critical: #e66767;\n    --critical-soft: #3a2323; --good-soft: #1e3324;\n    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);\n  }\n.kr-card *{box-sizing:border-box;}\n.kr-card{ margin:0; background:var(--bg); color:var(--text); font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; -webkit-font-smoothing:antialiased; }\n.kr-card .wrap{ max-width: 760px; margin:0 auto; padding: 48px 24px 100px; }\n.kr-card h2, .kr-card h2, .kr-card h3{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-weight:600; text-wrap:balance; margin:0; }\n.kr-card .eyebrow{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; letter-spacing:.08em; color:var(--accent);\n    font-weight:600; text-transform:uppercase; margin-bottom:14px;\n  }\n.kr-card h2.title{ font-size:36px; line-height:1.2; margin-bottom:14px; }\n.kr-card .dek{ font-size:16.5px; color:var(--text-2); line-height:1.6; max-width:60ch; }\n.kr-card .meta{ display:flex; flex-wrap:wrap; gap:18px; margin-top:22px; padding-top:16px; border-top:1px solid var(--border); font-size:12px; color:var(--text-3); font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace;}\n.kr-card .oneliner{\n    background:var(--accent-soft); border-radius:14px; padding:22px 26px; margin-top:32px;\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-size:19px; line-height:1.55; font-weight:600; color:var(--text);\n  }\n.kr-card .oneliner .lbl{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10.5px; letter-spacing:.08em; color:var(--accent); font-weight:700; margin-bottom:8px; text-transform:uppercase; }\n.kr-card section{ margin-top:56px; }\n.kr-card .sec-label{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px; letter-spacing:.08em; color:var(--text-3);\n    text-transform:uppercase; font-weight:600; margin-bottom:10px;\n  }\n.kr-card .sec-title{ font-size:23px; margin-bottom:22px; }\n.kr-card .story p{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-size:18px; line-height:1.85; color:var(--text); margin:0 0 22px; }\n.kr-card .story p:first-of-type::first-letter{\n    font-size:52px; font-weight:700; float:left; line-height:0.85; padding:6px 8px 0 0; color:var(--accent);\n  }\n.kr-card .story .fact{ color:var(--text); }\n.kr-card .story .interp{ color:var(--text-2); font-style:italic; }\n.kr-card .tag-fact{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10px; background:var(--surface-2); color:var(--text-2); padding:1px 6px; border-radius:4px; margin-right:5px; vertical-align:2px; letter-spacing:.03em;}\n.kr-card .tag-interp{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10px; background:var(--accent-soft); color:var(--accent); padding:1px 6px; border-radius:4px; margin-right:5px; vertical-align:2px; letter-spacing:.03em;}\n.kr-card blockquote{\n    margin:26px 0; padding:4px 0 4px 20px; border-left:3px solid var(--accent);\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:13px; color:var(--text-2); line-height:1.7;\n  }\n.kr-card blockquote .kr{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:14.5px; color:var(--text); margin-top:6px; }\n.kr-card blockquote .cite{ font-size:11px; color:var(--text-3); margin-top:6px; }\n.kr-card .card{ background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:22px 24px; box-shadow:var(--shadow); }\n.kr-card .card + .card{ margin-top:16px; }\n.kr-card .quote-pair{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:14px;}\n@media (max-width:640px){.kr-card .quote-pair{ grid-template-columns:1fr; }\n}\n.kr-card .qbox{ background:var(--surface-2); border-radius:10px; padding:14px 16px; }\n.kr-card .qbox .yr{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px; color:var(--text-3); font-weight:600; margin-bottom:6px; }\n.kr-card .qbox p{ font-size:13px; line-height:1.6; color:var(--text); margin:0; }\n.kr-card .qbox.new{ border-left:3px solid var(--critical); }\n.kr-card .count-row{ display:flex; gap:10px; align-items:center; margin:10px 0; font-size:13.5px; }\n.kr-card .count-row .name{ width:120px; flex:none; color:var(--text-2); }\n.kr-card .count-bars{ display:flex; gap:6px; align-items:center; flex:1; }\n.kr-card .count-chip{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px; padding:3px 8px; border-radius:6px;\n    background:var(--surface-2); color:var(--text-2); border:1px solid var(--border);\n  }\n.kr-card .count-chip.up{ background: color-mix(in srgb, var(--critical) 12%, var(--surface)); color:var(--critical); border-color: color-mix(in srgb, var(--critical) 30%, var(--border)); }\n.kr-card .count-chip.down{ background: color-mix(in srgb, var(--good) 12%, var(--surface)); color:var(--good); border-color: color-mix(in srgb, var(--good) 30%, var(--border)); }\n.kr-card .count-arrow{ color:var(--text-3); font-size:12px; }\n.kr-card .src{ font-size:11.5px; color:var(--text-3); margin-top:10px; line-height:1.6; }\n.kr-card .src b{ color:var(--text-2); font-weight:500; }\n.kr-card .tone-chart svg{ display:block; width:100%; height:auto; }\n.kr-card .note-box{\n    background:var(--surface-2); border:1px dashed var(--border); border-radius:10px; padding:12px 14px;\n    font-size:12.5px; color:var(--text-2); margin-top:14px; line-height:1.6;\n  }\n.kr-card .tone-notes{ display:grid; gap:6px; margin-top:16px; font-size:12.5px; color:var(--text-2); }\n.kr-card .tone-notes .q{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; color:var(--text); font-weight:600; margin-right:6px; }\n.kr-card .gtable{ width:100%; border-collapse:collapse; font-size:13px; margin-top:12px; }\n.kr-card .gtable th, .kr-card .gtable td{ padding:10px 12px; border-bottom:1px solid var(--border); text-align:left; vertical-align:top; line-height:1.55;}\n.kr-card .gtable thead th{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10.5px; text-transform:uppercase; letter-spacing:.03em; color:var(--text-3); background:var(--surface-2); }\n.kr-card .verdict{ display:inline-flex; align-items:center; gap:5px; font-weight:700; font-size:12.5px; padding:3px 9px; border-radius:100px; }\n.kr-card .verdict.hit{ background:var(--good-soft); color:var(--good); }\n.kr-card .verdict.miss{ background:var(--critical-soft); color:var(--critical); }\n.kr-card .verdict.progress{ background:var(--surface-2); color:var(--text-2); }\n.kr-card .table-wrap{ overflow-x:auto; }\n.kr-card .timeline{ position:relative; margin-top:20px; padding-left:26px; }\n.kr-card .timeline::before{ content:\"\"; position:absolute; left:6px; top:6px; bottom:6px; width:2px; background:var(--border); }\n.kr-card .t-item{ position:relative; padding-bottom:26px; }\n.kr-card .t-item:last-child{ padding-bottom:0; }\n.kr-card .t-item::before{\n    content:\"\"; position:absolute; left:-26px; top:3px; width:11px; height:11px; border-radius:50%;\n    background:var(--accent); border:2px solid var(--surface);\n  }\n.kr-card .t-item.risk::before{ background:var(--critical); }\n.kr-card .t-date{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; color:var(--accent); font-weight:700; }\n.kr-card .t-item.risk .t-date{ color:var(--critical); }\n.kr-card .t-body{ font-size:14px; color:var(--text); margin-top:3px; line-height:1.55; }\n.kr-card .unknowns{ display:grid; gap:10px; margin-top:14px; }\n.kr-card .unknown-item{ padding:14px 16px; background:var(--surface); border:1px dashed var(--border); border-radius:10px; font-size:13.5px; color:var(--text-2); line-height:1.55; }\n.kr-card .unknown-item b{ color:var(--text); }\n.kr-card .filelist{ columns:2; column-gap:24px; font-size:13px; color:var(--text-2); line-height:2; margin-top:8px; }\n@media (max-width:560px){.kr-card .filelist{ columns:1; }\n}\n.kr-card .filelist li::marker{ color:var(--text-3); }\n.kr-card footer{ margin-top:60px; padding-top:20px; border-top:1px solid var(--border); font-size:11.5px; color:var(--text-3); line-height:1.8; }\n</style>\n\n<div class=\"wrap\">\n\n  <div class=\"eyebrow\">Company Story · 2023 — 2026</div>\n  <h2 class=\"title\">존슨앤드존슨, 지난 3년의 이야기</h2>\n  <p class=\"dek\">켄뷰(Kenvue) 분사 직후의 홀가분함에서, 공격적 인수합병으로 잠시 흔들린 이익, 그리고 신약 파이프라인이 터지며 되찾은 자신감까지 — 10-K 3개년(FY2023–FY2025)과 어닝콜 12분기(2023년 3분기–2026년 2분기)를 나란히 놓고 읽었습니다.</p>\n  <div class=\"meta\">\n    <span>10-K FY2023 · FY2024 · FY2025</span>\n    <span>어닝콜 12분기 (2023 Q3 – 2026 Q2)</span>\n    <span>DEF 14A 2026</span>\n    <span>작성 기준일 2026-08-28</span>\n  </div>\n\n  <div class=\"oneliner\">\n    <div class=\"lbl\">한 줄 요약</div>\n    지난 3년의 JNJ는 \"컨슈머헬스를 떼어내고(2023) → 그 여력으로 공격적으로 사들이며 단기 이익을 희생하고(2024) → 그 베팅이 신약 매출로 돌아오며 자신감을 되찾은(2025–2026)\" 회사이고, 지금은 그 다음 순서로 정형외과를 떼어내려 하고 있습니다.\n  </div>\n\n  <!-- STORY -->\n  <section class=\"story\">\n    <div class=\"sec-label\">Story</div>\n    <h2 class=\"sec-title\">📖 스토리</h2>\n\n    <p><span class=\"tag-fact\">사실</span>2023년 3분기, JNJ는 막 컨슈머헬스 사업부(존슨즈베이비, 타이레놀 등)를 켄뷰(Kenvue)로 떼어낸 직후였습니다. 그 분사 과정에서 켄뷰 주식과 자사주를 맞바꾸는 방식으로 유통주식 1.91억 주(약 7%)를 현금 한 푼 안 쓰고 줄였다고 자랑스럽게 이야기했습니다. 이때 어닝콜 톤은 안정적이었고, 회사는 스스로를 \"순수 제약 + 의료기기\" 회사로 재정의하는 이야기를 하고 있었습니다.</p>\n\n    <p><span class=\"tag-fact\">사실</span>그런데 2024년 한 해 동안 여러 역풍이 동시에 몰려왔습니다. 유럽에서 스텔라라 바이오시밀러가 진입했고, 중국은 정부 주도 약가 인하(VBP)와 반부패 캠페인으로 계속된 역풍이었으며, 비전(콘택트렌즈) 부문은 미국 유통재고 문제를, 심장 시술 기기(PFA)는 경쟁 심화를 겪었습니다. 설상가상으로 미국에서 출시한 심장부정맥 시술 기기 VARIPULSE에 대한 FDA 조사가 불거지며 2024년 4분기 어닝콜에서만 이 단어가 13번 언급됐습니다 — 그해 어느 분기보다 많은 횟수입니다. 실제로 이 시기 어닝콜에서 \"headwind(역풍)·challenging(어려운)·cautious(신중한)\" 같은 단어의 빈도는 2023년 말 대비 거의 두 배로 뛰었습니다.</p>\n\n    <p><span class=\"tag-fact\">사실</span>흥미로운 건 회사의 대응 방식입니다. 매 분기 경영진은 \"인수합병을 제외한 본업 실적 기준으로는 3분기 연속 가이던스를 상향했다\"고 강조했습니다. 실제로 2024년 한 해 동안 쇼크웨이브($13B), V-Wave, Yellow Jersey(NM26 항체) 등에 약 $18B를 썼고, 이 인수들의 희석 효과 때문에 연초 $10.55–10.75로 제시했던 조정 주당순이익(EPS) 가이던스는 3분기 만에 $9.93으로 계속 낮아졌습니다. 실제 2024년 결과는 $9.98 — 연초 목표보다 뚜렷이 낮았지만, 이건 사업이 못한 게 아니라 그 초과 실적을 M&amp;A에 재투자하기로 한 선택의 결과였습니다. 공시 문구에서도 변화가 보였습니다: 2023년 10-K에서 \"관세 변화 가능성\"이라는 한 줄짜리 가정문이던 문장이, 2024년 10-K에서는 중국·멕시코·캐나다를 구체적으로 지목하는 문단으로 커졌습니다.</p>\n\n    <p><span class=\"tag-fact\">사실</span>2025년 중반부터 분위기가 뚜렷하게 바뀌었습니다. 트렘피아의 염증성장질환(IBD) 신규 적응증, 카빅티·탈베이·텍베일리의 고성장, 새로 출시한 ICOTYDE의 초기 모멘텀이 스텔라라의 하락폭을 압도하기 시작했습니다. 긍정적 표현(\"confident·strong·record·momentum\" 등) 빈도는 분기당 1,000단어 기준 5~6회에서 9~10회로 거의 두 배가 됐고, 가이던스는 2025년 한 해 동안 여러 차례 상향됐습니다. 2025년 관세 관련 공시는 한 단계 더 나아가, 이제는 위험요인이 아니라 실제 매출원가 항목(\"관세·환율·거시경제 요인이 매출원가에 반영\")으로 등장했고, 2025년 10-K는 정형외과 사업부 분사 검토라는 완전히 새로운 문장을 처음 담았습니다. 2026년에도 이 상향 흐름은 이어져, 1분기와 2분기 연속으로 가이던스를 올리며 \"창사 140년 만에 최초로 연매출 $100B 돌파\"를 목표로 내걸었습니다 — 다만 2026년 2분기 콜에서는 관세 비용(연간 약 $500M, 전년 대비 크게 증가)과 메드텍 마진 압박이 다시 살짝 고개를 들었습니다.</p>\n\n    <p><span class=\"tag-interp\">해석</span>제가 보기엔 이건 \"일시적 위기\"의 이야기가 아니라 \"의도된 재편\"의 이야기입니다. JNJ는 2023년 몸집을 줄이고(켄뷰 분사), 2024년 그 여력으로 공격적으로 베팅하며 단기 이익을 희생했고, 2025~2026년 그 베팅이 신약 매출로 돌아오면서 자신감을 되찾았습니다. 2025년 10월 예고된 정형외과 분사는 같은 패턴의 반복처럼 보입니다 — 성장이 느린 사업을 떼어내고, 남은 회사를 고성장 자산에 더 집중시키는 전략입니다. 이 패턴이 계속된다면, 이제 관건은 스텔라라가 겪은 특허절벽이라는 실제 시험대를 다음 대형 신약(다잘렉스, 트렘피아)이 통과할 수 있을지입니다.</p>\n  </section>\n\n  <!-- EVIDENCE 1: filing diff -->\n  <section>\n    <div class=\"sec-label\">근거 1 · Filing Diff</div>\n    <h2 class=\"sec-title\">🔍 공시 문장은 이렇게 바뀌었습니다</h2>\n\n    <div class=\"card\">\n      <h3 style=\"font-size:14.5px; margin-bottom:4px;\">🆕 관세 리스크 — 가정문에서 실제 비용 항목으로</h3>\n      <p style=\"font-size:13px; color:var(--text-2); margin:0 0 8px;\">3개년 10-K를 나란히 놓고 보면, 같은 주제의 문장이 해가 갈수록 구체적이고 실체적으로 바뀌는 걸 볼 수 있습니다.</p>\n      <div class=\"quote-pair\">\n        <div class=\"qbox\">\n          <div class=\"yr\">FY2023 10-K</div>\n          <p>\"...including any increased trade restrictions or <b>tariffs</b> and potential drug reimportation legislation...\"</p>\n          <p style=\"margin-top:6px; color:var(--text-2);\">→ 위험요인 목록 속 한 줄짜리 가정문. 국가명도, 금액도 없음.</p>\n        </div>\n        <div class=\"qbox\">\n          <div class=\"yr\">FY2024 10-K</div>\n          <p>\"...the U.S. government recently announced <b>tariffs on products manufactured in several jurisdictions, including China, Mexico and Canada</b>...\"</p>\n          <p style=\"margin-top:6px; color:var(--text-2);\">→ 실제 발표된 정책으로, 국가명이 구체적으로 등장.</p>\n        </div>\n        <div class=\"qbox new\" style=\"grid-column:1/-1;\">\n          <div class=\"yr\">FY2025 10-K — MD&amp;A (실적 설명)</div>\n          <p>\"<b>Tariffs</b>, unfavorable transactional currency and macroeconomic factors <b>in Cost of products sold</b>\" — 메드텍 매출원가 상승 요인으로 명시</p>\n          <p style=\"margin-top:6px; color:var(--text-2);\">→ 이제 위험요인이 아니라 <b style=\"color:var(--text)\">실제로 마진을 깎아먹은 항목</b>으로 실적 설명에 등장. 2026년 가이던스는 메드텍 관세 비용을 연 $500M(전년 대비 대폭 증가)로 명시적으로 반영.</p>\n        </div>\n      </div>\n      <div class=\"src\">출처: 10-K FY2023 Item 1A 위험요인 · 10-K FY2024 p.13 · 10-K FY2025 p.29(MD&amp;A), p.35(2026 가이던스는 Earnings Call Q4 FY2025 별도)</div>\n    </div>\n\n    <div class=\"card\">\n      <h3 style=\"font-size:14.5px; margin-bottom:10px;\">문서 내 언급 횟수 변화 (10-K 전체 기준)</h3>\n      <div class=\"count-row\">\n        <div class=\"name\">정형외과 분사</div>\n        <div class=\"count-bars\">\n          <span class=\"count-chip\">FY23: 0</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip\">FY24: 0</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip up\">FY25: 7</span>\n        </div>\n      </div>\n      <div class=\"count-row\">\n        <div class=\"name\">관세(tariff)</div>\n        <div class=\"count-bars\">\n          <span class=\"count-chip\">FY23: 1</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip\">FY24: 3</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip up\">FY25: 6</span>\n        </div>\n      </div>\n      <div class=\"count-row\">\n        <div class=\"name\">스텔라라</div>\n        <div class=\"count-bars\">\n          <span class=\"count-chip\">FY23: 18</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip\">FY24: 18</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip up\">FY25: 22</span>\n        </div>\n      </div>\n      <div class=\"count-row\">\n        <div class=\"name\">켄뷰(Kenvue)</div>\n        <div class=\"count-bars\">\n          <span class=\"count-chip\">FY23: 71</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip\">FY24: 60</span><span class=\"count-arrow\">→</span>\n          <span class=\"count-chip down\">FY25: 50</span>\n        </div>\n      </div>\n      <p style=\"font-size:12.5px; color:var(--text-2); margin:12px 0 0; line-height:1.6;\">정형외과 분사는 FY2025 10-K에만 처음 등장한 완전히 새로운 주제입니다. 관세와 스텔라라는 해마다 언급이 꾸준히 늘며 위험도가 커지고 있다는 신호이고, 반대로 켄뷰는 2023년 분사 이후 언급이 계속 줄어들며 \"지나간 이야기\"가 되고 있습니다.</p>\n      <div class=\"src\">출처: 10-K FY2023 / FY2024 / FY2025 전문 텍스트 검색 (단순 언급 횟수 기준, 문맥 무관)</div>\n    </div>\n  </section>\n\n  <!-- EVIDENCE 2: tone -->\n  <section>\n    <div class=\"sec-label\">근거 2 · 어닝콜 톤</div>\n    <h2 class=\"sec-title\">📈 경영진 자신감 곡선 (12분기)</h2>\n    <p style=\"font-size:13.5px; color:var(--text-2); margin:-8px 0 18px;\">이 점수는 정량 지표가 아니라 표현 분석(확신 표현 · 역풍 표현의 빈도, Q&amp;A 답변 태도)에 기반한 상대적 추이입니다.</p>\n\n    <div class=\"card\">\n      <div class=\"tone-chart\">\n        <svg viewBox=\"0 0 720 260\" xmlns=\"http://www.w3.org/2000/svg\">\n          <style>.kr-card .grid-line{ stroke:var(--border); stroke-width:1; }\n.kr-card .tone-line{ fill:none; stroke:var(--accent); stroke-width:2.5; }\n.kr-card .tone-dot{ fill:var(--accent); }\n.kr-card .tone-dot.low{ fill:var(--critical); }\n.kr-card .tone-dot.high{ fill:var(--good); }\n.kr-card .qlabel{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10px; fill:var(--text-3); }\n.kr-card .ylabel{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10px; fill:var(--text-3); }\n.kr-card .eventlabel{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-size:10.5px; fill:var(--text-2); }\n</style>\n          <!-- gridlines at y for score 4,6,8,10 -->\n          <line class=\"grid-line\" x1=\"40\" y1=\"200\" x2=\"700\" y2=\"200\"/>\n          <line class=\"grid-line\" x1=\"40\" y1=\"140\" x2=\"700\" y2=\"140\"/>\n          <line class=\"grid-line\" x1=\"40\" y1=\"80\" x2=\"700\" y2=\"80\"/>\n          <line class=\"grid-line\" x1=\"40\" y1=\"20\" x2=\"700\" y2=\"20\"/>\n          <text class=\"ylabel\" x=\"10\" y=\"204\">4</text>\n          <text class=\"ylabel\" x=\"10\" y=\"144\">6</text>\n          <text class=\"ylabel\" x=\"10\" y=\"84\">8</text>\n          <text class=\"ylabel\" x=\"4\" y=\"24\">10</text>\n\n          <!-- x positions for 12 quarters, spaced 60px apart starting x=60 -->\n          <!-- score->y: y = 260 - score*24 (score4->164? let's recompute) actually use y=230-  score*21-ish. We'll define mapping score(4..10)-> y(200..20): y = 200 - (score-4)*30 -->\n          <!-- Q3FY23:6.5 Q4FY23:6.5 Q1FY24:6.5 Q2FY24:5.5 Q3FY24:5.5 Q4FY24:5.0 Q1FY25:5.5 Q2FY25:7.5 Q3FY25:8.5 Q4FY25:9.0 Q1FY26:9.0 Q2FY26:8.0 -->\n          <polyline class=\"tone-line\" points=\"\n            60,125\n            120,125\n            180,125\n            240,155\n            300,155\n            360,170\n            420,155\n            480,95\n            540,65\n            600,50\n            660,50\n            700,80\n          \"/>\n          <circle class=\"tone-dot\" cx=\"60\" cy=\"125\" r=\"4\"/>\n          <circle class=\"tone-dot\" cx=\"120\" cy=\"125\" r=\"4\"/>\n          <circle class=\"tone-dot\" cx=\"180\" cy=\"125\" r=\"4\"/>\n          <circle class=\"tone-dot\" cx=\"240\" cy=\"155\" r=\"4\"/>\n          <circle class=\"tone-dot\" cx=\"300\" cy=\"155\" r=\"4\"/>\n          <circle class=\"tone-dot low\" cx=\"360\" cy=\"170\" r=\"5\"/>\n          <circle class=\"tone-dot\" cx=\"420\" cy=\"155\" r=\"4\"/>\n          <circle class=\"tone-dot\" cx=\"480\" cy=\"95\" r=\"4\"/>\n          <circle class=\"tone-dot\" cx=\"540\" cy=\"65\" r=\"4\"/>\n          <circle class=\"tone-dot high\" cx=\"600\" cy=\"50\" r=\"5\"/>\n          <circle class=\"tone-dot high\" cx=\"660\" cy=\"50\" r=\"5\"/>\n          <circle class=\"tone-dot\" cx=\"700\" cy=\"80\" r=\"4\"/>\n\n          <text class=\"qlabel\" x=\"60\" y=\"222\" text-anchor=\"middle\">23·Q3</text>\n          <text class=\"qlabel\" x=\"120\" y=\"222\" text-anchor=\"middle\">23·Q4</text>\n          <text class=\"qlabel\" x=\"180\" y=\"222\" text-anchor=\"middle\">24·Q1</text>\n          <text class=\"qlabel\" x=\"240\" y=\"222\" text-anchor=\"middle\">24·Q2</text>\n          <text class=\"qlabel\" x=\"300\" y=\"222\" text-anchor=\"middle\">24·Q3</text>\n          <text class=\"qlabel\" x=\"360\" y=\"222\" text-anchor=\"middle\">24·Q4</text>\n          <text class=\"qlabel\" x=\"420\" y=\"222\" text-anchor=\"middle\">25·Q1</text>\n          <text class=\"qlabel\" x=\"480\" y=\"222\" text-anchor=\"middle\">25·Q2</text>\n          <text class=\"qlabel\" x=\"540\" y=\"222\" text-anchor=\"middle\">25·Q3</text>\n          <text class=\"qlabel\" x=\"600\" y=\"222\" text-anchor=\"middle\">25·Q4</text>\n          <text class=\"qlabel\" x=\"660\" y=\"222\" text-anchor=\"middle\">26·Q1</text>\n          <text class=\"qlabel\" x=\"700\" y=\"222\" text-anchor=\"middle\" style=\"font-size:9px;\">26·Q2</text>\n\n          <text class=\"eventlabel\" x=\"360\" y=\"190\" text-anchor=\"middle\" style=\"fill:var(--critical);\">← 톤 저점</text>\n          <text class=\"eventlabel\" x=\"600\" y=\"34\" text-anchor=\"middle\" style=\"fill:var(--good);\">\"역대 최강 파이프라인\" →</text>\n        </svg>\n      </div>\n      <div class=\"tone-notes\">\n        <div><span class=\"q\">23·Q3–24·Q1</span>안정적 기준선. 켄뷰 분사 직후, 큰 잡음 없음.</div>\n        <div><span class=\"q\">24·Q2–Q3</span>스텔라라 유럽 침식, 중국 역풍, Vision 유통재고 문제 겹치며 \"headwind·challenge\" 빈도 상승.</div>\n        <div><span class=\"q\">24·Q4 (저점)</span>VARIPULSE 미국 조사 언급이 13회로 정점. 조정 EPS 가이던스도 연초 대비 하향된 채 마감.</div>\n        <div><span class=\"q\">25·Q1</span>중국·Part D 재설계 부담이 반복 언급되며 여전히 조심스러운 톤.</div>\n        <div><span class=\"q\">25·Q2–Q4 (반등)</span>트렘피아·카빅티 등 신제품 고성장이 스텔라라 하락을 압도. 가이던스 연속 상향, \"confident·record·momentum\" 빈도 거의 2배.</div>\n        <div><span class=\"q\">26·Q1–Q2</span>고자신감 유지 속, 관세·메드텍 마진 압박이 다시 소폭 언급되며 살짝 조정.</div>\n      </div>\n      <div class=\"src\">출처: 어닝콜 트랜스크립트(roic.ai) 2023 Q3 – 2026 Q2, 전 12분기. 긍정/부정 표현 빈도(1,000단어당) 및 정성적 맥락 종합.</div>\n    </div>\n  </section>\n\n  <!-- EVIDENCE 3: guidance scorecard -->\n  <section>\n    <div class=\"sec-label\">근거 3 · 가이던스 성적표</div>\n    <h2 class=\"sec-title\">🎯 약속한 것 vs 실제로 한 것</h2>\n\n    <div class=\"card\">\n      <div class=\"table-wrap\">\n        <table class=\"gtable\">\n          <thead><tr><th>회계연도</th><th>최초 가이던스 (연초)</th><th>연중 변화</th><th>실제 결과</th><th>판정</th></tr></thead>\n          <tbody>\n            <tr>\n              <td><b>FY2024</b></td>\n              <td>매출 5–6%($88.2–89.0B)<br>조정EPS $10.55–10.75(+7.4%)</td>\n              <td>1분기 소폭 상향($10.68) → 2분기 쇼크웨이브 등 인수 희석으로 $10–10.10 → 3분기 V-Wave 추가 희석으로 $9.93 최종치<br><span style=\"color:var(--text-3);\">(단, \"M&amp;A 제외 기준\"으로는 3분기 연속 상향)</span></td>\n              <td>매출 $88.8B<br>조정EPS $9.98</td>\n              <td>\n                <span class=\"verdict hit\">매출 ✓</span> <span class=\"verdict miss\">EPS ✗</span>\n              </td>\n            </tr>\n            <tr>\n              <td><b>FY2025</b></td>\n              <td>매출(보고기준) 중간값 $89.6B<br>조정EPS $10.75–10.95(+8.7%)<br><span style=\"color:var(--text-3);\">(인트라셀룰러 인수 제외 기준)</span></td>\n              <td>2분기 $2B/EPS 상향, 3분기 $0.3B 추가 상향 등 연중 수차례 상향</td>\n              <td>매출 $94.2B<br>조정EPS $10.79(+8.1%)</td>\n              <td>\n                <span class=\"verdict hit\">매출 ✓✓</span> <span class=\"verdict hit\">EPS ✓</span>\n              </td>\n            </tr>\n            <tr>\n              <td><b>FY2026</b><br><span style=\"font-size:11px; color:var(--text-3);\">(진행중)</span></td>\n              <td>매출(보고기준) 중간값 $100.5B<br>조정EPS $11.28–11.48</td>\n              <td>1분기 상향(매출 중간값 $100.8B) → 2분기 추가 상향(매출 중간값 $100.6B, 환율 재조정 반영)</td>\n              <td>확인 필요<br><span style=\"color:var(--text-3);\">(연도 진행중)</span></td>\n              <td><span class=\"verdict progress\">진행중 — 2분기 연속 상향</span></td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p style=\"font-size:12.5px; color:var(--text-2); margin:14px 0 0; line-height:1.6;\">\n        패턴이 뚜렷합니다: <b style=\"color:var(--text)\">JNJ의 본업 실적은 거의 항상 스스로의 목표를 초과 달성</b>합니다. 2024년의 EPS \"미달\"은 사업 부진이 아니라, 초과 달성분을 M&amp;A에 재투자하기로 한 경영진의 선택 때문이었습니다.\n      </p>\n      <div class=\"src\">출처: Earnings Call Q4 FY2023(FY24 최초 가이던스) · Q1–Q4 FY2024 · Q4 FY2024(FY25 최초 가이던스) · Q1–Q4 FY2025 · Q4 FY2025(FY26 최초 가이던스) · Q1–Q2 FY2026</div>\n    </div>\n  </section>\n\n  <!-- TIMELINE -->\n  <section>\n    <div class=\"sec-label\">타임라인</div>\n    <h2 class=\"sec-title\">🗓️ 지난 3년의 변곡점</h2>\n    <div class=\"timeline\">\n      <div class=\"t-item\"><div class=\"t-date\">2023.08</div><div class=\"t-body\">컨슈머헬스 사업부 켄뷰(Kenvue) 분사 완료 — 주식-채권 교환으로 유통주식 1.91억 주(약 7%) 소각</div></div>\n      <div class=\"t-item risk\"><div class=\"t-date\">2023–2024</div><div class=\"t-body\">탈크 소송 관련 파산 신청(LTL) 두 차례 모두 법원에서 기각</div></div>\n      <div class=\"t-item\"><div class=\"t-date\">2024</div><div class=\"t-body\">쇼크웨이브($13B 안팎), V-Wave, Yellow Jersey(NM26) 등 약 $18B 규모 공격적 인수 — 단기 EPS 희석 감수</div></div>\n      <div class=\"t-item risk\"><div class=\"t-date\">2024.09</div><div class=\"t-body\">탈크 자회사 Red River, 텍사스에서 새 파산 신청(\"사전조율형\" 합의안 추진)</div></div>\n      <div class=\"t-item risk\"><div class=\"t-date\">2024 Q4</div><div class=\"t-body\">VARIPULSE(심장 시술 기기) 미국 조사 이슈, 어닝콜 언급 정점(13회)</div></div>\n      <div class=\"t-item\"><div class=\"t-date\">2025.04</div><div class=\"t-body\">인트라셀룰러 테라퓨틱스 인수 완료 (약 $14.5B, CAPLYTA 확보)</div></div>\n      <div class=\"t-item\"><div class=\"t-date\">2025 Q1</div><div class=\"t-body\">탈크 소송 준비금 약 $7.0B 환입 — 회계상 순이익 급증의 핵심 원인</div></div>\n      <div class=\"t-item risk\"><div class=\"t-date\">2025.07</div><div class=\"t-body\">탈크 텍사스 소송 기각, 일반 법정 소송(MDL)으로 복귀</div></div>\n      <div class=\"t-item\"><div class=\"t-date\">2025.10</div><div class=\"t-body\">정형외과(Orthopaedics) 사업부 분사 검토 발표 — 18~24개월 내 완료 목표</div></div>\n      <div class=\"t-item\"><div class=\"t-date\">2026.07</div><div class=\"t-body\">2분기 실적서 가이던스 재상향, \"창사 140년 만에 최초 매출 $100B\" 목표 재확인. Firefly Bio 인수 발표(3분기 종료 예정)</div></div>\n    </div>\n  </section>\n\n  <!-- UNKNOWNS -->\n  <section>\n    <div class=\"sec-label\">한계</div>\n    <h2 class=\"sec-title\">❓ 아직 모르는 것</h2>\n    <div class=\"unknowns\">\n      <div class=\"unknown-item\"><b>VARIPULSE 조사가 실제로 어떻게 마무리됐는지.</b> 2024년 4분기 13회 언급 이후 2025년부터 언급이 1~2회로 급감했는데, 이게 \"문제 없이 해결\"된 건지 \"회사가 더 이상 자세히 언급하지 않기로 한\" 건지는 이 자료만으로 단정할 수 없습니다.</div>\n      <div class=\"unknown-item\"><b>정형외과 분사가 스핀오프인지 매각인지, 밸류에이션은 얼마인지.</b> 2025년 10월 발표 이후 구체적 구조가 아직 공개되지 않았습니다.</div>\n      <div class=\"unknown-item\"><b>2026년 가이던스 상향 흐름이 하반기에도 이어질지.</b> 관세와 메드텍 마진 압박이 2분기 콜부터 다시 언급되기 시작한 만큼, 3~4분기 콜을 확인해야 추세를 판단할 수 있습니다.</div>\n    </div>\n  </section>\n\n  <!-- SOURCES -->\n  <section>\n    <div class=\"sec-label\">사용한 자료 전체</div>\n    <h2 class=\"sec-title\">📎 자료 목록</h2>\n    <ul class=\"filelist\">\n      <li>10-K FY2023 (2024-02-16 제출)</li>\n      <li>10-K FY2024 (2025-02-13 제출)</li>\n      <li>10-K FY2025 (2026-02-11 제출)</li>\n      <li>DEF 14A 2026 (Proxy)</li>\n      <li>어닝콜 2023 Q3</li>\n      <li>어닝콜 2023 Q4</li>\n      <li>어닝콜 2024 Q1</li>\n      <li>어닝콜 2024 Q2</li>\n      <li>어닝콜 2024 Q3</li>\n      <li>어닝콜 2024 Q4</li>\n      <li>어닝콜 2025 Q1</li>\n      <li>어닝콜 2025 Q2</li>\n      <li>어닝콜 2025 Q3</li>\n      <li>어닝콜 2025 Q4</li>\n      <li>어닝콜 2026 Q1</li>\n      <li>어닝콜 2026 Q2</li>\n    </ul>\n  </section>\n\n  <footer>\n    이 리포트는 업로드하신 JNJ SEC 공시자료(10-K 3개년, DEF 14A)와 어닝콜 트랜스크립트 12분기를 근거로 작성했습니다. 톤 점수는 정성적 판단이며 투자 자문이 아닙니다. 투자 판단은 본인 책임입니다.\n  </footer>\n\n</div></div>","scripts":[],"ext":[],"lede":""}
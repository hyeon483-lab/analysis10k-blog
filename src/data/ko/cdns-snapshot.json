{"html":"<div class=\"kr-card\"><style>.kr-card{\n    --bg: #F5F3EC;\n    --bg-raised: #FBFAF6;\n    --ink: #171E27;\n    --ink-soft: #565F6B;\n    --ink-faint: #8B8F86;\n    --line: #DCD6C4;\n    --line-strong: #C7C0A9;\n    --accent: #B2622A;\n    --accent-soft: #E7DCC9;\n    --trace: #33587E;\n    --trace-soft: #DCE4EA;\n    --risk: #954138;\n    --risk-soft: #F0DCD6;\n    --good: #33587E;\n    --shadow: rgba(23,30,39,0.08);\n  }\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]) .kr-card{\n      --bg: #14181D;\n      --bg-raised: #1B2027;\n      --ink: #ECE8DD;\n      --ink-soft: #A9AEA0;\n      --ink-faint: #767C74;\n      --line: #333B44;\n      --line-strong: #454F59;\n      --accent: #E08A46;\n      --accent-soft: #3A2E22;\n      --trace: #7FAAD1;\n      --trace-soft: #202C38;\n      --risk: #D9847A;\n      --risk-soft: #3A2523;\n      --good: #7FAAD1;\n      --shadow: rgba(0,0,0,0.35);\n    }\n}\n:root[data-theme=\"dark\"] .kr-card{\n    --bg: #14181D;\n    --bg-raised: #1B2027;\n    --ink: #ECE8DD;\n    --ink-soft: #A9AEA0;\n    --ink-faint: #767C74;\n    --line: #333B44;\n    --line-strong: #454F59;\n    --accent: #E08A46;\n    --accent-soft: #3A2E22;\n    --trace: #7FAAD1;\n    --trace-soft: #202C38;\n    --risk: #D9847A;\n    --risk-soft: #3A2523;\n    --good: #7FAAD1;\n    --shadow: rgba(0,0,0,0.35);\n  }\n.kr-card *{box-sizing:border-box;}\n.kr-card, .kr-card{margin:0;padding:0;}\n.kr-card{\n    background:var(--bg);\n    color:var(--ink);\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif;\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n.kr-card ::selection{ background:var(--accent-soft); }\n.kr-card .sheet{\n    max-width:880px;\n    margin:0 auto;\n    padding:0 20px 80px;\n  }\n.kr-card .num{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-variant-numeric: tabular-nums; }\n.kr-card .head{\n    display:flex; justify-content:space-between; align-items:flex-end;\n    gap:16px; flex-wrap:wrap;\n    padding:28px 0 18px;\n    border-bottom:2px solid var(--ink);\n  }\n.kr-card .head-left .tag{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12px; letter-spacing:0.12em;\n    color:var(--ink-faint); text-transform:uppercase;\n  }\n.kr-card .head-left h2{\n    margin:4px 0 6px; font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-weight:700;\n    font-size:clamp(28px,5vw,38px); letter-spacing:-0.01em; text-wrap:balance;\n  }\n.kr-card .head-left .sub{ color:var(--ink-soft); font-size:14.5px; }\n.kr-card .head-right{ text-align:right; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12.5px; color:var(--ink-soft); }\n.kr-card .head-right .price{ font-size:22px; color:var(--ink); font-weight:600; }\n.kr-card .badge{\n    display:inline-block; margin-top:22px; padding:5px 10px;\n    border:1px solid var(--line-strong); border-radius:3px;\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; color:var(--ink-soft);\n    background:var(--bg-raised);\n  }\n.kr-card section{ padding:34px 0; border-bottom:1px solid var(--line); }\n.kr-card section:last-of-type{ border-bottom:none; }\n.kr-card .eyebrow{\n    display:flex; align-items:center; gap:10px; margin-bottom:14px;\n  }\n.kr-card .eyebrow .n{\n    width:26px; height:26px; border-radius:50%; border:1.5px solid var(--ink);\n    display:flex; align-items:center; justify-content:center;\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12px; font-weight:600; flex:none;\n  }\n.kr-card .eyebrow .t{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12px; letter-spacing:0.1em;\n    text-transform:uppercase; color:var(--ink-faint);\n  }\n.kr-card h2.section-title{\n    font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-weight:700; font-size:21px;\n    margin:0 0 16px; text-wrap:balance;\n  }\n.kr-card p{ margin:0 0 14px; max-width:66ch; color:var(--ink); }\n.kr-card .lede{ color:var(--ink-soft); }\n.kr-card .src{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px; color:var(--ink-faint);\n  }\n.kr-card .drill{\n    background:var(--bg-raised);\n    border:1px solid var(--line-strong);\n    border-radius:4px;\n    padding:30px 26px;\n    margin-top:20px;\n    position:relative;\n  }\n.kr-card .drill::before{\n    content:\"2-MIN DRILL\";\n    position:absolute; top:-11px; left:22px; background:var(--bg);\n    padding:0 8px; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11px;\n    letter-spacing:0.12em; color:var(--accent); font-weight:600;\n  }\n.kr-card .drill p{\n    font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-size:clamp(19px,2.6vw,24px);\n    line-height:1.5; color:var(--ink); max-width:none; margin:0; text-wrap:balance;\n  }\n.kr-card .drill p strong{ color:var(--accent); font-weight:600; font-style:italic; }\n.kr-card .diagram-wrap{ overflow-x:auto; }\n.kr-card .diagram-wrap svg{ display:block; min-width:640px; width:100%; height:auto; }\n.kr-card .cap{ font-size:12.5px; color:var(--ink-faint); margin-top:10px; }\n.kr-card .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:28px; }\n@media (max-width:640px){.kr-card .grid2{ grid-template-columns:1fr; }\n}\n.kr-card .axis-title{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--ink-faint); margin-bottom:10px; }\n.kr-card .barlist{ display:flex; flex-direction:column; gap:9px; }\n.kr-card .barrow{ display:grid; grid-template-columns:96px 1fr 74px; align-items:center; gap:10px; font-size:13px; }\n.kr-card .barrow .lbl{ color:var(--ink-soft); }\n.kr-card .barrow .track{ background:var(--line); border-radius:2px; height:14px; overflow:hidden; }\n.kr-card .barrow .fill{ height:100%; background:var(--trace); border-radius:2px 0 0 2px; }\n.kr-card .barrow .fill.alt{ background:var(--accent); }\n.kr-card .barrow .val{ text-align:right; font-size:12.5px; }\n.kr-card .note{\n    margin-top:14px; padding:10px 12px; background:var(--trace-soft); border-radius:3px;\n    font-size:13px; color:var(--ink-soft); border-left:3px solid var(--trace);\n  }\n.kr-card .cust-grid{ display:grid; grid-template-columns:1.1fr 1fr; gap:28px; }\n@media (max-width:640px){.kr-card .cust-grid{ grid-template-columns:1fr; }\n}\n.kr-card ul.plain{ list-style:none; margin:0; padding:0; }\n.kr-card ul.plain li{ padding:9px 0; border-bottom:1px dashed var(--line); font-size:14px; }\n.kr-card ul.plain li:last-child{ border-bottom:none; }\n.kr-card ul.plain li b{ color:var(--ink); }\n.kr-card .comp-name{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-weight:600; font-size:13px; color:var(--ink); }\n.kr-card .kpi-box{ display:flex; gap:26px; flex-wrap:wrap; align-items:flex-end; }\n.kr-card .kpi-chart{ flex:1 1 320px; }\n.kr-card .kpi-why{ flex:1 1 260px; background:var(--bg-raised); border:1px solid var(--line-strong); border-radius:4px; padding:16px 18px; font-size:13.5px; color:var(--ink-soft); }\n.kr-card .kpi-why b{ color:var(--ink); }\n.kr-card .rpo-bars{ display:flex; align-items:flex-end; gap:18px; height:150px; padding-top:10px; }\n.kr-card .rpo-col{ flex:1; display:flex; flex-direction:column; align-items:center; gap:8px; height:100%; justify-content:flex-end; }\n.kr-card .rpo-col .b{ width:100%; max-width:52px; background:var(--trace); border-radius:3px 3px 0 0; }\n.kr-card .rpo-col .v{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:13px; font-weight:600; }\n.kr-card .rpo-col .y{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:11.5px; color:var(--ink-faint); }\n.kr-card .mgmt-card{ display:flex; gap:18px; align-items:flex-start; }\n.kr-card .mgmt-initial{\n    width:54px; height:54px; border-radius:50%; background:var(--ink); color:var(--bg);\n    display:flex; align-items:center; justify-content:center; font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif;\n    font-size:22px; flex:none;\n  }\n.kr-card .own-bar{ display:flex; height:22px; border-radius:3px; overflow:hidden; margin:14px 0 8px; border:1px solid var(--line-strong); }\n.kr-card .own-bar span{ display:block; height:100%; }\n.kr-card .own-legend{ display:flex; gap:18px; flex-wrap:wrap; font-size:12.5px; color:var(--ink-soft); }\n.kr-card .own-legend .dot{ display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:5px; }\n.kr-card .doom{\n    background:var(--risk-soft); border:1px solid var(--risk); border-radius:4px;\n    padding:20px 22px; margin-bottom:20px;\n  }\n.kr-card .doom p{ font-family: var(--font-serif), 'Noto Serif KR', 'Batang', serif; font-style:italic; font-size:16.5px; color:var(--ink); margin:0; max-width:none; }\n.kr-card .risk-list{ display:flex; flex-direction:column; gap:12px; }\n.kr-card .risk-item{ display:flex; gap:14px; }\n.kr-card .risk-item .rn{\n    font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-weight:700; color:var(--risk); flex:none; padding-top:2px;\n  }\n.kr-card .risk-item p{ margin:0; font-size:14px; }\n.kr-card .fin-grid{ display:grid; grid-template-columns:1fr 1fr; gap:22px; }\n@media (max-width:640px){.kr-card .fin-grid{ grid-template-columns:1fr; }\n}\n.kr-card .fin-card{ background:var(--bg-raised); border:1px solid var(--line-strong); border-radius:4px; padding:16px 18px 14px; }\n.kr-card .fin-card .fh{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:2px; }\n.kr-card .fin-card .ft{ font-weight:600; font-size:14px; }\n.kr-card .fin-card .fy{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:18px; font-weight:600; }\n.kr-card .fin-card .why{ font-size:12px; color:var(--ink-faint); margin-bottom:12px; }\n.kr-card .fin-bars{ display:flex; align-items:flex-end; gap:8px; height:78px; }\n.kr-card .fin-bars .col{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; gap:4px; }\n.kr-card .fin-bars .col .b{ width:100%; border-radius:2px 2px 0 0; background:var(--trace); }\n.kr-card .fin-bars .col.cur .b{ background:var(--accent); }\n.kr-card .fin-bars .col .yy{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:9.5px; color:var(--ink-faint); }\n.kr-card .fin-table{ width:100%; border-collapse:collapse; margin-top:8px; font-size:12px; }\n.kr-card .fin-table td{ padding:3px 0; text-align:right; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; color:var(--ink-soft); }\n.kr-card .fin-table td:first-child{ text-align:left; }\n.kr-card .warn{\n    margin-top:16px; padding:12px 14px; background:var(--accent-soft); border-left:3px solid var(--accent);\n    border-radius:3px; font-size:13px; color:var(--ink-soft);\n  }\n.kr-card .warn b{ color:var(--ink); }\n.kr-card .unknown-list{ display:flex; flex-direction:column; gap:10px; }\n.kr-card .unknown-list li{ list-style:none; padding-left:22px; position:relative; font-size:14px; color:var(--ink-soft); }\n.kr-card .unknown-list li::before{ content:\"?\"; position:absolute; left:0; top:-1px; color:var(--accent); font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-weight:700; }\n.kr-card footer{ padding:26px 0 10px; color:var(--ink-faint); font-size:11.5px; font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; }\n</style>\n\n<div class=\"sheet\">\n\n  <div class=\"head\">\n    <div class=\"head-left\">\n      <div class=\"tag\">Company Decoder · 기업 해독 카드</div>\n      <h2>Cadence Design Systems</h2>\n      <div class=\"sub\">NASDAQ: CDNS · 반도체 설계 소프트웨어(EDA) · CIK 0000813672</div>\n    </div>\n    <div class=\"head-right\">\n      <div class=\"price num\">$319.02</div>\n      <div>2026-08-21 종가 · 시가총액 약 $87.9B</div>\n    </div>\n  </div>\n  <span class=\"badge\">📄 10-K(FY2021~2025) · 10-Q(Q2 FY2026) · DEF 14A(2026) 기반 · 페이지 출처 명시</span>\n\n  <!-- 1. 2분 드릴 -->\n  <section>\n    <div class=\"drill\">\n      <p><strong>케이던스는</strong> 반도체 회사들이 손톱보다 작은 칩의 설계도를 그리고 실수 없이 검증하도록 도와주는 소프트웨어를 만들어서, 그 소프트웨어를 몇 년 단위 사용료로 빌려주고 돈을 버는 회사입니다.</p>\n    </div>\n  </section>\n\n  <!-- 2. 돈 버는 구조 -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">2</span><span class=\"t\">Money Flow · 돈 버는 구조</span></div>\n    <h2 class=\"section-title\">R&D에 다시 쏟아붓는 순환 구조</h2>\n    <p class=\"lede\">칩이 복잡해질수록 케이던스 도구가 더 필요해지고, 그 도구를 팔아 번 돈을 다시 R&D에 쏟아 다음 세대 칩을 감당할 도구를 만드는 순환입니다.</p>\n    <div class=\"diagram-wrap\">\n      <svg viewBox=\"0 0 820 300\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"케이던스 수익 구조 다이어그램\">\n        <defs>\n          <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 z\" fill=\"var(--ink-soft)\"></path>\n          </marker>\n        </defs>\n        <style>.kr-card .node-rect{ fill: var(--bg-raised); stroke: var(--line-strong); stroke-width:1.4; }\n.kr-card .node-title{ font-family: var(--font-sans), -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif; font-weight:600; font-size:13px; fill: var(--ink); }\n.kr-card .node-sub{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10.5px; fill: var(--ink-faint); }\n.kr-card .flow-line{ fill:none; stroke: var(--ink-soft); stroke-width:1.4; marker-end:url(#arrow); }\n.kr-card .flow-label{ font-family: var(--font-mono), ui-monospace, 'Malgun Gothic', monospace; font-size:10px; fill: var(--trace); }\n.kr-card .loop-line{ fill:none; stroke: var(--accent); stroke-width:1.4; stroke-dasharray:3 3; marker-end:url(#arrow); }\n</style>\n\n        <!-- Node: Foundry/R&D input -->\n        <rect class=\"node-rect\" x=\"20\" y=\"30\" width=\"170\" height=\"66\" rx=\"3\"></rect>\n        <text class=\"node-title\" x=\"34\" y=\"56\">파운드리 공정 데이터</text>\n        <text class=\"node-sub\" x=\"34\" y=\"74\">+ R&amp;D 1.77B (매출의 33%)</text>\n\n        <!-- Node: Cadence products -->\n        <rect class=\"node-rect\" x=\"325\" y=\"18\" width=\"180\" height=\"150\" rx=\"3\"></rect>\n        <text class=\"node-title\" x=\"339\" y=\"42\">Cadence 3대 제품군</text>\n        <text class=\"node-sub\" x=\"339\" y=\"66\">Core EDA · 70%</text>\n        <text class=\"node-sub\" x=\"339\" y=\"86\">Semiconductor IP · 14%</text>\n        <text class=\"node-sub\" x=\"339\" y=\"106\">SD&amp;A · 16%</text>\n        <text class=\"node-sub\" x=\"339\" y=\"130\" fill=\"var(--ink-soft)\">시간제 라이선스 · 로열티</text>\n        <text class=\"node-sub\" x=\"339\" y=\"148\" fill=\"var(--ink-soft)\">하드웨어 · 서비스</text>\n\n        <!-- Node: customers -->\n        <rect class=\"node-rect\" x=\"635\" y=\"30\" width=\"165\" height=\"66\" rx=\"3\"></rect>\n        <text class=\"node-title\" x=\"649\" y=\"56\">반도체·시스템 설계사</text>\n        <text class=\"node-sub\" x=\"649\" y=\"74\">엔비디아·퀄컴 등</text>\n\n        <!-- Node: revenue -->\n        <rect class=\"node-rect\" x=\"325\" y=\"222\" width=\"180\" height=\"58\" rx=\"3\"></rect>\n        <text class=\"node-title\" x=\"339\" y=\"246\">매출 $5.30B (2025)</text>\n        <text class=\"node-sub\" x=\"339\" y=\"264\">잔여계약(RPO) $7.8B</text>\n\n        <!-- flows -->\n        <path class=\"flow-line\" d=\"M190,63 L323,63\"></path>\n        <path class=\"flow-line\" d=\"M507,63 L633,63\"></path>\n        <text class=\"flow-label\" x=\"200\" y=\"55\">도구 개발</text>\n        <text class=\"flow-label\" x=\"515\" y=\"55\">라이선스 제공</text>\n\n        <path class=\"flow-line\" d=\"M717,98 C717,190 505,251 507,251\"></path>\n        <text class=\"flow-label\" x=\"600\" y=\"205\">사용료 지불</text>\n\n        <path class=\"loop-line\" d=\"M323,251 C120,251 20,180 20,98\"></path>\n        <text class=\"flow-label\" x=\"40\" y=\"180\" fill=\"var(--accent)\">재투자(R&amp;D)</text>\n      </svg>\n    </div>\n    <p class=\"cap src\">출처: 10-K FY2025, p.2(제품군 정의), p.5(RPO), p.8(경쟁), p.39(제품군 비중), p.58(R&amp;D비용), p.5(고객 집중도)</p>\n  </section>\n\n  <!-- 3. 매출 구성 두 축 -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">3</span><span class=\"t\">Revenue Mix · 매출 구성</span></div>\n    <h2 class=\"section-title\">어디서, 어느 나라에서 버는가</h2>\n    <div class=\"grid2\">\n      <div>\n        <div class=\"axis-title\">제품 카테고리별 (2025 / 2024)</div>\n        <div class=\"barlist\">\n          <div class=\"barrow\"><span class=\"lbl\">Core EDA</span><span class=\"track\"><span class=\"fill\" style=\"width:70%\"></span></span><span class=\"val num\">70% <span style=\"color:var(--ink-faint)\">(71%)</span></span></div>\n          <div class=\"barrow\"><span class=\"lbl\">Semiconductor IP</span><span class=\"track\"><span class=\"fill\" style=\"width:14%\"></span></span><span class=\"val num\">14% <span style=\"color:var(--ink-faint)\">(13%)</span></span></div>\n          <div class=\"barrow\"><span class=\"lbl\">SD&amp;A</span><span class=\"track\"><span class=\"fill\" style=\"width:16%\"></span></span><span class=\"val num\">16% <span style=\"color:var(--ink-faint)\">(16%)</span></span></div>\n        </div>\n        <p class=\"note\">Core EDA(칩 회로 설계·검증 도구)가 매출의 70%. 카테고리별 영업이익률은 <b>공시 미제공</b> — 케이던스는 단일 보고 세그먼트로 운영됩니다.</p>\n      </div>\n      <div>\n        <div class=\"axis-title\">지역별 (2025 매출 비중)</div>\n        <div class=\"barlist\">\n          <div class=\"barrow\"><span class=\"lbl\">미국</span><span class=\"track\"><span class=\"fill alt\" style=\"width:44%\"></span></span><span class=\"val num\">44%</span></div>\n          <div class=\"barrow\"><span class=\"lbl\">중국</span><span class=\"track\"><span class=\"fill alt\" style=\"width:13%\"></span></span><span class=\"val num\">13%</span></div>\n          <div class=\"barrow\"><span class=\"lbl\">아시아 기타</span><span class=\"track\"><span class=\"fill alt\" style=\"width:19%\"></span></span><span class=\"val num\">19%</span></div>\n          <div class=\"barrow\"><span class=\"lbl\">EMEA</span><span class=\"track\"><span class=\"fill alt\" style=\"width:15%\"></span></span><span class=\"val num\">15%</span></div>\n          <div class=\"barrow\"><span class=\"lbl\">일본</span><span class=\"track\"><span class=\"fill alt\" style=\"width:6%\"></span></span><span class=\"val num\">6%</span></div>\n          <div class=\"barrow\"><span class=\"lbl\">기타 아메리카</span><span class=\"track\"><span class=\"fill alt\" style=\"width:3%\"></span></span><span class=\"val num\">3%</span></div>\n        </div>\n        <p class=\"note\">해외 비중이 56%. 중국 매출(13%)은 미국 수출규제 리스크에 직접 노출되어 있습니다 (아래 ⑧ 리스크 참조).</p>\n      </div>\n    </div>\n    <p class=\"cap src\">출처: 10-K FY2025, p.39 \"Revenue by Product Category\", \"Revenue by Geography\"</p>\n  </section>\n\n  <!-- 4. 고객 & 경쟁사 -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">4</span><span class=\"t\">Customers &amp; Competition</span></div>\n    <h2 class=\"section-title\">고객과 경쟁사</h2>\n    <div class=\"cust-grid\">\n      <div>\n        <div class=\"axis-title\">고객</div>\n        <ul class=\"plain\">\n          <li>100% B2B. 반도체 설계사(팹리스)와 자동차·항공우주 등 <b>시스템 기업</b>이 고객.</li>\n          <li>2025·2024 모두 <b>단일 고객이 전체 매출의 10% 이상을 차지한 적 없음</b> — 고객 집중 리스크는 낮은 편.</li>\n          <li>계약의 상당수가 2~3년짜리 기간제 라이선스라 매출 변동성이 낮은 편.</li>\n        </ul>\n      </div>\n      <div>\n        <div class=\"axis-title\">경쟁사 (3곳)</div>\n        <ul class=\"plain\">\n          <li><span class=\"comp-name\">Synopsys</span> — EDA 업계 1위 경쟁자. 2024년 시뮬레이션 업체 Ansys까지 인수해 SD&amp;A 영역에서도 정면 충돌.</li>\n          <li><span class=\"comp-name\">Siemens EDA</span> — 옛 Mentor Graphics. 지멘스의 자금력을 등에 업은 3대 EDA 업체 중 하나.</li>\n          <li><span class=\"comp-name\">사내 설계팀 / 신흥 중국 업체</span> — 화웨이·엠피리언 등 중국 자체 EDA 업체가 수출규제 속에 빠르게 성장 중.</li>\n        </ul>\n      </div>\n    </div>\n    <p class=\"cap src\">출처: 10-K FY2025, p.5(고객 집중도), p.8 \"Competition\"</p>\n  </section>\n\n  <!-- 5. 핵심 KPI -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">5</span><span class=\"t\">Key Metric · 핵심 KPI</span></div>\n    <h2 class=\"section-title\">잔여계약금액(RPO) — 이미 확보된 미래 매출</h2>\n    <div class=\"kpi-box\">\n      <div class=\"kpi-chart\">\n        <div class=\"rpo-bars\">\n          <div class=\"rpo-col\"><div class=\"v num\">$5.8B</div><div class=\"b\" style=\"height:74%\"></div><div class=\"y\">FY2022</div></div>\n          <div class=\"rpo-col\"><div class=\"v num\">$6.0B</div><div class=\"b\" style=\"height:77%\"></div><div class=\"y\">FY2023</div></div>\n          <div class=\"rpo-col\"><div class=\"v num\">$6.8B</div><div class=\"b\" style=\"height:87%\"></div><div class=\"y\">FY2024</div></div>\n          <div class=\"rpo-col\"><div class=\"v num\">$7.8B</div><div class=\"b\" style=\"height:100%; background:var(--accent);\"></div><div class=\"y\">FY2025</div></div>\n        </div>\n      </div>\n      <div class=\"kpi-why\">\n        <b>왜 이 지표를 보는가.</b> 케이던스 매출의 대부분은 몇 년짜리 라이선스 계약에서 나옵니다. RPO는 계약은 됐지만 아직 매출로 잡히지 않은 '미래 매출 대기표'입니다. 이 숫자가 꾸준히 늘면, 다음 분기 실적이 갑자기 무너질 가능성이 낮다는 뜻입니다.\n        <br><br>\n        3년간 RPO는 +34% 늘었는데 같은 기간 매출은 +49% 늘어, 매출 대비 RPO 배수는 1.63배(2022)→1.47배(2025)로 소폭 낮아졌습니다. 여전히 두터운 계약 잔고지만 <b>속도는 매출 성장이 더 빠릅니다.</b>\n      </div>\n    </div>\n    <p class=\"cap src\">출처: 10-K FY2022~FY2025, 각 연도 p.5 \"Remaining Performance Obligations\"</p>\n  </section>\n\n  <!-- 6. 경영진 & 오너십 -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">6</span><span class=\"t\">Management</span></div>\n    <h2 class=\"section-title\">경영진 &amp; 오너십</h2>\n    <div class=\"mgmt-card\">\n      <div class=\"mgmt-initial\">AD</div>\n      <div>\n        <p style=\"margin-bottom:6px;\"><b>Anirudh Devgan (Ph.D.)</b> — 2021년부터 CEO, 2017년부터 President. 2012년 경쟁사 Magma Design Automation을 통해 케이던스 합류. <b>창업자는 아니며</b> 그 전 IBM에서 근무.</p>\n        <p style=\"margin-bottom:6px;\">이사·임원진 전체(16명) 지분율은 <b>1% 미만</b>(약 135만주). 최대주주는 The Vanguard Group(9.9%)과 BlackRock(7.9%) — 전형적인 기관투자자 중심 지배구조.</p>\n      </div>\n    </div>\n    <div class=\"own-bar\">\n      <span style=\"width:9.9%; background:var(--trace);\" title=\"Vanguard 9.9%\"></span>\n      <span style=\"width:7.9%; background:var(--accent);\" title=\"BlackRock 7.9%\"></span>\n      <span style=\"width:0.5%; background:var(--ink-soft);\" title=\"경영진·이사 <1%\"></span>\n      <span style=\"width:81.7%; background:var(--line);\"></span>\n    </div>\n    <div class=\"own-legend\">\n      <span><i class=\"dot\" style=\"background:var(--trace)\"></i>Vanguard 9.9%</span>\n      <span><i class=\"dot\" style=\"background:var(--accent)\"></i>BlackRock 7.9%</span>\n      <span><i class=\"dot\" style=\"background:var(--ink-soft)\"></i>경영진·이사 &lt;1%</span>\n      <span><i class=\"dot\" style=\"background:var(--line)\"></i>기타 유통주식</span>\n    </div>\n    <p class=\"cap src\">출처: DEF 14A(2026), p.23(CEO 약력), p.47(지분 현황표)</p>\n  </section>\n\n  <!-- 7. 주주환원 -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">7</span><span class=\"t\">Shareholder Return</span></div>\n    <h2 class=\"section-title\">주주환원 — 배당은 없고, 자사주는 꾸준히</h2>\n    <p><b>배당:</b> 배당을 한 번도 지급한 적이 없고, 당분간 지급 계획도 없습니다. (성장에 현금을 재투자하는 전략)</p>\n    <p><b>자사주 매입:</b> 최근 3년간 <span class=\"num\">$700.1M(2023) → $550.0M(2024) → $925.0M(2025)</span>를 매입, 2025년 5월 매입 한도를 $1.5B 추가 승인했습니다. 실제 발행주식수는 2024년 말 2억7,385만주 → 2025년 말 2억7,180만주로 <b>약 0.7% 순감소</b> — 임직원 보상용 신주 발행분을 상쇄하고도 실질적으로 주식수가 줄었습니다.</p>\n    <p class=\"cap src\">출처: 10-K FY2025, p.34(배당), p.35(자사주 매입한도), p.57(발행주식수), p.61(자사주 매입액)</p>\n  </section>\n\n  <!-- 8. 리스크 -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">8</span><span class=\"t\">Risk</span></div>\n    <h2 class=\"section-title\">이 회사가 망하는 시나리오</h2>\n    <div class=\"doom\">\n      <p>AI가 칩 설계 과정 자체를 통째로 대신하게 되어, 엔지니어들이 케이던스의 도구를 아예 열어볼 필요가 없어지는 순간 이 회사의 존재 이유가 사라집니다.</p>\n    </div>\n    <div class=\"risk-list\">\n      <div class=\"risk-item\"><span class=\"rn\">01</span><p><b>미·중 수출규제가 이미 현실화된 비용.</b> 2025년 케이던스는 2015~2021년 수출통제 위반 건으로 미 상무부(BIS)·법무부(DOJ)와 합의해 <b>$140.6M의 벌금을 실제로 지급</b>했습니다. 매출의 13%가 걸린 중국 사업은 앞으로도 규제 리스크에 계속 노출됩니다.</p></div>\n      <div class=\"risk-item\"><span class=\"rn\">02</span><p><b>반도체 설계 투자 사이클에 종속.</b> 고객사(반도체 회사)들이 신규 칩 설계를 줄이면 매출 인식 시점 자체가 흔들립니다. 케이던스 스스로도 \"설계 착수 감소가 매출과 수주에 부정적 영향을 줄 수 있다\"고 명시하고 있습니다.</p></div>\n      <div class=\"risk-item\"><span class=\"rn\">03</span><p><b>인수 확대와 함께 불어난 빚.</b> 총부채가 2023년 $649M → 2024년 $2,476M로 1년 만에 3.8배 늘었습니다(BETA CAE 등 인수 자금 조달). 이자비용도 2023년 $36M → 2025년 $117M로 3배 넘게 커졌습니다. 아직은 보유 현금이 부채보다 많은 순현금 상태지만, 인수 속도가 더 빨라지면 얘기가 달라질 수 있습니다.</p></div>\n    </div>\n    <p class=\"cap src\">출처: 10-K FY2025, p.58(수출규제 합의금), p.8(설계 착수 리스크), p.57·58·61(부채·이자비용)</p>\n  </section>\n\n  <!-- 9. 핵심 재무 -->\n  <section>\n    <div class=\"eyebrow\"><span class=\"n\">9</span><span class=\"t\">Financials · 5년 재무</span></div>\n    <h2 class=\"section-title\">핵심 재무 (FY2021–2025)</h2>\n    <div class=\"fin-grid\">\n\n      <div class=\"fin-card\">\n        <div class=\"fh\"><span class=\"ft\">매출 (Revenue)</span><span class=\"fy num\">$5,296.8M</span></div>\n        <div class=\"why\">사업이 커지고 있는가</div>\n        <div class=\"fin-bars\">\n          <div class=\"col\"><div class=\"b\" style=\"height:56%\"></div><div class=\"yy\">21</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:67%\"></div><div class=\"yy\">22</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:77%\"></div><div class=\"yy\">23</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:88%\"></div><div class=\"yy\">24</div></div>\n          <div class=\"col cur\"><div class=\"b\" style=\"height:100%\"></div><div class=\"yy\">25</div></div>\n        </div>\n        <table class=\"fin-table\">\n          <tr><td>YoY</td><td>—</td><td>+19.2%</td><td>+14.8%</td><td>+13.5%</td><td>+14.1%</td></tr>\n        </table>\n      </div>\n\n      <div class=\"fin-card\">\n        <div class=\"fh\"><span class=\"ft\">영업이익 (Op. Income)</span><span class=\"fy num\">$1,492.0M</span></div>\n        <div class=\"why\">본업으로 돈을 버는가 · 마진 28.2%</div>\n        <div class=\"fin-bars\">\n          <div class=\"col\"><div class=\"b\" style=\"height:52%\"></div><div class=\"yy\">21</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:72%\"></div><div class=\"yy\">22</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:84%\"></div><div class=\"yy\">23</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:91%\"></div><div class=\"yy\">24</div></div>\n          <div class=\"col cur\"><div class=\"b\" style=\"height:100%\"></div><div class=\"yy\">25</div></div>\n        </div>\n        <table class=\"fin-table\">\n          <tr><td>마진</td><td>26.1%</td><td>30.1%</td><td>30.6%</td><td>29.1%</td><td>28.2%</td></tr>\n        </table>\n      </div>\n\n      <div class=\"fin-card\">\n        <div class=\"fh\"><span class=\"ft\">잉여현금흐름 (FCF)</span><span class=\"fy num\">$1,586.9M</span></div>\n        <div class=\"why\">영업현금흐름 − 자본적지출, 진짜 남는 현금</div>\n        <div class=\"fin-bars\">\n          <div class=\"col\"><div class=\"b\" style=\"height:65%\"></div><div class=\"yy\">21</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:71%\"></div><div class=\"yy\">22</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:79%\"></div><div class=\"yy\">23</div></div>\n          <div class=\"col\"><div class=\"b\" style=\"height:70%\"></div><div class=\"yy\">24</div></div>\n          <div class=\"col cur\"><div class=\"b\" style=\"height:100%\"></div><div class=\"yy\">25</div></div>\n        </div>\n        <table class=\"fin-table\">\n          <